<div class="min-h-screen bg-gradient-to-br from-indigo-50 to-blue-50 flex items-center justify-center p-4">
  <div class="bg-white rounded-lg shadow-2xl max-w-md w-full p-8">
    
    <h1 class="text-3xl font-bold text-center mb-2 text-gray-900">
      Create Your Organization
    </h1>
    <p class="text-center text-gray-600 mb-8">
      Start your free trial today
    </p>

    <%= form_with model: @organization, url: organizations_path, local: true, class: "space-y-6", data: { turbo: false } do |f| %>

      <%= hidden_field_tag :plan, @plan %>
      <% if @organization.errors.any? %>
        <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded">
          <p class="font-semibold">
            <%= pluralize(@organization.errors.count, "error") %> prohibited this organization:
          </p>
          <ul class="mt-2 list-disc list-inside text-sm">
            <% @organization.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <!-- ORGANIZATION SECTION -->
      <div class="border-b-2 border-gray-200 pb-6">
        <h2 class="text-lg font-semibold text-gray-800 mb-4">
          Organization Details
        </h2>

        <!-- NAME -->
        <div>
          <%= f.label :name, "Organization Name", class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= f.text_field :name,
                placeholder: "e.g., Acme Corporation",
                class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
        </div>

        <!-- SUBDOMAIN -->
        <div class="mt-4">
          <%= f.label :subdomain, "Organization Subdomain", class: "block text-sm font-medium text-gray-700 mb-2" %>

          <div class="flex items-center">
            <%= f.text_field :subdomain,
                  placeholder: "my-org",
                  required: true,
                  pattern: "^[a-z0-9-]+$",
                  class: "flex-1 px-4 py-2 border border-gray-300 rounded-l-lg focus:outline-none focus:ring-2 focus:ring-indigo-500" %>

            <span class="px-4 py-2 bg-gray-100 border border-gray-300 border-l-0 rounded-r-lg text-gray-600 text-sm">
              .lvh.me:3000
            </span>
          </div>

          <p class="mt-1 text-xs text-gray-500">
            Use lowercase letters, numbers, and hyphens only.
          </p>
        </div>
      </div>

      <!-- OWNER USER SECTION -->
      <div class="pt-6">
        <h2 class="text-lg font-semibold text-gray-800 mb-4">
          Your Account (Owner)
        </h2>

        <div>
          <%= label_tag :user_email, "Email Address", class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= email_field_tag :user_email,
                params[:user_email],
                required: true,
                placeholder: "you@example.com",
                class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
        </div>

        <div class="mt-4">
          <%= label_tag :user_password, "Password", class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= password_field_tag :user_password,
                nil,
                required: true,
                placeholder: "••••••••",
                class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
        </div>

        <div class="mt-4">
          <%= label_tag :user_password_confirmation, "Confirm Password", class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= password_field_tag :user_password_confirmation,
                nil,
                required: true,
                placeholder: "••••••••",
                class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
        </div>
      </div>

      <!-- SUBMIT -->
      <div class="pt-4">
        <%= f.submit "Create Organization & Start Free Trial",
              class: "w-full bg-gradient-to-r from-indigo-600 to-blue-600 text-white font-semibold py-3 rounded-lg hover:from-indigo-700 hover:to-blue-700" %>
      </div>

      <div class="text-center text-sm">
        <span class="text-gray-600">
          Already have an account?
          <%= link_to "Sign in", new_user_session_path, class: "text-indigo-600 font-semibold" %>
        </span>
      </div>

    <% end %>
  </div>
</div>