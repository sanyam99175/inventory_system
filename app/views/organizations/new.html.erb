<div class="min-h-screen bg-[#0B0F19] flex items-center justify-center px-4 py-6">

  <div class="w-full max-w-5xl bg-[#111827] rounded-3xl shadow-2xl overflow-hidden">

    <!-- 🔥 TOP (Mobile) / LEFT (Desktop) -->
    <div class="flex flex-col md:grid md:grid-cols-2">

      <!-- BRAND PANEL -->
      <div class="flex flex-col justify-between p-6 md:p-10
                  bg-gradient-to-br from-indigo-600 to-purple-600 text-white">

        <div>
          <h2 class="text-xl md:text-2xl font-bold mb-3">Traklyn</h2>

          <h3 class="text-2xl md:text-3xl font-semibold leading-snug mb-4">
            Run your inventory<br class="hidden md:block">
            like a modern system
          </h3>

          <ul class="space-y-2 md:space-y-4 text-xs md:text-sm text-indigo-100">
            <li>✔ Real-time stock tracking</li>
            <li>✔ AI-powered insights</li>
            <li>✔ Audit logs & history</li>
            <li>✔ Smart alerts & permissions</li>
          </ul>
        </div>

        <p class="text-xs md:text-sm text-indigo-200 mt-6 md:mt-10">
          Trusted by growing businesses
        </p>
      </div>

      <!-- FORM PANEL -->
      <div class="bg-white p-6 md:p-10">

        <h1 class="text-xl md:text-2xl font-bold text-gray-900 mb-2">
          Create your workspace
        </h1>

        <% if @organization.errors.any? %>
          <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg mb-4">
            <p class="font-semibold">
              <%= pluralize(@organization.errors.count, "error") %> prevented signup:
            </p>
            <ul class="mt-2 text-sm">
              <% @organization.errors.full_messages.each do |message| %>
                <li>• <%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <%= form_with model: @organization, url: organizations_path, local: true, data: { turbo: false }, class: "space-y-4" do |f| %>

          <%= hidden_field_tag :plan, @plan %>

          <div>
            <%= f.label :name, "Organization Name", class: "text-sm font-medium text-gray-700" %>
            <%= f.text_field :name,
                  class: "mt-1 w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500" %>
          </div>

          <div>
            <%= label_tag :user_email, "Email", class: "text-sm font-medium text-gray-700" %>
            <%= email_field_tag :user_email, params[:user_email],
                  required: true,
                  class: "mt-1 w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500" %>
          </div>

          <div>
            <%= label_tag :user_password, "Password", class: "text-sm font-medium text-gray-700" %>
            <%= password_field_tag :user_password, nil,
                  required: true,
                  class: "mt-1 w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500" %>
          </div>

          <div>
            <%= label_tag :user_password_confirmation, "Confirm Password", class: "text-sm font-medium text-gray-700" %>
            <%= password_field_tag :user_password_confirmation, nil,
                  required: true,
                  class: "mt-1 w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500" %>
          </div>

          <% is_trial = (@plan == "free_trial") %>

          <div class="pt-2">
            <%= f.submit(
                  is_trial ? "Start Free Trial" : "Create Organization & Continue",
                  class: "w-full py-3 rounded-xl bg-gradient-to-r from-indigo-600 to-blue-600 text-white font-semibold"
                ) %>
          </div>

          <p class="text-xs text-gray-500 text-center">
            <% if is_trial %>
              No credit card required • 7-day free trial
            <% else %>
              You’ll set up billing after this step
            <% end %>
          </p>

          <div class="text-center text-sm">
            <span class="text-gray-600">
              Already have an account?
              <%= link_to "Sign in",
                  new_user_session_path,
                  class: "text-indigo-600 font-semibold hover:underline" %>
            </span>
          </div>

        <% end %>
      </div>

    </div>
  </div>
</div>