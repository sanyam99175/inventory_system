<% has_permission_view = current_user.has_permission?("users", "view") %>
<% has_permission_update_create = current_user.has_permission?("users", "create_update") %>
<% has_permission_change_permissions = current_user.has_permission?("users", "change_permissions") %>
<% has_permission_delete = current_user.has_permission?("users", "delete") %>
<% view_allowed_by_plan = PlanPermissions.allowed_action?(current_user.organization.plan, "users", "view") %>
<% update_create_allowed_by_plan = PlanPermissions.allowed_action?(current_user.organization.plan, "users", "create_update") %>
<% change_permissions_allowed_by_plan = PlanPermissions.allowed_action?(current_user.organization.plan, "users", "change_permissions") %>
<% delete_allowed_by_plan = PlanPermissions.allowed_action?(current_user.organization.plan, "users", "delete") %>
<% view_access = has_permission_view && view_allowed_by_plan %>
<% update_create_access = has_permission_update_create && update_create_allowed_by_plan %>
<% change_permissions_access = has_permission_change_permissions && change_permissions_allowed_by_plan %>
<% delete_access = has_permission_delete && delete_allowed_by_plan %>
<div class="max-w-6xl mx-auto p-6">

<% if view_access %>


<!-- HEADER -->
<div class="flex flex-col md:flex-row md:items-center md:justify-between mb-6 gap-4">
  <div>
    <h1 class="text-2xl font-bold text-indigo-700"><%= t('all_users') %></h1>
    <p class="text-sm text-gray-600">
      <% if params[:search].present? %>
        <%= @users.count %> <%= t('users_found') %> "<%= params[:search] %>"
      <% else %>
        <%= t('list_registered_users') %>
      <% end %>
    </p>
  </div>

  <div class="flex flex-col sm:flex-row items-start sm:items-center gap-3">

    <!-- CREATE / UPDATE -->
    <% if update_create_access %>
      <%= link_to new_staff_path,
          class: "w-full sm:w-auto rounded-lg bg-indigo-600 px-4 py-2 text-white hover:bg-indigo-700 text-center" do %>
        ➕ <%= t('add_user') %>
      <% end %>
    <% end %>

    <!-- FIXED BACK BUTTON -->
    <%= link_to dashboard_path,
        class: "w-full sm:w-auto rounded-lg border border-indigo-200 bg-white px-4 py-2 text-indigo-700 hover:bg-indigo-50 text-center" do %>
      <%= t('back') %>
    <% end %>

  </div>
</div>

<!-- SEARCH -->
<div class="bg-white p-4 rounded-lg shadow-sm border border-gray-200 mb-6">
  <%= form_with url: staffs_path, method: :get, local: true, class: "flex flex-col sm:flex-row gap-4" do %>
    <%= hidden_field_tag :locale, I18n.locale %>

    <div class="flex-1">
      <%= text_field_tag :search, params[:search],
          placeholder: t('search_users'),
          class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500" %>
    </div>

    <div class="flex gap-2 flex-col sm:flex-row">
      <%= submit_tag t('search'),
          class: "px-6 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700" %>

      <% if params[:search].present? %>
        <%= link_to t('clear'),
            staffs_path,
            class: "px-6 py-2 bg-gray-500 text-white rounded-lg hover:bg-gray-600 text-center" %>
      <% end %>
    </div>
  <% end %>
</div>

<!-- DESKTOP TABLE -->
<div class="hidden md:block overflow-hidden rounded-lg border border-gray-200 bg-white shadow-sm">
  <table class="min-w-full divide-y divide-gray-200">

    <thead class="bg-blue-50 text-blue-900">
      <tr>
        <th class="px-6 py-3 text-left text-xs uppercase text-gray-500"><%= t('name') %></th>
        <th class="px-6 py-3 text-left text-xs uppercase text-gray-500"><%= t('email') %></th>
        <th class="px-6 py-3 text-left text-xs uppercase text-gray-500"><%= t('role') %></th>
        <th class="px-6 py-3 text-left text-xs uppercase text-gray-500"><%= t('joined') %></th>
        <th class="px-6 py-3 text-left text-xs uppercase text-gray-500"><%= t('actions') %></th>
      </tr>
    </thead>

    <tbody class="divide-y divide-gray-200">
      <% if @users.present? %>

        <% @users.each do |user| %>
          <tr>

            <td class="px-6 py-4 text-sm text-gray-700">
              <%= user.name.presence || "—" %>
            </td>

            <td class="px-6 py-4 text-sm text-gray-700">
              <%= user.email %>
            </td>

            <td class="px-6 py-4 text-sm text-gray-700">
              <%= user.role.capitalize %>
            </td>

            <td class="px-6 py-4 text-sm text-gray-500">
              <%= user.created_at.strftime("%d %b %Y") %>
            </td>

            <td class="px-6 py-4 text-sm">
              <div class="flex gap-2">

                <!-- CHANGE PERMISSIONS -->
                <% if change_permissions_access %>
                  <%= link_to t('permissions'), permissions_staff_path(user),
                      class: "bg-indigo-600 text-white px-3 py-1 rounded hover:bg-indigo-700" %>
                <% end %>

                <!-- DELETE -->
                <% if delete_access && user != current_user %>
                  <%= button_to t('delete'), staff_path(user),
                      method: :delete,
                      data: { turbo_confirm: t('are_you_sure_cannot_undo') },
                      class: "bg-red-600 text-white px-3 py-1 rounded hover:bg-red-700" %>
                <% end %>

              </div>
            </td>

          </tr>
        <% end %>

      <% else %>
        <tr>
          <td colspan="5" class="px-6 py-8 text-center text-gray-500">
            <% if params[:search].present? %>
              <%= t('no_users_found_matching', search: params[:search]) %>
            <% else %>
              <%= t('no_users_found') %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>

  </table>
</div>

<!-- MOBILE CARD VIEW -->
<div class="md:hidden space-y-4">
  <% if @users.present? %>

    <% @users.each do |user| %>
      <div class="bg-white rounded-lg border border-gray-200 shadow-sm p-4 space-y-3">
        
        <!-- USER NAME AND EMAIL -->
        <div>
          <p class="text-sm text-gray-500"><%= t('name') %></p>
          <p class="text-lg font-semibold text-gray-900">
            <%= user.name.presence || "—" %>
          </p>
        </div>

        <div class="pt-2 border-t border-gray-100">
          <p class="text-sm text-gray-500"><%= t('email') %></p>
          <p class="text-sm font-medium text-gray-700 break-all">
            <%= user.email %>
          </p>
        </div>

        <!-- ROLE AND JOINED DATE -->
        <div class="grid grid-cols-2 gap-4 pt-2 border-t border-gray-100">
          <div>
            <p class="text-sm text-gray-500"><%= t('role') %></p>
            <p class="text-sm font-medium text-gray-700">
              <%= user.role.capitalize %>
            </p>
          </div>
          <div>
            <p class="text-sm text-gray-500"><%= t('joined') %></p>
            <p class="text-sm font-medium text-gray-700">
              <%= user.created_at.strftime("%d %b %Y") %>
            </p>
          </div>
        </div>

        <!-- ACTIONS -->
        <div class="pt-3 border-t border-gray-100 flex gap-2 flex-col sm:flex-row">
          <!-- CHANGE PERMISSIONS -->
          <% if change_permissions_access %>
            <%= link_to t('permissions'), permissions_staff_path(user),
                class: "flex-1 bg-indigo-600 text-white px-3 py-2 rounded hover:bg-indigo-700 text-center text-sm" %>
          <% end %>

          <!-- DELETE -->
          <% if delete_access && user != current_user %>
            <%= button_to t('delete'), staff_path(user),
                method: :delete,
                data: { turbo_confirm: t('are_you_sure_cannot_undo') },
                class: "flex-1 bg-red-600 text-white px-3 py-2 rounded hover:bg-red-700 text-center text-sm" %>
          <% end %>
        </div>

      </div>
    <% end %>

  <% else %>
    <div class="text-center py-8 text-gray-500">
      <% if params[:search].present? %>
        <%= t('no_users_found_matching', search: params[:search]) %>
      <% else %>
        <%= t('no_users_found') %>
      <% end %>
    </div>
  <% end %>
</div>


<% else %>


<!-- NO ACCESS -->
<div class="text-center text-red-600 font-medium mt-10">
  You do not have permission to view users.
</div>


<% end %>

</div>
