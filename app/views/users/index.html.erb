<div class="max-w-6xl mx-auto p-6">
  <div class="flex items-center justify-between mb-6">
    <div>
      <h1 class="text-2xl font-bold text-indigo-700">All Users</h1>
      <p class="text-sm text-gray-600">
        <% if params[:search].present? %>
          <%= @users.count %> user<%= @users.count == 1 ? '' : 's' %> found for "<%= params[:search] %>"
        <% else %>
          List of registered users in the system.
        <% end %>
      </p>
    </div>
    <div class="flex items-center gap-3">
  
    <%= link_to new_user_path,
        class: "rounded-lg bg-indigo-600 px-4 py-2 text-white hover:bg-indigo-700" do %>
        ➕ Add User
    <% end %>

    <%= link_to (current_user.owner? ? owner_dashboard_path : worker_dashboard_path),
        class: "rounded-lg border border-indigo-200 bg-white px-4 py-2 text-indigo-700 hover:bg-indigo-50" do %>
        Back to Dashboard
    <% end %>

    </div>
  </div>

  <!-- SEARCH FORM -->
  <div class="bg-white p-4 rounded-lg shadow-sm border border-gray-200 mb-6">
    <%= form_with url: users_path, method: :get, local: true, class: "flex gap-4" do %>
      <div class="flex-1">
        <%= text_field_tag :search, params[:search],
            placeholder: "Search by name or email...",
            class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
      </div>
      <div class="flex gap-2">
        <%= submit_tag "Search",
            class: "px-6 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 focus:ring-2 focus:ring-indigo-500" %>
        <% if params[:search].present? %>
          <%= link_to "Clear",
              users_path,
              class: "px-6 py-2 bg-gray-500 text-white rounded-lg hover:bg-gray-600" %>
        <% end %>
      </div>
    <% end %>
  </div>

  <div class="overflow-hidden rounded-lg border border-gray-200 bg-white shadow-sm">
    <table class="min-w-full divide-y divide-gray-200">
      <thead style="background: #eff6ff; color: #1e3a8a;">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Name</th>
          <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Email</th>
          <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Role</th>
          <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Joined</th>
          <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-200 bg-white">
        <% if @users.any? %>
          <% @users.each do |user| %>
            <tr>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-700"><%= user.name.presence || "—" %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-700"><%= user.email %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-700"><%= user.role.capitalize %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= user.created_at.strftime("%d %b %Y") %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm">
                <div class="flex gap-2">
                <%= link_to "Permissions", permissions_user_path(user),
                    class: "bg-indigo-600 text-white px-3 py-1 rounded hover:bg-indigo-700" %>
                <%= button_to "Delete", user_path(user),
                    method: :delete,
                    data: { turbo_confirm: "Are you sure? This action cannot be undone." },
                    class: "bg-red-600 text-white px-3 py-1 rounded hover:bg-red-700" %>
              </div>
              </td>
            </tr>
          <% end %>
        <% else %>
          <tr>
            <td colspan="5" class="px-6 py-8 text-center text-gray-500">
              <% if params[:search].present? %>
                No users found matching "<%= params[:search] %>"
              <% else %>
                No users found.
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
