<div class="max-w-xl mx-auto p-6">

  <h1 class="text-2xl font-bold text-indigo-700 mb-6"><%= t('add_new_user') %></h1>

  <div class="bg-white p-6 rounded-lg shadow border border-gray-200">

    <%= form_with model: @user, url: staffs_path, local: true do |f| %>

      <!-- NAME -->
      <div class="mb-4">
        <%= f.label :name, class: "block text-sm text-gray-600 mb-1" %>
        <%= f.text_field :name,
            class: "w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-indigo-500" %>
      </div>

      <!-- EMAIL -->
      <div class="mb-4">
        <%= f.label :email, class: "block text-sm text-gray-600 mb-1" %>
        <%= f.email_field :email,
            class: "w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-indigo-500" %>
      </div>

      <!-- ROLE -->
      <div class="mb-4">
        <%= f.label :role, class: "block text-sm text-gray-600 mb-1" %>
        <%= f.select :role,
            options_for_select([["Owner", "owner"], ["Worker", "worker"]]),
            {},
            class: "w-full px-4 py-2 border rounded-lg" %>
      </div>

      <!-- PASSWORD -->
      <div class="mb-4">
        <%= f.label :password, class: "block text-sm text-gray-600 mb-1" %>
        <%= f.password_field :password,
            class: "w-full px-4 py-2 border rounded-lg" %>
      </div>

      <!-- CONFIRM PASSWORD -->
      <div class="mb-6">
        <%= f.label :password_confirmation, class: "block text-sm text-gray-600 mb-1" %>
        <%= f.password_field :password_confirmation,
            class: "w-full px-4 py-2 border rounded-lg" %>
      </div>

      <!-- ACTIONS -->
      <div class="flex justify-between">
        <%= link_to t('cancel'), staffs_path,
            class: "px-4 py-2 bg-gray-500 text-white rounded-lg hover:bg-gray-600" %>

        <%= f.submit t('create_user'),
            class: "px-6 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700" %>
      </div>

    <% end %>

  </div>

</div>