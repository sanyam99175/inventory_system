<div class="bg-white rounded-3xl border border-indigo-100 shadow-sm overflow-hidden">

  <!-- HEADER -->
  <div class="px-6 py-5 border-b border-indigo-100 bg-gradient-to-r from-indigo-50 to-white flex items-center justify-between">

    <div>

      <h2 class="text-xl font-bold text-gray-900">
        Edit User
      </h2>

      <p class="text-sm text-gray-500 mt-1">
        Update user details and permissions
      </p>

    </div>

    <!-- MOBILE CLOSE -->
    <button
      type="button"
      onclick="closeMobileUserModal()"
      class="lg:hidden w-10 h-10 rounded-xl bg-white border border-gray-200 flex items-center justify-center"
    >

      <%= icon('x-mark', class: 'w-5 h-5 text-gray-500') %>

    </button>

  </div>

  <!-- FORM -->
  <div class="p-6">

    <%= form_with model: user,
        url: staff_path(user),
        method: :patch,
        local: true do |f| %>

      <div class="space-y-5">

        <!-- NAME -->
        <div>

          <%= f.label :name,
              class: "text-sm font-semibold text-gray-700 mb-2 block" %>

          <%= f.text_field :name,
              class: "
                w-full
                bg-white
                border border-indigo-100
                focus:border-indigo-400
                focus:ring-4 focus:ring-indigo-100
                rounded-2xl
                px-4 py-4
                text-base
                outline-none
                transition
              " %>

        </div>

        <!-- EMAIL -->
        <div>

          <%= f.label :email,
              class: "text-sm font-semibold text-gray-700 mb-2 block" %>

          <%= f.email_field :email,
              class: "
                w-full
                bg-white
                border border-indigo-100
                focus:border-indigo-400
                focus:ring-4 focus:ring-indigo-100
                rounded-2xl
                px-4 py-4
                text-base
                outline-none
                transition
              " %>

        </div>

        <!-- PASSWORD -->
        <div>

          <%= f.label :password,
              "New Password",
              class: "text-sm font-semibold text-gray-700 mb-2 block" %>

          <%= f.password_field :password,
              placeholder: "Leave blank to keep existing password",
              class: "
                w-full
                bg-white
                border border-indigo-100
                focus:border-indigo-400
                focus:ring-4 focus:ring-indigo-100
                rounded-2xl
                px-4 py-4
                text-base
                outline-none
                transition
              " %>

        </div>

        <!-- ROLE -->
        <div>

          <%= f.label :role,
              class: "text-sm font-semibold text-gray-700 mb-2 block" %>

          <%= f.select :role,
              User.roles.keys.map { |r| [r.titleize, r] },
              {},
              {
                class: "
                  w-full
                  bg-white
                  border border-indigo-100
                  focus:border-indigo-400
                  focus:ring-4 focus:ring-indigo-100
                  rounded-2xl
                  px-4 py-4
                  text-base
                  outline-none
                  transition
                "
              } %>

        </div>

      </div>

      <!-- ACTIONS -->
      <div class="flex items-center gap-3 mt-7">

        <button
          type="button"
          onclick="closeMobileUserModal()"
          class="
            lg:hidden
            flex-1
            bg-white
            border border-gray-200
            hover:bg-gray-50
            text-gray-700
            py-4
            rounded-2xl
            font-semibold
            transition
          "
        >
          Cancel
        </button>

        <%= f.submit "Update User",
            class: "
              flex-1
              bg-indigo-600
              hover:bg-indigo-700
              text-white
              py-4
              rounded-2xl
              font-semibold
              transition
              shadow-sm
              cursor-pointer
            " %>

      </div>

    <% end %>

  </div>

</div>