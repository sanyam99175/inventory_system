<div class="max-w-5xl mx-auto p-6">

  <!-- HEADER -->
  <div class="flex items-center justify-between mb-6">
    <div>
      <h1 class="text-2xl font-bold text-indigo-700">Manage Permissions</h1>
      <p class="text-sm text-gray-600">
        Configure access for <strong><%= @user.email %></strong>
      </p>
    </div>

    <%= link_to "Back to Users", staffs_path,
        class: "rounded-lg border border-indigo-200 bg-white px-4 py-2 text-indigo-700 hover:bg-indigo-50" %>
  </div>

  <!-- SELECT ALL -->
  <div class="mb-4 flex items-center gap-2">
    <input type="checkbox" id="select_all" class="h-4 w-4">
    <label for="select_all" class="font-medium text-gray-700">
      Select All Permissions
    </label>
  </div>

  <!-- FORM -->
  <div class="bg-white shadow rounded-lg p-6 border border-gray-200">
    <%= form_with model: @user, url: permissions_staff_path(@user), method: :patch, local: true do %>

      <div class="grid gap-6 md:grid-cols-2">

        <% @permission_modules.each do |module_key, actions| %>
          <div class="border rounded-lg p-4 permission-module">

            <!-- MODULE NAME -->
            <h3 class="font-semibold text-indigo-700 mb-3">
              <%= module_key.to_s.humanize %>
            </h3>

            <!-- ACTIONS -->
            <div class="space-y-2">
              <% actions.each do |action| %>
                <div class="flex items-center gap-2">

                  <%= check_box_tag "permissions[#{module_key}][]",
                        action,
                        @user.has_permission?(module_key, action),
                        class: "permission-checkbox h-4 w-4 text-indigo-600" %>

                  <% label_text =
                      if action == "create_update"
                        "Create / Update"
                      elsif action == "change_permissions"
                        "Change Permissions"
                      elsif action == "update" && module_key.to_s == "requests"
                        "Approve / Reject"
                      else
                        action.humanize
                      end %>

                  <label class="text-sm text-gray-700">
                    <%= label_text %>
                  </label>

                </div>
              <% end %>
            </div>

          </div>
        <% end %>

      </div>

      <!-- ACTIONS -->
      <div class="mt-6 flex justify-end gap-3">
        <%= link_to "Cancel", staffs_path,
            class: "px-4 py-2 rounded-lg border border-gray-300 bg-white text-gray-700 hover:bg-gray-50" %>

        <%= submit_tag "Save Permissions",
            class: "px-5 py-2 rounded-lg bg-indigo-600 text-white hover:bg-indigo-700" %>
      </div>

    <% end %>
  </div>

</div>

<!-- SELECT ALL SCRIPT -->
<script>
document.addEventListener("turbo:load", () => {

  const selectAll = document.getElementById("select_all");
  const allModules = document.querySelectorAll(".permission-module");

  const updateViewState = (module) => {
    const checkboxes = module.querySelectorAll(".permission-checkbox");
    const viewCheckbox = module.querySelector('input[value="view"]');

    if (!viewCheckbox) return;

    const hasHigherPermission = Array.from(checkboxes).some(cb => {
      return cb.value !== "view" && cb.checked;
    });

    if (hasHigherPermission) {
      viewCheckbox.checked = true;
      viewCheckbox.disabled = true;
    } else {
      viewCheckbox.disabled = false;
    }
  };

  // Per-module listeners
  allModules.forEach(module => {
    const checkboxes = module.querySelectorAll(".permission-checkbox");

    checkboxes.forEach(cb => {
      cb.addEventListener("change", () => updateViewState(module));
    });

    updateViewState(module);
  });

  // SELECT ALL
  if (selectAll) {
    selectAll.addEventListener("change", () => {
      const allCheckboxes = document.querySelectorAll(".permission-checkbox");

      allCheckboxes.forEach(cb => {
        cb.checked = selectAll.checked;
      });

      allModules.forEach(module => updateViewState(module));
    });
  }

});
</script>