<div class="min-h-screen bg-gradient-to-br from-indigo-50 via-white to-indigo-100">

  <div class="max-w-7xl mx-auto px-4 md:px-6 py-6">

    <!-- ================= HEADER ================= -->
    <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-5 mb-6">

      <!-- LEFT -->
      <div class="flex items-center gap-4">

        <div class="w-12 h-12 rounded-2xl bg-indigo-600 flex items-center justify-center shadow-sm shrink-0">
          <%= icon('shield-check', class: 'w-6 h-6 text-white') %>
        </div>

        <div>

          <h1 class="text-2xl md:text-3xl font-bold tracking-tight text-gray-900">
            Manage Permissions
          </h1>

          <p class="text-sm text-gray-500 mt-1">
            Configure access for
            <span class="font-semibold text-gray-700">
              <%= @user.email %>
            </span>
          </p>

        </div>

      </div>

      <!-- ACTION -->
      <div>

        <%= link_to staffs_path,
            class: "bg-white hover:bg-indigo-50 border border-indigo-100 text-indigo-700 px-5 py-3 rounded-2xl text-sm font-semibold transition flex items-center gap-2 shadow-sm" do %>

          <%= icon('arrow-left', class: 'w-4 h-4') %>

          <span>Back to Users</span>

        <% end %>

      </div>

    </div>

    <!-- ================= SELECT ALL ================= -->
    <div class="bg-white/90 backdrop-blur rounded-3xl border border-indigo-100 shadow-sm p-5 mb-6">

      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">

        <div>

          <h2 class="font-semibold text-gray-900">
            Permission Controls
          </h2>

          <p class="text-sm text-gray-500 mt-1">
            Quickly assign or remove all permissions
          </p>

        </div>

        <label class="flex items-center gap-3 cursor-pointer select-none">

          <input
            type="checkbox"
            id="select_all"
            class="h-5 w-5 rounded border-indigo-300 text-indigo-600 focus:ring-indigo-500"
          >

          <span class="font-medium text-gray-700">
            Select All Permissions
          </span>

        </label>

      </div>

    </div>

    <!-- ================= FORM ================= -->
    <div class="bg-white/90 backdrop-blur rounded-3xl border border-indigo-100 shadow-sm overflow-hidden">

      <!-- TOP -->
      <div class="px-6 py-5 border-b border-indigo-50">

        <h2 class="font-semibold text-gray-900">
          System Modules
        </h2>

        <p class="text-sm text-gray-500 mt-1">
          Manage what this user can access inside your organization
        </p>

      </div>

      <!-- FORM -->
      <div class="p-6">

        <%= form_with model: @user,
            url: permissions_staff_path(@user),
            method: :patch,
            local: true do %>

          <!-- MODULE GRID -->
          <div class="grid grid-cols-1 xl:grid-cols-2 gap-5">

            <% @permission_modules.each do |module_key, actions| %>

              <% module_icon =
                  case module_key.to_s
                  when "dashboard"
                    "chart-bar"
                  when "products"
                    "box"
                  when "requests"
                    "clipboard-list"
                  when "users"
                    "users"
                  when "history"
                    "clock"
                  when "analytics"
                    "chart-pie"
                  when "reports"
                    "document-report"
                  when "settings"
                    "cog"
                  when "alerts"
                    "bell"
                  else
                    "grid"
                  end %>

              <div class="permission-module bg-gradient-to-br from-white to-indigo-50/40 border border-indigo-100 rounded-3xl p-5 hover:shadow-md transition">

                <!-- MODULE HEADER -->
                <div class="flex items-center gap-3 mb-5">

                  <div class="w-11 h-11 rounded-2xl bg-indigo-100 flex items-center justify-center shrink-0">

                    <%= icon(module_icon, class: 'w-5 h-5 text-indigo-700') %>

                  </div>

                  <div>

                    <h3 class="font-semibold text-gray-900">
                      <%= module_key.to_s.humanize %>
                    </h3>

                    <p class="text-xs text-gray-500 mt-1">
                      Manage access permissions
                    </p>

                  </div>

                </div>

                <!-- ACTIONS -->
                <div class="space-y-3">

                  <% actions.each do |action| %>

                    <% label_text =
                        if action == "create_update"
                          "Create / Update"
                        elsif action == "change_permissions"
                          "Change Permissions"
                        elsif action == "update" && module_key.to_s == "requests"
                          "Approve / Reject"
                        else
                          action.humanize
                        end %>

                    <% action_icon =
                        case action
                        when "view"
                          "eye"
                        when "create_update"
                          "pencil-alt"
                        when "delete"
                          "trash"
                        when "change_permissions"
                          "shield-check"
                        when "update"
                          "check-circle"
                        else
                          "check"
                        end %>

                    <label class="flex items-center justify-between gap-3 p-3 rounded-2xl border border-indigo-100 bg-white hover:bg-indigo-50 transition cursor-pointer">

                      <!-- LEFT -->
                      <div class="flex items-center gap-3">

                        <div class="w-9 h-9 rounded-xl bg-indigo-50 flex items-center justify-center shrink-0">

                          <%= icon(action_icon, class: 'w-4 h-4 text-indigo-600') %>

                        </div>

                        <div>

                          <p class="text-sm font-medium text-gray-800">
                            <%= label_text %>
                          </p>

                        </div>

                      </div>

                      <!-- CHECKBOX -->
                      <%= check_box_tag "permissions[#{module_key}][]",
                            action,
                            @user.has_permission?(module_key, action),
                            class: "permission-checkbox h-5 w-5 rounded border-indigo-300 text-indigo-600 focus:ring-indigo-500 shrink-0" %>

                    </label>

                  <% end %>

                </div>

              </div>

            <% end %>

          </div>

          <!-- ACTIONS -->
          <div class="mt-8 pt-6 border-t border-indigo-100 flex flex-col-reverse sm:flex-row sm:justify-end gap-3">

            <%= link_to staffs_path,
                class: "bg-white hover:bg-gray-50 border border-gray-200 text-gray-700 px-5 py-3 rounded-2xl text-sm font-semibold transition text-center" do %>

              Cancel

            <% end %>

            <%= submit_tag "Save Permissions",
                class: "bg-indigo-600 hover:bg-indigo-700 text-white px-6 py-3 rounded-2xl text-sm font-semibold transition shadow-sm cursor-pointer" %>

          </div>

        <% end %>

      </div>

    </div>

  </div>

</div>

<!-- ================= SCRIPT ================= -->
<script>
document.addEventListener("turbo:load", () => {

  const selectAll = document.getElementById("select_all");
  const allModules = document.querySelectorAll(".permission-module");

  const updateViewState = (module) => {

    const checkboxes = module.querySelectorAll(".permission-checkbox");
    const viewCheckbox = module.querySelector('input[value="view"]');

    if (!viewCheckbox) return;

    const hasHigherPermission = Array.from(checkboxes).some(cb => {
      return cb.value !== "view" && cb.checked;
    });

    if (hasHigherPermission) {
      viewCheckbox.checked = true;
      viewCheckbox.disabled = true;
      viewCheckbox.parentElement.classList.add("opacity-70");
    } else {
      viewCheckbox.disabled = false;
      viewCheckbox.parentElement.classList.remove("opacity-70");
    }

  };

  // MODULE EVENTS
  allModules.forEach(module => {

    const checkboxes = module.querySelectorAll(".permission-checkbox");

    checkboxes.forEach(cb => {
      cb.addEventListener("change", () => updateViewState(module));
    });

    updateViewState(module);

  });

  // SELECT ALL
  if (selectAll) {

    selectAll.addEventListener("change", () => {

      const allCheckboxes = document.querySelectorAll(".permission-checkbox");

      allCheckboxes.forEach(cb => {
        cb.checked = selectAll.checked;
      });

      allModules.forEach(module => updateViewState(module));

    });

  }

});
</script>