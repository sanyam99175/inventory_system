<div class="bg-[#0B0F19] text-white min-h-screen font-sans">

  <!-- NAVBAR -->
<header class="flex items-center justify-between px-6 py-5 max-w-7xl mx-auto">

  <!-- LOGO -->
  <div class="text-xl font-bold tracking-tight">
    Traklyn
  </div>

  <!-- NAV LINKS -->
  <nav class="hidden md:flex gap-8 text-sm text-gray-300">
    <a href="#features" class="hover:text-white">Features</a>
    <a href="#pricing" class="hover:text-white">Pricing</a>
    <a href="#contact" class="hover:text-white">Contact</a>
  </nav>

  <!-- RIGHT ACTIONS -->
  <div class="flex items-center gap-3">

    <!-- SIGN IN -->
    <%= link_to "Sign in",
        new_user_session_path,
        class: "text-sm text-gray-300 hover:text-white px-3 py-2 transition" %>

    <!-- GET STARTED -->
    <%= link_to "Get Started",
        new_organization_path(plan: "free_trial"),
        class: "px-5 py-2 rounded-lg bg-white text-black font-semibold hover:opacity-90 transition" %>

  </div>

</header>

  <!-- HERO -->
  <section class="max-w-7xl mx-auto px-6 pt-20 pb-24 text-center">

    <h1 class="text-5xl md:text-6xl font-bold leading-tight">
      Track inventory.
      <br />
      <span class="text-indigo-400">Run smarter operations.</span>
    </h1>

    <p class="mt-6 text-gray-400 text-lg max-w-2xl mx-auto">
      Real-time inventory tracking, alerts, and insights for modern businesses.
    </p>

    <div class="mt-10 flex justify-center gap-4">
      <%= link_to "Create Workspace",
          new_organization_path(plan: "free_trial"),
          class: "px-6 py-3 rounded-xl bg-indigo-500 hover:bg-indigo-600 transition font-semibold" %>

      <a href="#pricing"
         class="px-6 py-3 rounded-xl border border-gray-600 hover:border-gray-400">
        View Pricing
      </a>
    </div>

      </section>

      <!-- FEATURES -->
<section id="features" class="max-w-7xl mx-auto px-6 py-24">

  <h2 class="text-3xl font-bold text-center mb-4">
    Everything you need to run inventory like a system
  </h2>

  <p class="text-gray-400 text-center mb-16 max-w-2xl mx-auto">
    From real-time tracking to intelligent insights — Traklyn is built to give you full control over your operations.
  </p>

  <div class="grid md:grid-cols-3 gap-8">

    <% features = [
      ["📦", "Real-Time Inventory", "Track stock levels instantly across all products with zero manual confusion."],
      
      ["🤖", "AI Insights", "Understand demand patterns, stock movement, and trends without doing manual analysis."],
      
      ["⚠️", "Smart Alerts", "Get notified before stock runs out or when anomalies are detected."],

      ["📜", "Audit Logs", "Track every action — who changed what and when — for full accountability."],

      ["🕓", "Request History", "Maintain complete history of stock requests and operations in one place."],

      ["🔐", "Permission Management", "Control who can view, edit, or manage inventory across your team."]
    ] %>

    <% features.each do |icon, title, desc| %>
      <div class="p-6 rounded-2xl bg-[#111827] border border-gray-800 hover:border-indigo-500 hover:shadow-xl transition duration-300">

        <div class="text-3xl mb-4"><%= icon %></div>

        <h3 class="font-semibold text-lg mb-2"><%= title %></h3>

        <p class="text-gray-400 text-sm leading-relaxed">
          <%= desc %>
        </p>

      </div>
    <% end %>

  </div>

</section>

<!-- DEMO / DASHBOARD PREVIEW -->
<section id="demo" class="max-w-7xl mx-auto px-6 py-24 text-center">

  <!-- LABEL -->
  <div class="inline-block mb-4 px-4 py-1 bg-indigo-600/20 text-indigo-400 rounded-full text-sm">
    Live Product Preview
  </div>

  <!-- HEADLINE -->
  <h2 class="text-4xl md:text-5xl font-bold mb-4">
    See your inventory
    <span class="text-indigo-400">at a glance</span>
  </h2>

  <!-- SUBTEXT -->
  <p class="text-gray-400 max-w-2xl mx-auto mb-12">
    Monitor stock levels, alerts, trends, and operations from a single powerful dashboard designed for clarity and speed.
  </p>

  <!-- DASHBOARD CONTAINER -->
  <div class="relative rounded-3xl p-[2px] bg-gradient-to-r from-indigo-500 via-purple-500 to-blue-500 shadow-2xl">

    <!-- INNER -->
    <div class="bg-[#0B0F19] rounded-3xl overflow-hidden">

      <!-- FAKE TOP BAR -->
      <div class="flex items-center gap-2 px-4 py-3 border-b border-gray-800">
        <div class="w-3 h-3 bg-red-500 rounded-full"></div>
        <div class="w-3 h-3 bg-yellow-500 rounded-full"></div>
        <div class="w-3 h-3 bg-green-500 rounded-full"></div>

        <span class="ml-4 text-xs text-gray-500">
          stockflows.in
        </span>
      </div>

      <!-- IMAGE -->
      <%= image_tag "dashboard_preview.png",
          class: "w-full opacity-95 hover:scale-[1.01] transition duration-500" %>

    </div>

    <!-- GLOW -->
    <div class="absolute -inset-10 bg-indigo-500/10 blur-3xl -z-10"></div>

  </div>

  <!-- CTA -->
  <div class="mt-10">
    <%= link_to "Try this dashboard",
        new_organization_path(plan: "free_trial"),
        class: "px-6 py-3 bg-indigo-600 hover:bg-indigo-700 rounded-xl font-semibold transition" %>
  </div>

</section>

    <!-- FREE TRIAL CTA (LIKE YOUR IMAGE) -->
  <section class="py-24 px-6 bg-[#0B0F19]">
    <div class="max-w-5xl mx-auto text-center">

      <div class="inline-block mb-4 px-4 py-1 bg-indigo-600 text-white rounded-full text-sm">
        ⏱ 7-Day Free Trial
      </div>

      <div class="bg-gradient-to-br from-gray-100 to-indigo-400 text-black p-12 rounded-3xl shadow-xl">

        <h2 class="text-4xl font-bold mb-4 text-indigo-700">
          Try Traklyn Risk-Free
        </h2>

        <p class="text-gray-700 mb-8 max-w-2xl mx-auto">
          Experience all features for 7 days. No payment required.
          See how effortless managing your inventory can be.
        </p>

        <%= link_to "Start Free Trial",
            new_organization_path(plan: "free_trial"),
            class: "px-6 py-3 bg-indigo-600 text-white rounded-xl font-semibold" %>

      </div>
    </div>
  </section>

  <!-- PRICING -->
<!-- PRICING -->
<section id="pricing" class="py-28 px-6 bg-[#0B0F19] text-white border-t border-gray-800">

  <div class="max-w-6xl mx-auto text-center">

    <h2 class="text-4xl font-bold mb-4">
      Simple, transparent pricing
    </h2>

    <p class="text-gray-400 mb-16">
      Start free. Upgrade as your business grows.
    </p>

    <!-- PLAN CARDS -->
    <div class="grid md:grid-cols-2 gap-8 mb-16">

      <!-- STARTER -->
      <div class="bg-[#111827] border border-gray-800 rounded-3xl p-8 text-left">

        <h3 class="text-xl font-semibold mb-2">Starter</h3>

        <p class="text-gray-400 mb-6">
          Perfect for small teams getting started
        </p>

        <div class="text-4xl font-bold mb-6">
          ₹99<span class="text-lg text-gray-400">/month</span>
        </div>

        <ul class="space-y-3 text-sm text-gray-300 mb-8">
          <li>✔ Up to 5 users</li>
          <li>✔ 500 products</li>
          <li>✔ Inventory tracking</li>
          <li>✔ Alerts & history</li>
        </ul>

        <%= link_to "Start Starter Plan",
            new_organization_path(plan: "basic"),
            class: "block text-center py-3 bg-white text-black rounded-xl font-semibold hover:opacity-90 transition" %>
      </div>

      <!-- GROWTH (HIGHLIGHTED) -->
      <div class="relative bg-gradient-to-br from-indigo-600 to-purple-600 rounded-3xl p-[2px]">

        <div class="bg-[#0B0F19] rounded-3xl p-8 text-left">

          <div class="absolute top-4 right-4 text-xs bg-indigo-500 px-3 py-1 rounded-full">
            Most Popular
          </div>

          <h3 class="text-xl font-semibold mb-2">Growth</h3>

          <p class="text-gray-400 mb-6">
            For growing businesses that need full control
          </p>

          <div class="text-4xl font-bold mb-6">
            ₹249<span class="text-lg text-gray-400">/month</span>
          </div>

          <ul class="space-y-3 text-sm text-gray-300 mb-8">
            <li>✔ Unlimited users</li>
            <li>✔ Unlimited products</li>
            <li>✔ Inventory tracking</li>
            <li>✔ AI insights & trends</li>
            <li>✔ Alerts & history</li>
            <li>✔ Audit logs & Recycle bin</li>
            <li>✔ Role-based permissions</li>
            <li>✔ Extended retention</li>
          </ul>

          <%= link_to "Go Growth",
              new_organization_path(plan: "premium"),
              class: "block text-center py-3 bg-indigo-600 hover:bg-indigo-700 rounded-xl font-semibold transition" %>
        </div>
      </div>

    </div>

    <!-- FEATURE COMPARISON -->
    <div class="bg-[#111827] border border-gray-800 rounded-2xl overflow-hidden">

      <table class="w-full text-sm">

        <thead class="text-gray-400 border-b border-gray-800">
          <tr>
            <th class="p-4 text-left">Features</th>
            <th class="p-4">Starter</th>
            <th class="p-4">Growth</th>
          </tr>
        </thead>

        <tbody>

          <% rows = [
            ["Products", "500", "Unlimited"],
            ["Users", "5", "Unlimited"],
            ["History", "✔", "✔"],
            ["Alerts", "✔", "✔"],
            ["AI Insights", "—", "✔"],
            ["Audit Logs", "30 days", "Unlimited"],
            ["Permissions", "—", "✔"],
            ["Recycle Bin", "15 days", "60 days"]
          ] %>

          <% rows.each do |name, basic, premium| %>
            <tr class="border-t border-gray-800 hover:bg-white/5">
              <td class="p-4 text-left text-gray-300"><%= name %></td>
              <td class="p-4 text-center text-gray-400"><%= basic %></td>
              <td class="p-4 text-center text-white font-medium"><%= premium %></td>
            </tr>
          <% end %>

        </tbody>
      </table>

    </div>

    <!-- CTA -->
    <div class="mt-10">
      <%= link_to "Start Free Trial - 7 days",
          new_organization_path(plan: "free_trial"),
          class: "px-6 py-3 bg-indigo-600 hover:bg-indigo-700 rounded-xl font-semibold transition" %>
    </div>

  </div>
</section>

  <!-- CONTACT -->
  <section id="contact" class="py-24 px-6 bg-[#0B0F19] border-t border-gray-800">

    <div class="max-w-4xl mx-auto text-center">

      <h2 class="text-3xl font-bold mb-4">
        Contact Us
      </h2>

      <p class="text-gray-400 mb-10">
        Have questions or need help? We’d love to hear from you.
      </p>

      <div class="bg-[#111827] p-8 rounded-2xl border border-gray-800">

        <p class="text-gray-300 mb-4">
          📧 Email: support@traklyn.com
        </p>

        <p class="text-gray-300">
          📍 Based in India
        </p>

      </div>

    </div>
  </section>

  <!-- FOOTER -->
  <footer class="text-center text-gray-500 py-6 text-sm">
    © <%= Time.current.year %> Traklyn
  </footer>

</div>