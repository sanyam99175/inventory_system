<div class="bg-gradient-to-br from-blue-50 via-white to-blue-100 min-h-screen">

  <!-- HERO -->
  <section class="text-center py-28 px-6 relative overflow-hidden">

    <!-- Glow background -->
    <div class="absolute inset-0 -z-10">
      <div class="absolute top-20 left-1/2 -translate-x-1/2 w-[600px] h-[600px] bg-blue-400 opacity-20 blur-3xl rounded-full animate-pulse"></div>
    </div>

    <h1 class="text-5xl md:text-6xl font-extrabold text-gray-900 mb-6 leading-tight animate-fade-up">
      Inventory, but
      <span class="bg-gradient-to-r from-blue-600 to-indigo-600 text-transparent bg-clip-text">
        beautifully simple
      </span>
    </h1>

    <p class="text-lg text-gray-600 max-w-2xl mx-auto mb-10 animate-fade-up delay-100">
      Manage stock, track usage, and control operations —
      all in one elegant dashboard.
    </p>

    <div class="flex justify-center gap-4 animate-fade-up delay-200">
      <%= link_to "Get Started",
          new_organization_path,
          class: "px-8 py-3 rounded-xl bg-blue-600 text-white font-semibold shadow-lg hover:shadow-xl hover:-translate-y-1 hover:bg-blue-700 transition duration-300" %>

      <a href="#pricing"
         class="px-8 py-3 rounded-xl border border-gray-300 hover:bg-gray-100 transition">
        View Pricing
      </a>
    </div>

  </section>

  <!-- FEATURES -->
  <section class="py-20 px-6">
    <div class="max-w-6xl mx-auto text-center">

      <h2 class="text-3xl font-bold text-gray-800 mb-14">
        Everything you need
      </h2>

      <div class="grid md:grid-cols-3 gap-8">

        <% features = [
          ["📦", "Product Tracking", "Real-time stock visibility"],
          ["📊", "Analytics", "Understand trends instantly"],
          ["🔔", "Smart Alerts", "Never run out of stock"]
        ] %>

        <% features.each_with_index do |(icon, title, desc), i| %>
          <div class="p-6 rounded-2xl bg-white/70 backdrop-blur-lg border border-gray-200 shadow-sm
                      hover:shadow-2xl hover:-translate-y-2 hover:border-blue-300
                      transition duration-300 animate-fade-up"
               style="animation-delay: <%= i * 0.15 %>s">

            <div class="text-4xl mb-4"><%= icon %></div>
            <h3 class="font-semibold text-lg mb-2"><%= title %></h3>
            <p class="text-gray-600 text-sm"><%= desc %></p>

          </div>
        <% end %>

      </div>
    </div>
  </section>

  <!-- PRODUCT PREVIEW -->
 <!-- PRODUCT PREVIEW (REAL UI BLURRED) -->
<section class="py-24 px-6 relative overflow-hidden">

  <div class="max-w-6xl mx-auto text-center">

    <h2 class="text-3xl font-bold text-gray-800 mb-6">
      See StockFlow in action
    </h2>

    <p class="text-gray-600 mb-12">
      Powerful dashboards. Clean experience. Real-time insights.
    </p>

    <div class="relative flex justify-center">

      <!-- Glow -->
      <div class="absolute w-[700px] h-[400px] bg-gradient-to-r from-blue-500 to-indigo-600 opacity-20 blur-3xl rounded-full"></div>

      <!-- Screenshot container -->
      <div class="relative rounded-2xl overflow-hidden shadow-2xl border
                  transform transition duration-700 hover:scale-105 hover:-rotate-1">

        <!-- BLURRED IMAGE -->
        <%= image_tag "dashboard_preview.png",
            class: "w-[900px] max-w-full opacity-80 blur-sm scale-105" %>

        <!-- GLASS OVERLAY -->
        <div class="absolute inset-0 bg-gradient-to-t from-white/70 via-white/30 to-transparent backdrop-blur-sm"></div>

        <!-- CENTER CTA -->
        <div class="absolute inset-0 flex items-center justify-center">
          <%= link_to "Explore Dashboard",
              new_organization_path,
              class: "px-6 py-3 bg-indigo-600 text-white font-semibold rounded-xl shadow-lg hover:scale-105 transition" %>
        </div>

      </div>

    </div>
  </div>
</section>

<!-- PRICING -->
<section id="pricing" class="py-24 px-6 bg-white/60 backdrop-blur">
  <div class="max-w-6xl mx-auto text-center">

    <h2 class="text-3xl font-bold text-gray-800 mb-4">
      Simple pricing
    </h2>
    <p class="text-gray-600 mb-14">
      Start free. Upgrade anytime.
    </p>

    <div class="grid md:grid-cols-3 gap-8">

      <% plans = [
        {
          key: "free",
          name: "Free",
          price: "₹0",
          features: ["Products", "Requests"],
          disabled: ["History", "Trends", "Alerts", "Audits", "Recycle Bin", "User Management"],
          highlight: false
        },
        {
          key: "basic",
          name: "Basic",
          price: "₹199/mo",
          features: ["Products", "Requests", "History", "Trends", "Alerts"],
          disabled: ["Audits", "Recycle Bin", "User Management"],
          highlight: false
        },
        {
          key: "premium",
          name: "Premium",
          price: "₹399/mo",
          features: ["Products", "Requests", "History", "Trends", "Alerts", "Audits", "Recycle Bin", "User Management"],
          disabled: [],
          highlight: true
        }
      ] %>

      <% plans.each_with_index do |plan, i| %>
        <div class="relative p-[1px] rounded-2xl bg-gradient-to-r from-blue-500 to-indigo-500 animate-fade-up"
             style="animation-delay: <%= i * 0.15 %>s">

          <div class="p-8 rounded-2xl bg-white h-full
                      <%= plan[:highlight] ? 'shadow-2xl scale-105' : 'hover:shadow-xl hover:-translate-y-2' %>
                      transition duration-300">

            <% if plan[:highlight] %>
              <span class="absolute top-4 right-4 text-xs bg-blue-600 text-white px-3 py-1 rounded-full">
                Most Popular
              </span>
            <% end %>

            <h3 class="text-xl font-bold mb-2"><%= plan[:name] %></h3>

            <div class="text-3xl font-extrabold mb-6">
              <%= plan[:price] %>
            </div>

            <!-- FEATURES -->
            <ul class="space-y-3 text-sm text-left mb-8">
              <% plan[:features].each do |f| %>
                <li class="flex items-center gap-2 text-gray-700">
                  <span class="text-green-500">✔</span> <%= f %>
                </li>
              <% end %>

              <% plan[:disabled].each do |f| %>
                <li class="flex items-center gap-2 text-gray-400 line-through">
                  <span>✖</span> <%= f %>
                </li>
              <% end %>
            </ul>

            <!-- ✅ FIXED CTA BUTTON -->
            <%= link_to "Get Started",
                new_organization_path(plan: plan[:key]),
                class: "block w-full py-3 rounded-xl font-semibold text-center
                        #{plan[:highlight] ? 'bg-blue-600 text-white hover:bg-blue-700' : 'bg-gray-900 text-white hover:bg-black'}
                        transition" %>

          </div>
        </div>
      <% end %>

    </div>
  </div>
</section>

  <!-- CTA -->
  <section class="py-24 px-6 text-center relative overflow-hidden">

    <div class="absolute inset-0 bg-gradient-to-r from-blue-600 to-indigo-600 opacity-95"></div>

    <div class="relative text-white">
      <h2 class="text-4xl font-bold mb-4">
        Ready to get started?
      </h2>

      <p class="mb-8 text-blue-100">
        Launch your inventory system in minutes.
      </p>
    </div>

  </section>

  <!-- FOOTER -->
  <footer class="text-center text-sm text-gray-500 py-6">
    © <%= Time.current.year %> StockFlow. All rights reserved.
  </footer>

</div>

<style>
@keyframes fadeUp {
  from {
    opacity: 0;
    transform: translateY(30px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.animate-fade-up {
  opacity: 0;
  animation: fadeUp 0.8s ease forwards;
}

.perspective {
  perspective: 1200px;
}

@keyframes float {
  0% { transform: translateY(0px); }
  50% { transform: translateY(-8px); }
  100% { transform: translateY(0px); }
}

.animate-float {
  animation: float 3s ease-in-out infinite;
}
</style>

