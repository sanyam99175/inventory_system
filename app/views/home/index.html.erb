<div class="bg-gradient-to-br from-indigo-50 via-white to-indigo-100 min-h-screen">

  <!-- HERO -->
  <section class="text-center py-28 px-6 relative overflow-hidden">

    <!-- Glow -->
    <div class="absolute inset-0 -z-10">
      <div class="absolute top-24 left-1/2 -translate-x-1/2 w-[650px] h-[650px] bg-indigo-500 opacity-20 blur-3xl rounded-full animate-pulse"></div>
    </div>

    <h1 class="text-5xl md:text-6xl font-extrabold text-gray-900 mb-6 leading-tight animate-fade-up">
      Inventory, but
      <span class="bg-gradient-to-r from-indigo-600 to-purple-600 text-transparent bg-clip-text">
        beautifully simple
      </span>
    </h1>

    <p class="text-lg text-gray-600 max-w-2xl mx-auto mb-10 animate-fade-up delay-100">
      Manage stock, track usage, and control operations —
      all in one elegant dashboard.
    </p>

    <div class="flex justify-center gap-4 animate-fade-up delay-200">

      <a href="#pricing"
         class="px-8 py-3 rounded-xl border border-indigo-300 text-indigo-700 hover:bg-indigo-50 transition">
        View Pricing
      </a>
    </div>

  </section>

  <!-- FEATURES -->
  <section class="py-20 px-6">
    <div class="max-w-6xl mx-auto text-center">

      <h2 class="text-3xl font-bold text-gray-800 mb-14">
        Everything you need
      </h2>

      <div class="grid md:grid-cols-3 gap-8">

        <% features = [
          ["📦", "Product Tracking", "Real-time stock visibility"],
          ["📊", "Analytics", "Understand trends instantly"],
          ["🔔", "Smart Alerts", "Never run out of stock"]
        ] %>

        <% features.each_with_index do |(icon, title, desc), i| %>
          <div class="p-6 rounded-2xl bg-white border border-indigo-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-2 hover:border-indigo-300
                      transition duration-300 animate-fade-up"
               style="animation-delay: <%= i * 0.1 %>s">

            <div class="text-4xl mb-4 animate-float"><%= icon %></div>
            <h3 class="font-semibold text-lg mb-2"><%= title %></h3>
            <p class="text-gray-600 text-sm"><%= desc %></p>

          </div>
        <% end %>

      </div>
    </div>
  </section>

  <!-- PRODUCT PREVIEW -->
  <section class="py-24 px-6 text-center">
    <h2 class="text-3xl font-bold text-gray-800 mb-6">
      See StockFlow in action
    </h2>

    <div class="flex justify-center">
      <div class="relative rounded-2xl overflow-hidden shadow-2xl border border-indigo-200 hover:scale-105 transition duration-500">

        <%= image_tag "dashboard_preview.png",
            class: "w-[900px] max-w-full opacity-90 blur-sm" %>

        <div class="absolute inset-0 bg-white/40 backdrop-blur-md"></div>

        <div class="absolute inset-0 flex items-center justify-center">
          <%= link_to "Explore Dashboard",
              "#pricing",
              class: "px-6 py-3 bg-indigo-600 text-white font-semibold rounded-xl shadow-lg hover:scale-105 transition" %>
        </div>

      </div>
    </div>
  </section>

  <!-- PRICING TABLE -->
<!-- PRICING TABLE -->
<section id="pricing" class="py-24 px-6 bg-white">
  <div class="max-w-6xl mx-auto text-center">

    <h2 class="text-3xl font-bold text-gray-800 mb-4">
      Compare Plans
    </h2>

    <p class="text-gray-600 mb-12">
      Choose the plan that fits your team and scale
    </p>

    <div class="overflow-x-auto rounded-2xl border border-indigo-100 shadow-lg">

      <table class="w-full text-sm">

        <!-- HEADER -->
        <thead class="bg-indigo-50 text-gray-800">
          <tr>
            <th class="p-4 text-left">Features</th>
            <th class="p-4">Basic</th>
            <th class="p-4 bg-indigo-100">
              Premium ⭐
              <div class="text-xs font-normal text-indigo-600">
                Most Popular
              </div>
            </th>
          </tr>
        </thead>

        <tbody>

          <% rows = [

            ["— CORE FEATURES —",nil, nil],

            ["Products", true, true],
            ["Requests", true, true],
            ["User Management", true, true],
            ["Manage Subscription", true, true],

            ["— ADVANCED —", nil, nil],

            ["History", true, true],
            ["Alerts", true, true],
            ["Trends", false, true],
            ["Audits", false, true],
            ["Recycle Bin", false, true],
            ["User Permissions", false, true],

            ["— LIMITS —", nil, nil],

            ["Max Users", "5", "Unlimited"],
            ["Max Products", "500", "Unlimited"],
            ["Audit Log Retention ⓘ", "30 days", "Unlimited"],
            ["Recycle Bin Retention ⓘ", "15 days", "60 days"],

          ] %>

          <% rows.each do |name, basic, premium| %>

            <% if basic.nil? && premium.nil? %>
              <!-- SECTION HEADER -->
              <tr class="bg-indigo-100 text-indigo-800 font-semibold">
                <td colspan="4" class="p-3 text-left tracking-wide">
                  <%= name %>
                </td>
              </tr>

            <% else %>
              <tr class="border-t hover:bg-indigo-50 transition">

                <!-- FEATURE NAME -->
                <td class="p-4 text-left font-medium text-gray-800">
                  <span title="<%= name.include?('ⓘ') ? 'Data auto-deletes after this duration' : '' %>">
                    <%= name %>
                  </span>
                </td>

                <!-- VALUES -->
                <% [basic, premium].each_with_index do |val, i| %>
                  <td class="p-4 text-center <%= 'bg-indigo-50 font-semibold' if i == 1 %>">

                    <% if val == true %>
                      <span class="text-green-600 font-bold">✔</span>

                    <% elsif val == false %>
                      <span class="text-gray-400">—</span>

                    <% elsif val == "Unlimited" %>
                      <span class="text-indigo-700 font-semibold">Unlimited</span>

                    <% else %>
                      <span class="text-gray-700"><%= val %></span>
                    <% end %>

                  </td>
                <% end %>

              </tr>
            <% end %>

          <% end %>

          <!-- CTA ROW -->
          <tr class="border-t bg-gray-50">

            <td></td>

            <td class="p-4">
              <%= link_to "Basic Plan",
                  new_organization_path(plan: "basic"),
                  class: "block text-center py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 transition" %>
            </td>

            <td class="p-4 bg-indigo-50">
              <%= link_to "Go Premium",
                  new_organization_path(plan: "premium"),
                  class: "block text-center py-2 bg-indigo-700 text-white rounded-lg hover:bg-indigo-800 transition" %>
            </td>

          </tr>

        </tbody>

      </table>

      <div class="p-4 bg-indigo-50">
        <%= link_to "Start Free Trial - 7 days",
            new_organization_path(plan: "free_trial"),
            class: "block text-center py-2 bg-indigo-700 text-white rounded-lg hover:bg-indigo-800 transition" %>
      </div>
    </div>

  </div>
</section>

  <!-- CTA -->
  <section class="py-24 px-6 text-center bg-gradient-to-r from-indigo-600 to-purple-600 text-white">

    <h2 class="text-4xl font-bold mb-4">
      Ready to get started?
    </h2>

    <p class="mb-8 text-indigo-100">
      Launch your inventory system in minutes.
    </p>

    <%= link_to "Create Your Workspace",
        new_organization_path,
        class: "px-8 py-3 bg-white text-indigo-700 font-semibold rounded-xl shadow-lg hover:scale-105 transition" %>

  </section>

  <!-- FOOTER -->
  <footer class="text-center text-sm text-gray-500 py-6">
    © <%= Time.current.year %> StockFlow
  </footer>

</div>

<style>
@keyframes fadeUp {
  from { opacity: 0; transform: translateY(25px); }
  to { opacity: 1; transform: translateY(0); }
}

.animate-fade-up {
  opacity: 0;
  animation: fadeUp 0.7s ease forwards;
}

@keyframes float {
  0% { transform: translateY(0px); }
  50% { transform: translateY(-6px); }
  100% { transform: translateY(0px); }
}

.animate-float {
  animation: float 3s ease-in-out infinite;
}
</style>