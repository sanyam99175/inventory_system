<div class="max-w-6xl mx-auto p-6">

  <!-- HEADER -->
  <h1 class="text-2xl font-bold text-blue-800 mb-6">📊 <%= t('trends') %></h1>

  <!-- DAILY TREND -->
  <div class="bg-white p-6 rounded-2xl shadow mb-8">
    <h2 class="text-lg font-semibold mb-4 text-blue-700"><%= t('daily_stock_movement') %></h2>
    <canvas id="dailyChart"></canvas>
  </div>

  <!-- MONTHLY TREND -->
  <div class="bg-white p-6 rounded-2xl shadow">
    <h2 class="text-lg font-semibold mb-4 text-blue-700"><%= t('monthly_stock_movement') %></h2>
    <canvas id="monthlyChart"></canvas>
  </div>

</div>

<script>
let dailyChartInstance = null;
let monthlyChartInstance = null;

document.addEventListener("turbo:load", function () {

  // ========================
  // DAILY DATA
  // ========================
  const dailyLabels = <%= raw @daily_trends.keys.map { |d|
    (d.is_a?(String) ? Date.parse(d) : d).strftime("%d %b")
  }.to_json %>;

  const dailyData = <%= raw @daily_trends.values.to_json %>;

  const dailyCanvas = document.getElementById('dailyChart');

  if (dailyCanvas) {
    if (dailyChartInstance) dailyChartInstance.destroy();

    dailyChartInstance = new Chart(dailyCanvas, {
      type: 'line',
      data: {
        labels: dailyLabels,
        datasets: [{
          label: '<%= t('items_taken_out') %>',
          data: dailyData,
          borderWidth: 2,
          tension: 0.3
        }]
      }
    });
  }

  // ========================
  // MONTHLY DATA
  // ========================
  const monthlyLabels = <%= raw @monthly_trends.keys.map { |d|
    (d.is_a?(String) ? Date.parse(d) : d).strftime("%b %Y")
  }.to_json %>;

  const monthlyData = <%= raw @monthly_trends.values.to_json %>;

  const monthlyCanvas = document.getElementById("monthlyChart");

  if (monthlyCanvas) {
    if (monthlyChartInstance) monthlyChartInstance.destroy();

    monthlyChartInstance = new Chart(monthlyCanvas, {
      type: "bar",
      data: {
        labels: monthlyLabels,
        datasets: [{
          label: '<%= t('items_taken_out') %>',
          data: monthlyData,
          backgroundColor: "rgba(59, 130, 246, 0.5)",
          borderColor: "rgba(59, 130, 246, 1)",
          borderWidth: 1
        }]
      },
      options: {
        scales: {
          y: { beginAtZero: true }
        }
      }
    });
  }

});
</script>
