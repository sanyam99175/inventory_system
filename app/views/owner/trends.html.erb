<div class="max-w-6xl mx-auto p-6">

  <!-- HEADER -->
  <h1 class="text-2xl font-bold text-blue-800 mb-6">📊 Trends</h1>

  <!-- DAILY TREND -->
  <div class="bg-white p-6 rounded-2xl shadow mb-8">
    <h2 class="text-lg font-semibold mb-4 text-blue-700">Daily Stock Movement</h2>
    <canvas id="dailyChart"></canvas>
  </div>

  <!-- MONTHLY TREND -->
  <div class="bg-white p-6 rounded-2xl shadow">
    <h2 class="text-lg font-semibold mb-4 text-blue-700">Monthly Stock Movement</h2>
    <canvas id="monthlyChart"></canvas>
  </div>

</div>

<!-- Chart.js CDN -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
  document.addEventListener("turbo:load", function () {

    const dailyLabels = <%= raw @daily_trends.keys.map { |d|
      (d.is_a?(String) ? Date.parse(d) : d).strftime("%d %b")
    }.to_json %>;

    const dailyData = <%= raw @daily_trends.values.to_json %>;

    const canvas = document.getElementById('dailyChart');
    if (!canvas) return;

    new Chart(canvas, {
      type: 'line',
      data: {
        labels: dailyLabels,
        datasets: [{
          label: 'Items Taken Out',
          data: dailyData,
          borderWidth: 2,
          tension: 0.3
        }]
      }
    });

  });
  let dailyChartInstance = null;

document.addEventListener("turbo:load", function () {

  const canvas = document.getElementById('dailyChart');
  if (!canvas) return;

  if (dailyChartInstance) {
    dailyChartInstance.destroy();
  }

  dailyChartInstance = new Chart(canvas, {
    type: 'line',
    data: {
      labels: dailyLabels,
      datasets: [{
        label: 'Items Taken Out',
        data: dailyData,
        borderWidth: 2,
        tension: 0.3
      }]
    }
  });

});
</script>