<div class="min-h-screen bg-gradient-to-br from-indigo-50 via-white to-indigo-100">

  <div class="max-w-7xl mx-auto px-4 md:px-6 py-6">

    <!-- ================= HEADER ================= -->
    <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-5 mb-6">

      <!-- LEFT -->
      <div class="flex items-start gap-4">

        <div class="w-12 h-12 rounded-2xl bg-indigo-600 flex items-center justify-center shadow-sm shrink-0">
          <%= icon('chart-line', class: 'w-6 h-6 text-white') %>
        </div>

        <div>

          <h1 class="text-2xl md:text-3xl font-bold tracking-tight text-gray-900">
            <%= t('trends') %>
          </h1>

          <p class="text-sm text-gray-500 mt-1">
            Inventory movement, alerts and operational analytics
          </p>

        </div>

      </div>

      <!-- RIGHT -->
      <div class="bg-white border border-indigo-100 rounded-2xl px-4 py-3 shadow-sm">

        <p class="text-xs text-gray-500">
          Last Updated
        </p>

        <p class="text-sm font-semibold text-indigo-700">
          <%= Time.current.strftime("%d %b %Y, %I:%M %p") %>
        </p>

      </div>

    </div>

    <!-- ================= KPI SECTION ================= -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">

      <!-- TOTAL -->
      <div class="bg-white/90 backdrop-blur rounded-3xl border border-indigo-100 shadow-sm p-5">

        <div class="flex items-center justify-between">

          <div>

            <p class="text-sm text-gray-500">
              <%= t('items_taken_out') %>
            </p>

            <h2 class="text-3xl font-bold text-gray-900 mt-2">
              <%= @total_items_out %>
            </h2>

          </div>

          <div class="w-12 h-12 rounded-2xl bg-indigo-50 border border-indigo-100 flex items-center justify-center">
            <%= icon('arrow-up', class: 'w-5 h-5 text-indigo-700') %>
          </div>

        </div>

      </div>

      <!-- AVG -->
      <div class="bg-white/90 backdrop-blur rounded-3xl border border-indigo-100 shadow-sm p-5">

        <div class="flex items-center justify-between">

          <div>

            <p class="text-sm text-gray-500">
              <%= t('average') %>
            </p>

            <h2 class="text-3xl font-bold text-gray-900 mt-2">
              <%= @daily_avg %>
            </h2>

          </div>

          <div class="w-12 h-12 rounded-2xl bg-green-50 border border-green-100 flex items-center justify-center">
            <%= icon('chart-bar', class: 'w-5 h-5 text-green-600') %>
          </div>

        </div>

      </div>

      <!-- PEAK -->
      <div class="bg-white/90 backdrop-blur rounded-3xl border border-indigo-100 shadow-sm p-5">

        <div class="flex items-center justify-between">

          <div>

            <p class="text-sm text-gray-500">
              <%= t('peak_hours') %>
            </p>

            <h2 class="text-3xl font-bold text-gray-900 mt-2">
              <%= @peak_day %>
            </h2>

          </div>

          <div class="w-12 h-12 rounded-2xl bg-amber-50 border border-amber-100 flex items-center justify-center">
            <%= icon('calendar', class: 'w-5 h-5 text-amber-600') %>
          </div>

        </div>

      </div>

    </div>

    <!-- ================= CHART GRID ================= -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-5">

      <!-- DAILY -->
      <div class="bg-white/90 backdrop-blur rounded-3xl border border-indigo-100 shadow-sm overflow-hidden">

        <div class="px-6 py-5 border-b border-indigo-50">

          <h2 class="font-semibold text-gray-900">
            <%= t('daily_stock_movement') %>
          </h2>

          <p class="text-sm text-gray-500 mt-1">
            Daily inventory activity overview
          </p>

        </div>

        <div class="p-5">
          <div class="h-72">
            <canvas id="dailyChart"></canvas>
          </div>
        </div>

      </div>

      <!-- MONTHLY -->
      <div class="bg-white/90 backdrop-blur rounded-3xl border border-indigo-100 shadow-sm overflow-hidden">

        <div class="px-6 py-5 border-b border-indigo-50">

          <h2 class="font-semibold text-gray-900">
            <%= t('monthly_stock_movement') %>
          </h2>

          <p class="text-sm text-gray-500 mt-1">
            Long term monthly movement trends
          </p>

        </div>

        <div class="p-5">
          <div class="h-72">
            <canvas id="monthlyChart"></canvas>
          </div>
        </div>

      </div>

      <!-- WEEKDAY -->
      <div class="bg-white/90 backdrop-blur rounded-3xl border border-indigo-100 shadow-sm overflow-hidden">

        <div class="px-6 py-5 border-b border-indigo-50">

          <h2 class="font-semibold text-gray-900">
            <%= t('stock_trends') %>
          </h2>

          <p class="text-sm text-gray-500 mt-1">
            Most active weekdays
          </p>

        </div>

        <div class="p-5">
          <div class="h-72">
            <canvas id="weekdayChart"></canvas>
          </div>
        </div>

      </div>

      <!-- ALERT -->
      <div class="bg-white/90 backdrop-blur rounded-3xl border border-indigo-100 shadow-sm overflow-hidden">

        <div class="px-6 py-5 border-b border-indigo-50">

          <h2 class="font-semibold text-gray-900">
            Low Stock Alerts
          </h2>

          <p class="text-sm text-gray-500 mt-1">
            Alert frequency and risk monitoring
          </p>

        </div>

        <div class="p-5">
          <div class="h-72">
            <canvas id="alertChart"></canvas>
          </div>
        </div>

      </div>

    </div>

  </div>

</div>

<!-- ================= CHART JS ================= -->
<script>

document.addEventListener("turbo:load", function () {

  function safeGetContext(id) {
    const el = document.getElementById(id);
    if (!el) return null;
    return el.getContext("2d");
  }

  if (window.dailyChartInstance) window.dailyChartInstance.destroy();
  if (window.monthlyChartInstance) window.monthlyChartInstance.destroy();
  if (window.weekdayChartInstance) window.weekdayChartInstance.destroy();
  if (window.alertChartInstance) window.alertChartInstance.destroy();

  const sharedOptions = {
    responsive: true,
    maintainAspectRatio: false,
    plugins: { legend: { display: false } },
    scales: {
      x: { grid: { display: false }, ticks: { color: "#6B7280", font: { size: 11 } } },
      y: { grid: { color: "rgba(99,102,241,0.08)" }, ticks: { color: "#6B7280", font: { size: 11 } } }
    }
  };

  const dailyCtx = safeGetContext("dailyChart");

  if (dailyCtx) {
    window.dailyChartInstance = new Chart(dailyCtx, {
      type: "line",
      data: {
        labels: <%= raw @daily_trends.keys.map { |d| d.to_date.strftime("%d %b") }.to_json %>,
        datasets: [{
          data: <%= raw @daily_trends.values.to_json %>,
          borderColor: "#4F46E5",
          backgroundColor: "rgba(79,70,229,0.08)",
          fill: true,
          tension: 0.4,
          borderWidth: 2,
          pointRadius: 3,
          pointBackgroundColor: "#4F46E5"
        }]
      },
      options: sharedOptions
    });
  }

  const monthlyCtx = safeGetContext("monthlyChart");

  if (monthlyCtx) {
    window.monthlyChartInstance = new Chart(monthlyCtx, {
      type: "bar",
      data: {
        labels: <%= raw @monthly_trends.keys.map { |d| d.to_date.strftime("%b %Y") }.to_json %>,
        datasets: [{
          data: <%= raw @monthly_trends.values.to_json %>,
          backgroundColor: "rgba(79,70,229,0.85)",
          borderRadius: 10,
          borderSkipped: false
        }]
      },
      options: sharedOptions
    });
  }

  const weekdayCtx = safeGetContext("weekdayChart");

  if (weekdayCtx) {
    window.weekdayChartInstance = new Chart(weekdayCtx, {
      type: "bar",
      data: {
        labels: ["Sun","Mon","Tue","Wed","Thu","Fri","Sat"],
        datasets: [{
          data: <%= raw @weekday_trends.to_json %>,
          backgroundColor: "rgba(99,102,241,0.75)",
          borderRadius: 10,
          borderSkipped: false
        }]
      },
      options: sharedOptions
    });
  }

  const alertCtx = safeGetContext("alertChart");

  if (alertCtx) {
    window.alertChartInstance = new Chart(alertCtx, {
      type: "line",
      data: {
        labels: <%= raw @alert_trends.keys.map { |d| d.to_date.strftime("%d %b") }.to_json %>,
        datasets: [{
          data: <%= raw @alert_trends.values.to_json %>,
          borderColor: "#EF4444",
          backgroundColor: "rgba(239,68,68,0.08)",
          fill: true,
          tension: 0.4,
          borderWidth: 2,
          pointRadius: 3,
          pointBackgroundColor: "#EF4444"
        }]
      },
      options: sharedOptions
    });
  }

});

</script>