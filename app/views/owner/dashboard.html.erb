<div class="min-h-screen bg-gradient-to-br from-indigo-50 via-white to-indigo-100 p-4 md:p-6">

  <!-- ================= HERO ================= -->
  <div class="relative overflow-hidden rounded-3xl bg-gradient-to-r from-indigo-600 via-indigo-500 to-indigo-400 border border-indigo-300 shadow-lg mb-6">

    <!-- SOFT GLOW -->
    <div class="absolute inset-0">
      <div class="absolute -top-10 -right-10 w-40 h-40 bg-white/10 rounded-full blur-3xl"></div>
      <div class="absolute bottom-0 left-0 w-32 h-32 bg-indigo-200/20 rounded-full blur-2xl"></div>
    </div>

    <div class="relative z-10 px-5 py-5 md:px-6 md:py-6">

      <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-5">

        <!-- LEFT -->
        <div class="flex items-start gap-4 min-w-0">

          <!-- ICON -->
          <div class="
            w-12 h-12
            rounded-2xl
            bg-white/15
            border border-white/15
            backdrop-blur
            flex items-center justify-center
            shrink-0
          ">
            <%= icon('chart-bar', class: 'w-6 h-6 text-white') %>
          </div>

          <!-- TEXT -->
          <div class="min-w-0">

            <div class="flex flex-wrap items-center gap-2">

              <h1 class="text-2xl md:text-3xl font-bold tracking-tight text-white">
                <%= t('dashboard_overview') %>
              </h1>

              <span class="
                inline-flex items-center gap-1.5
                bg-white/15
                border border-white/10
                text-white/90
                text-[10px]
                font-semibold
                px-2.5 py-1
                rounded-full
              ">

                <div class="w-1.5 h-1.5 rounded-full bg-emerald-300 animate-pulse"></div>

                LIVE

              </span>

            </div>

            <p class="text-indigo-50/90 mt-2 text-sm max-w-xl">
              <%= t('realtime_stock_intelligence') %>
            </p>

            <!-- MINI STATS -->
            <div class="flex flex-wrap items-center gap-2 mt-4">

              <div class="
                bg-white/10
                border border-white/10
                rounded-xl
                px-3 py-2
              ">
                <p class="text-[10px] uppercase tracking-wide text-indigo-100/80">
                  Products
                </p>

                <p class="text-sm font-bold text-white mt-0.5">
                  <%= @products.count %>
                </p>
              </div>

              <div class="
                bg-white/10
                border border-white/10
                rounded-xl
                px-3 py-2
              ">
                <p class="text-[10px] uppercase tracking-wide text-indigo-100/80">
                  Pending
                </p>

                <p class="text-sm font-bold text-white mt-0.5">
                  <%= @requests.where(status: :pending).count %>
                </p>
              </div>

            </div>

          </div>

        </div>

        <!-- ACTIONS -->
        <div class="flex flex-wrap gap-3">

          <!-- PRODUCTS -->
          <%= link_to products_path,
              class: "
                bg-white
                hover:bg-indigo-50
                text-indigo-700
                transition
                px-4 py-3
                rounded-2xl
                text-sm font-semibold
                flex items-center gap-2
                shadow-sm
              " do %>

            <%= icon('box', class: 'w-4 h-4') %>

            <span>Products</span>

          <% end %>

          <!-- REQUESTS -->
          <%= link_to pending_requests_path,
              class: "
                bg-white/10
                hover:bg-white/20
                border border-white/10
                text-white
                transition
                px-4 py-3
                rounded-2xl
                text-sm font-semibold
                flex items-center gap-2
                backdrop-blur
              " do %>

            <%= icon('file', class: 'w-4 h-4') %>

            <span>Requests</span>

          <% end %>

        </div>

      </div>

    </div>

  </div>

  <!-- ================= KPI SECTION ================= -->
  <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-5 mb-6">

    <!-- TOTAL PRODUCTS -->
    <div class="
      bg-gradient-to-br from-indigo-50 via-white to-indigo-100/60
      backdrop-blur
      rounded-3xl
      border border-indigo-100
      shadow-sm
      hover:shadow-md
      transition
      p-5
    ">

      <div class="flex items-start justify-between">

        <div>

          <p class="text-sm text-indigo-700 font-medium">
            Total Products
          </p>

          <h2 class="text-3xl font-bold text-gray-900 mt-3">
            <%= @products.count %>
          </h2>

          <p class="text-xs text-gray-500 mt-3">
            Inventory items tracked
          </p>

        </div>

        <div class="
          w-12 h-12
          rounded-2xl
          bg-indigo-100/80
          flex items-center justify-center
        ">
          <%= icon('box', class: 'w-6 h-6 text-indigo-700') %>
        </div>

      </div>

    </div>
    

    <!-- PENDING REQUESTS -->
    <div class="
      bg-gradient-to-br from-amber-50 via-white to-indigo-50
      backdrop-blur
      rounded-3xl
      border border-amber-100/60
      shadow-sm
      hover:shadow-md
      transition
      p-5
    ">

      <div class="flex items-start justify-between">

        <div>

          <p class="text-sm text-amber-700 font-medium">
            Pending Requests
          </p>

          <h2 class="text-3xl font-bold text-gray-900 mt-3">
            <%= @requests.where(status: :pending).count %>
          </h2>

          <p class="text-xs text-gray-500 mt-3">
            Awaiting approval
          </p>

        </div>

        <div class="
          w-12 h-12
          rounded-2xl
          bg-amber-100/80
          flex items-center justify-center
        ">
          <%= icon('clock', class: 'w-6 h-6 text-amber-700') %>
        </div>

      </div>

    </div>

    <!-- LOW STOCK -->
    <div class="
      bg-gradient-to-br from-red-50 via-white to-amber-50
      backdrop-blur
      rounded-3xl
      border border-red-100/60
      shadow-sm
      hover:shadow-md
      transition
      p-5
    ">

      <div class="flex items-start justify-between">

        <div>

          <p class="text-sm text-red-700 font-medium">
            Low Stock
          </p>

          <h2 class="text-3xl font-bold text-gray-900 mt-3">
            <%= @low_stock_products.count %>
          </h2>

          <div class="flex items-center gap-2 mt-3">

            <div class="w-2 h-2 rounded-full bg-red-500 animate-pulse"></div>

            <p class="text-xs text-gray-500">
              Needs attention
            </p>

          </div>

        </div>

        <div class="
          w-12 h-12
          rounded-2xl
          bg-red-100/80
          flex items-center justify-center
        ">
          <%= icon('exclamation-circle', class: 'w-6 h-6 text-red-600') %>
        </div>

      </div>

    </div>

    <!-- WEEKLY ACTIVITY -->
    <div class="
      bg-gradient-to-br from-emerald-50 via-white to-indigo-50
      backdrop-blur
      rounded-3xl
      border border-emerald-100/60
      shadow-sm
      hover:shadow-md
      transition
      p-5
    ">

      <div class="flex items-start justify-between">

        <div>

          <p class="text-sm text-emerald-700 font-medium">
            Weekly Activity
          </p>

          <h2 class="text-3xl font-bold text-gray-900 mt-3">
            <%= @weekly_requests_processed || 0 %>
          </h2>

          <p class="text-xs text-gray-500 mt-3">
            Processed this week
          </p>

        </div>

        <div class="
          w-12 h-12
          rounded-2xl
          bg-emerald-100/80
          flex items-center justify-center
        ">
          <%= icon('chart-line', class: 'w-6 h-6 text-emerald-700') %>
        </div>

      </div>

    </div>

  </div>

  <!-- ================= MAIN GRID ================= -->
  <div class="grid grid-cols-1 lg:grid-cols-2 xl:grid-cols-2 gap-6">


  <!-- ================= SIDEBAR ================= -->
  <div class="col-span-1 lg:col-span-2 xl:col-span-2 space-y-6">

  <!-- PENDING PAYMENTS CARD -->
  <div class="
    bg-gradient-to-br from-yellow-50 via-white to-orange-50
    backdrop-blur
    rounded-3xl
    border border-yellow-100
    shadow-sm
    p-6
    max-h-80
    overflow-y-auto
  ">

  <!-- HEADER -->
  <div class="flex items-center justify-between mb-5">

    <h3 class="font-semibold text-gray-900 flex items-center gap-2">

      <div class="w-8 h-8 rounded-xl bg-yellow-100 flex items-center justify-center">
        <%= icon('credit-card', class: 'w-4 h-4 text-yellow-600') %>
      </div>

      <span>Pending Payments</span>

    </h3>

    <span class="
      bg-yellow-100 border border-yellow-200
      text-yellow-700 text-xs px-3 py-1 rounded-full font-semibold
    ">
      <%= @pending_purchases.count %>
    </span>

  </div>

  <!-- TOTAL DUE -->
  <div class="mb-4">

    <p class="text-xs text-gray-500">Total Outstanding</p>

    <p class="text-2xl font-bold text-yellow-700">
      ₹<%= @total_due_amount.to_i %>
    </p>

  </div>

  <!-- LIST -->
  <% if @pending_purchases.any? %>

    <div class="space-y-3">

      <% @pending_purchases.limit(3).each do |purchase| %>

        <% due = purchase.total_amount.to_f - purchase.paid_amount.to_f %>

        <div class="
          bg-white/80
          border border-yellow-100
          rounded-2xl
          p-4
          flex items-start justify-between gap-3
        ">

          <!-- LEFT -->
          <div class="min-w-0">

            <p class="font-semibold text-gray-900 truncate">
              <%= purchase.supplier&.name || "Unknown Supplier" %>
            </p>

            <p class="text-xs text-gray-500 mt-1">
              Purchase #<%= purchase.id %> •
              <%= purchase.created_at.strftime("%d %b") %>
            </p>

            <p class="text-sm font-semibold text-red-600 mt-2">
              Due: ₹<%= due.to_i %>
            </p>

          </div>

          <!-- ACTION -->
          <div class="flex flex-col gap-2 shrink-0">

            <%= link_to purchase_path(purchase),
                class: "text-xs font-semibold text-indigo-600 hover:text-indigo-700" do %>
              View
            <% end %>

            <%= link_to mark_paid_purchase_path(purchase),
                  data: { confirm: "Are you sure you want to mark this purchase as paid?" },
                class: "bg-green-600 hover:bg-green-700 text-white text-xs font-semibold px-3 py-1.5 rounded-xl" do %>
              Mark Paid
            <% end %>

          </div>

        </div>

      <% end %>

    </div>

    <!-- VIEW MORE -->
    <% if @pending_purchases.count > 3 %>
      <div class="mt-4 text-center">
        <%= link_to purchases_path(status: "pending"),
            class: "text-sm font-semibold text-indigo-600 hover:text-indigo-700" do %>
          View All Pending →
        <% end %>
      </div>
    <% end %>

  <% else %>

    <div class="text-center py-6">

      <div class="w-14 h-14 rounded-full bg-green-50 border border-green-100 flex items-center justify-center mx-auto mb-3">
        <%= icon('check', class: 'w-6 h-6 text-green-600') %>
      </div>

      <p class="text-sm text-gray-500">
        No pending supplier payments
      </p>

    </div>

  <% end %>

  </div>

      <!-- ================= LOW STOCK ================= -->
<div class="
  bg-gradient-to-br from-red-50 via-white to-amber-50
  backdrop-blur
  rounded-3xl
  border border-red-100
  shadow-sm
  p-6
  max-h-80
  overflow-y-auto
">

  <div class="flex items-center justify-between mb-5">

    <h3 class="font-semibold text-gray-900 flex items-center gap-2">

      <div class="w-8 h-8 rounded-xl bg-red-100/80 flex items-center justify-center">
        <%= icon('exclamation-circle', class: 'w-4 h-4 text-red-600') %>
      </div>

      <span>Low Stock</span>
    </h3>

    <span class="
      bg-red-100/80 border border-red-200 text-red-700
      text-xs px-3 py-1 rounded-full font-semibold
    ">
      <%= @low_stock_products.count %>
    </span>

  </div>

  <% if @low_stock_products.any? %>

    <% total_low_stock = @low_stock_products.count %>

    <div class="space-y-4">

      <% @low_stock_products.limit(1).each do |product| %>

        <% last_purchase_item =
            PurchaseItem
              .joins(:purchase)
              .includes(purchase: :supplier)
              .where(product_id: product.id)
              .order("purchases.purchase_date DESC")
              .first
        %>

        <% supplier = last_purchase_item&.purchase&.supplier %>

        <div class="
          bg-white/80 border border-red-100
          rounded-2xl p-4 hover:bg-white transition
        ">

          <!-- TOP -->
          <div class="flex items-start justify-between gap-3">

            <div class="min-w-0">

              <p class="font-semibold text-gray-900 truncate">
                <%= product.name %>
              </p>

              <div class="flex items-center gap-2 mt-1">

                <span class="px-2 py-1 rounded-lg bg-red-50 text-red-700 text-xs font-semibold">
                  Stock: <%= product.stock_count %>
                </span>

                <span class="px-2 py-1 rounded-lg bg-amber-50 text-amber-700 text-xs font-semibold">
                  Alert: <%= product.alert_limit %>
                </span>

              </div>

            </div>

            <div class="w-10 h-10 rounded-2xl bg-red-100 flex items-center justify-center shrink-0">
              <%= icon('box', class: 'w-5 h-5 text-red-600') %>
            </div>

          </div>

          <!-- SUPPLIER -->
          <% if supplier.present? %>

            <div class="mt-4 rounded-2xl border border-indigo-100 bg-gradient-to-r from-indigo-50 to-white p-3">

              <div class="flex items-start justify-between gap-3">

                <div>

                  <p class="text-[11px] uppercase tracking-wide text-indigo-500 font-bold">
                    Suggested Supplier
                  </p>

                  <p class="text-sm font-semibold text-gray-900 mt-1">
                    <%= supplier.name %>
                  </p>

                  <div class="flex flex-wrap gap-3 mt-2 text-xs text-gray-500">

                    <span>
                      Last Price:
                      <span class="font-semibold text-gray-800">
                        ₹<%= last_purchase_item&.unit_price.to_i %>
                      </span>
                    </span>

                    <span>
                      Last Bought:
                      <span class="font-semibold text-gray-800">
                        <%= last_purchase_item&.purchase&.purchase_date&.strftime("%d %b") || "N/A" %>
                      </span>
                    </span>

                  </div>

                </div>

                <%= link_to new_purchase_path(supplier_id: supplier.id, product_id: product.id),
                    class: "bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-semibold px-3 py-2 rounded-xl transition shrink-0" do %>
                  Reorder
                <% end %>

              </div>

            </div>

          <% else %>

            <div class="mt-4 rounded-2xl bg-gray-50 border border-gray-100 px-4 py-3">
              <p class="text-xs text-gray-500">
                No supplier purchase history found.
              </p>
            </div>

          <% end %>

        </div>

      <% end %>

    </div>

    <!-- VIEW MORE -->
    <% if total_low_stock > 1 %>
      <div class="mt-4 text-center">
        <%= link_to alerts_path,
            class: "inline-block text-sm font-semibold text-indigo-600 hover:text-indigo-700" do %>
          View More →
        <% end %>
      </div>
    <% end %>

  <% else %>

    <div class="text-center py-6">

      <div class="w-14 h-14 rounded-full bg-emerald-50 border border-emerald-100 flex items-center justify-center mx-auto mb-3">
        <%= icon('check', class: 'w-6 h-6 text-emerald-600') %>
      </div>

      <p class="text-sm text-gray-500">
        All stock levels are healthy.
      </p>

    </div>

  <% end %>

</div>

  <!-- ================= REQUESTS ================= -->
  <div class="
    col-span-1 lg:col-span-2
    rounded-3xl
    overflow-hidden
    shadow-sm
    border border-indigo-100/70
    bg-gradient-to-br from-indigo-50/70 via-white to-indigo-100/40
    backdrop-blur
    max-h-96
    overflow-y-auto
  ">

  <!-- HEADER -->
  <div class="flex items-center justify-between p-6 border-b border-indigo-100/60">

    <div>

      <h2 class="text-lg font-semibold text-gray-900">
        Pending Requests
      </h2>

      <p class="text-sm text-indigo-500 mt-1">
        Requests waiting for approval
      </p>

      </div>

      <% if @pending_requests_count > 3 %>

        <%= link_to pending_requests_path,
            class: "
              text-indigo-600 hover:text-indigo-800
              text-sm font-medium transition
            " do %>

          View All →

        <% end %>

      <% end %>

    </div>

    <!-- REQUEST LIST -->
    <div class="p-4">

      <% pending = @requests.where(status: :pending).limit(3) %>

      <% if pending.any? %>

        <div class="space-y-4">

          <% pending.each do |req| %>

            <div class="
              rounded-2xl
              border border-indigo-100/70
              bg-white/70
              backdrop-blur-sm
              p-3
              hover:bg-white/90
              hover:shadow-sm
              transition
            ">

              <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">

                <!-- LEFT -->
                <div class="flex items-start gap-4">

                  <div class="
                    w-11 h-11
                    rounded-2xl
                    bg-indigo-50/80
                    border border-indigo-100
                    flex items-center justify-center
                    shadow-sm shrink-0
                  ">
                    <%= icon('box', class: 'w-5 h-5 text-indigo-600') %>
                  </div>

                  <div>

                    <h3 class="font-semibold text-gray-900">
                      <%= req.product.name %>
                    </h3>

                    <div class="flex flex-wrap gap-4 mt-2 text-sm text-gray-500">

                      <div class="flex items-center gap-1">
                        <%= icon('user', class: 'w-4 h-4 text-indigo-400') %>

                        <span>
                          <%= req.user_name || req.user&.email || t('unknown_user_dashboard') %>
                        </span>
                      </div>

                      <div class="flex items-center gap-1">
                        <%= icon('plus', class: 'w-4 h-4 text-indigo-400') %>

                        <span>
                          Qty: <%= req.quantity_change %>
                        </span>
                      </div>

                    </div>

                  </div>

                </div>

                <!-- ACTIONS -->
                <% if current_user.has_permission?("requests", "update") %>

                  <div class="flex items-center gap-2">

                    <%= button_to approve_request_path(req),
                        method: :patch,
                        class: "
                          bg-indigo-600 hover:bg-indigo-700
                          text-white
                          px-4 py-2
                          rounded-xl
                          text-sm font-medium
                          flex items-center gap-2
                          transition
                          shadow-sm
                        " do %>

                      <%= icon('check', class: 'w-4 h-4') %>
                      <span>Approve</span>

                    <% end %>

                    <%= button_to reject_request_path(req),
                        method: :patch,
                        class: "
                          bg-white/80 hover:bg-white
                          border border-indigo-100
                          text-gray-700
                          px-4 py-2
                          rounded-xl
                          text-sm font-medium
                          flex items-center gap-2
                          transition
                        " do %>

                      <%= icon('remove', class: 'w-4 h-4 text-indigo-400') %>
                      <span>Reject</span>

                    <% end %>

                  </div>

                <% end %>

              </div>

            </div>

          <% end %>

        </div>

      <% else %>

        <!-- EMPTY -->
        <div class="py-20 text-center">

          <div class="
            w-20 h-20
            rounded-full
            bg-indigo-50/80
            border border-indigo-100
            flex items-center justify-center
            mx-auto mb-5
          ">
            <%= icon('check', class: 'w-8 h-8 text-indigo-600') %>
          </div>

          <h3 class="text-lg font-semibold text-gray-900">
            No Pending Requests
          </h3>

          <p class="text-sm text-indigo-500 mt-2">
            Everything looks good right now.
          </p>

        </div>

      <% end %>

    </div>

</div>


    <!-- ================= WEEKLY SUMMARY ================= -->
  <div class="
    col-span-1 lg:col-span-2 xl:col-span-4
    bg-white/90 backdrop-blur rounded-3xl border border-indigo-100 shadow-sm p-6
  ">

    <!-- HEADER -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-6">

      <div>

        <h2 class="text-lg font-semibold text-gray-900 flex items-center gap-2">

          <%= icon('calendar', class: 'w-5 h-5 text-indigo-700') %>

          Weekly Summary

        </h2>

        <p class="text-sm text-gray-500 mt-1">
          Last 7 days operational overview
        </p>

      </div>

      <span class="bg-indigo-50 border border-indigo-100 text-indigo-700 px-3 py-2 rounded-xl text-xs font-medium">
        Auto Generated
      </span>

    </div>

    <!-- GRID -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">

      <div class="bg-indigo-50/70 border border-indigo-100 rounded-2xl p-5">

        <p class="text-xs text-gray-500">
          Stock Added
        </p>

        <h3 class="text-2xl font-bold text-indigo-700 mt-2">
          <%= @weekly_stock_added || 0 %>
        </h3>

      </div>

      <div class="bg-indigo-50/70 border border-indigo-100 rounded-2xl p-5">

        <p class="text-xs text-gray-500">
          Stock Removed
        </p>

        <h3 class="text-2xl font-bold text-indigo-700 mt-2">
          <%= @weekly_stock_removed || 0 %>
        </h3>

      </div>

      <div class="bg-indigo-50/70 border border-indigo-100 rounded-2xl p-5">

        <p class="text-xs text-gray-500">
          Requests Processed
        </p>

        <h3 class="text-2xl font-bold text-indigo-700 mt-2">
          <%= @weekly_requests_processed || 0 %>
        </h3>

      </div>

      <div class="bg-indigo-50/70 border border-indigo-100 rounded-2xl p-5">

        <p class="text-xs text-gray-500">
          Low Stock Alerts
        </p>

        <h3 class="text-2xl font-bold text-indigo-700 mt-2">
          <%= @weekly_low_stock || 0 %>
        </h3>

      </div>

    </div>

    <!-- FOOTER -->
    <div class="mt-6 p-4 rounded-2xl bg-indigo-50/50 border border-indigo-100">

      <div class="flex items-center gap-2 text-sm text-gray-700">

        <%= icon('chart-line', class: 'w-5 h-5 text-indigo-700') %>

        <% if @weekly_stock_added.to_i > @weekly_stock_removed.to_i %>

          <span>
            Stock levels improved this week.
          </span>

        <% else %>

          <span>
            Stock consumption is currently higher than additions.
          </span>

        <% end %>

      </div>

    </div>

  </div>

</div>