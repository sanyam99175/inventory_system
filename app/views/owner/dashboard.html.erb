<div class="min-h-screen bg-indigo-50 p-6">

  <!-- ================= HEADER ================= -->
  <div class="bg-indigo-700 text-white p-6 rounded-2xl shadow-md mb-6 flex items-center justify-between">

    <!-- LEFT -->
    <div class="flex items-center gap-4">

      <div class="w-12 h-12 rounded-xl bg-white/20 flex items-center justify-center text-lg font-bold">
        📊
      </div>

      <div>
        <h1 class="text-2xl font-bold">
          Dashboard Overview
        </h1>
        <p class="text-indigo-100 text-sm">
          Real-time stock & request intelligence
        </p>
      </div>

    </div>

    <!-- RIGHT -->
    <div class="hidden md:flex gap-2">

      <span class="text-xs bg-white/20 px-3 py-1 rounded-full">
        Live Data
      </span>

      <span class="text-xs bg-white/20 px-3 py-1 rounded-full">
        AI Ready
      </span>

    </div>

  </div>

  <!-- ================= KPI SECTION ================= -->
  <div class="grid md:grid-cols-3 gap-6 mb-6">

    <div class="bg-white p-5 rounded-2xl shadow border border-indigo-100 hover:shadow-md transition">
      <p class="text-gray-500 text-sm">📦 Total Products</p>
      <h2 class="text-3xl font-bold text-indigo-700 mt-2">
        <%= @products.count %>
      </h2>
    </div>

    <div class="bg-white p-5 rounded-2xl shadow border border-indigo-100 hover:shadow-md transition">
      <p class="text-gray-500 text-sm">📝 Pending Requests</p>
      <h2 class="text-3xl font-bold text-indigo-700 mt-2">
        <%= @requests.where(status: :pending).count %>
      </h2>
    </div>

    <div class="bg-white p-5 rounded-2xl shadow border border-indigo-100 hover:shadow-md transition">
      <p class="text-gray-500 text-sm">⚠ Low Stock Items</p>
      <h2 class="text-3xl font-bold text-red-600 mt-2">
        <%= @low_stock_products.count %>
      </h2>
    </div>

  </div>

  <!-- ================= MAIN GRID ================= -->
  <div class="grid md:grid-cols-3 gap-6">

    <!-- ================= PENDING REQUESTS ================= -->
    <div class="md:col-span-2 bg-white rounded-2xl shadow border border-indigo-100 p-6">

      <div class="flex justify-between items-center mb-4">
        <h2 class="text-lg font-bold text-indigo-800">
          Pending Requests
        </h2>

        <% if @pending_requests_count > 3 %>
          <%= link_to "View All →", pending_requests_path,
              class: "text-sm text-indigo-600 hover:underline" %>
        <% end %>
      </div>

      <% pending = @requests.where(status: :pending).limit(5) %>

      <% if pending.any? %>

        <div class="space-y-3">

          <% pending.each do |req| %>

            <div class="flex items-center justify-between p-3 rounded-xl bg-indigo-50 hover:bg-indigo-100 transition">

              <!-- LEFT -->
              <div>
                <p class="font-semibold text-gray-800">
                  <%= req.product.name %>
                </p>

                <p class="text-xs text-gray-500">
                  👷 <%= req.user_name || req.user&.email || "Unknown" %>
                </p>
              </div>

              <!-- CENTER -->
              <div class="text-indigo-700 font-bold">
                <%= req.quantity_change %>
              </div>

              <!-- ACTIONS -->
              <div class="flex gap-2">

                <% if current_user.has_permission?("requests", "update") %>

                  <%= button_to approve_request_path(req),
                      method: :patch,
                      class: "bg-indigo-600 text-white px-3 py-1 rounded-lg text-xs hover:bg-indigo-700" do %>
                    ✔
                  <% end %>

                  <%= button_to reject_request_path(req),
                      method: :patch,
                      class: "bg-gray-200 text-gray-700 px-3 py-1 rounded-lg text-xs hover:bg-gray-300" do %>
                    ✖
                  <% end %>

                <% end %>

              </div>

            </div>

          <% end %>

        </div>

      <% else %>

        <div class="text-center py-10 text-gray-500">
          No pending requests
        </div>

      <% end %>

    </div>

    <!-- ================= RIGHT SIDEBAR ================= -->
    <div class="space-y-6">

      <!-- LOW STOCK -->
      <div class="bg-white p-5 rounded-2xl shadow border border-indigo-100">

        <h3 class="font-bold text-indigo-800 mb-3">
          ⚠ Low Stock Alerts
        </h3>

        <% if @low_stock_products.any? %>

          <div class="space-y-2">

            <% @low_stock_products.limit(5).each do |p| %>

              <div class="flex justify-between text-sm">

                <span class="text-gray-700">
                  <%= p.name %>
                </span>

                <span class="text-red-600 font-semibold">
                  <%= p.stock_count %>
                </span>

              </div>

            <% end %>

          </div>

        <% else %>

          <p class="text-sm text-gray-500">
            All stocks are healthy
          </p>

        <% end %>

      </div>

      <!-- QUICK INSIGHT PLACEHOLDER -->
      <div class="bg-white p-5 rounded-2xl shadow border border-indigo-100">

        <h3 class="font-bold text-indigo-800 mb-2">
          🧠 AI Insight (Coming Soon)
        </h3>

        <p class="text-sm text-gray-500">
          Smart insights like demand prediction, reorder suggestions & anomalies will appear here.
        </p>

      </div>

    </div>

  </div>

</div>