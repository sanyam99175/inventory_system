<div class="min-h-screen bg-indigo-50 p-6">

  <!-- HEADER -->
  <div class="bg-indigo-700 text-white p-6 rounded-2xl shadow-md mb-6">
    <h1 class="text-2xl font-bold"><%= t('dashboard') %></h1>
    <p class="text-indigo-100"><%= t('manage_stock_approvals') %></p>
  </div>

  <!-- STATS -->
  <div class="grid md:grid-cols-3 gap-6 mb-6">

    <div class="bg-white p-5 rounded-2xl shadow border-t-4 border-indigo-600">
      <p class="text-gray-500 text-sm">📦 <%= t('products') %></p>
      <h2 class="text-2xl font-bold text-indigo-800 mt-1">
        <%= @products.count %>
      </h2>
    </div>

    <div class="bg-white p-5 rounded-2xl shadow border-t-4 border-indigo-500">
      <p class="text-gray-500 text-sm">📝 <%= t('requests') %></p>
      <h2 class="text-2xl font-bold text-indigo-700 mt-1">
        <%= @requests.count %>
      </h2>
    </div>

    <div class="bg-white p-5 rounded-2xl shadow border-t-4 border-indigo-800">
      <p class="text-gray-500 text-sm">⚠ <%= t('low_stock') %></p>
      <h2 class="text-2xl font-bold text-indigo-800 mt-1">
        <%= @low_stock_products.count %>
      </h2>
    </div>

  </div>

  <!-- PENDING REQUESTS -->
  <div class="bg-white rounded-2xl shadow-md p-6 border border-indigo-100">

    <h2 class="text-xl font-bold text-indigo-800 mb-4 border-b pb-2">
      <%= t('pending_requests') %>
    </h2>

    <% if @requests.where(status: :pending).any? %>

      <table class="w-full text-sm">

        <thead class="bg-indigo-100 text-indigo-800">
          <tr>
            <th class="p-3 text-left">📦 <%= t('product') %></th>
            <th class="p-3 text-left">🔢 <%= t('qty') %></th>
            <th class="p-3 text-left">👷 <%= t('worker') %></th>
            <th class="p-3 text-left">⚙ <%= t('actions') %></th>
          </tr>
        </thead>

        <tbody>
          <% @requests.where(status: :pending).limit(3).each do |req| %>
            <tr class="border-b last:border-none hover:bg-indigo-50 transition">

              <td class="p-3 font-medium text-gray-800">
                <%= req.product.name %>
              </td>

              <td class="p-3 font-semibold text-indigo-700">
                <%= req.quantity_change %>
              </td>

              <td class="p-3 text-gray-600">
                <%= req.user_name || req.user&.email || t('unknown_user') %>
              </td>

              <td class="p-3 flex gap-2">

                <% if current_user.has_permission?("requests", "update") %>
                  <%= button_to approve_request_path(req),
                      method: :patch,
                      class: "bg-indigo-600 text-white px-3 py-1 rounded-lg text-sm hover:bg-indigo-700" do %>
                    ✔ <%= t('approve') %>
                  <% end %>

                  <%= button_to reject_request_path(req),
                      method: :patch,
                      class: "bg-indigo-200 text-indigo-800 px-3 py-1 rounded-lg text-sm hover:bg-indigo-300" do %>
                    ✖ <%= t('reject') %>
                  <% end %>
                <% else %>
                  <span class="text-gray-500 text-sm"><%= t('no_action_permissions') %></span>
                <% end %>

              </td>

            </tr>
          <% end %>
        </tbody>

      </table>

    <% else %>

      <p class="text-gray-500 text-center py-6">
        ✅ <%= t('no_pending_requests') %>
      </p>

    <% end %>

    <% if @pending_requests_count > 3 %>
      <%= link_to "View More →", pending_requests_path,
        class: "text-sm text-indigo-600 hover:underline" %>
    <% end %>

  </div>

</div>