<div class="min-h-screen bg-gradient-to-br from-indigo-50 via-white to-indigo-100 p-4 md:p-6">

  <!-- ================= HERO ================= -->
  <div class="relative overflow-hidden rounded-3xl bg-gradient-to-r from-indigo-700 to-indigo-800 border border-indigo-600 shadow-xl mb-6">

    <!-- Soft Glow -->
    <div class="absolute inset-0">
      <div class="absolute -top-16 -right-10 w-64 h-64 bg-white/5 rounded-full blur-3xl"></div>
      <div class="absolute bottom-0 left-0 w-40 h-40 bg-indigo-400/10 rounded-full blur-2xl"></div>
    </div>

    <div class="relative z-10 p-6 md:p-8">

      <div class="flex flex-col xl:flex-row xl:items-center xl:justify-between gap-6">

        <!-- LEFT -->
        <div class="flex items-start gap-4">

          <div class="w-14 h-14 rounded-2xl bg-white/10 border border-white/10 backdrop-blur flex items-center justify-center shadow-lg shrink-0">
            <%= icon('chart-bar', class: 'w-7 h-7 text-white') %>
          </div>

          <div>

            <div class="flex flex-wrap items-center gap-3">

              <h1 class="text-2xl md:text-3xl font-bold tracking-tight text-white">
                <%= t('dashboard_overview') %>
              </h1>

              <span class="bg-white/10 border border-white/10 text-indigo-100 text-xs px-3 py-1 rounded-full backdrop-blur">
                LIVE
              </span>

            </div>

            <p class="text-indigo-100/90 mt-3 text-sm md:text-base max-w-2xl leading-relaxed">
              <%= t('realtime_stock_intelligence') %>
            </p>

          </div>

        </div>

        <!-- ACTIONS -->
        <div class="flex flex-wrap gap-3">

          <%= link_to products_path,
              class: "bg-white text-indigo-700 hover:bg-indigo-50 transition px-5 py-3 rounded-2xl text-sm font-semibold flex items-center gap-2 shadow-lg" do %>

            <%= icon('box', class: 'w-5 h-5') %>
            <span>Products</span>

          <% end %>

          <%= link_to pending_requests_path,
              class: "bg-indigo-600/40 hover:bg-indigo-600/60 border border-white/10 transition text-white px-5 py-3 rounded-2xl text-sm font-semibold flex items-center gap-2 backdrop-blur" do %>

            <%= icon('file', class: 'w-5 h-5') %>
            <span>Requests</span>

          <% end %>

        </div>

      </div>

    </div>

  </div>

  <!-- ================= KPI SECTION ================= -->
  <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-5 mb-6">

    <!-- CARD -->
    <div class="bg-white/90 backdrop-blur rounded-3xl border border-indigo-100 shadow-sm hover:shadow-md transition p-5">

      <div class="flex items-start justify-between">

        <div>

          <p class="text-sm text-gray-500">
            Total Products
          </p>

          <h2 class="text-3xl font-bold text-gray-900 mt-3">
            <%= @products.count %>
          </h2>

        </div>

        <div class="w-12 h-12 rounded-2xl bg-indigo-50 flex items-center justify-center border border-indigo-100">
          <%= icon('box', class: 'w-6 h-6 text-indigo-700') %>
        </div>

      </div>

    </div>

    <!-- CARD -->
    <div class="bg-white/90 backdrop-blur rounded-3xl border border-indigo-100 shadow-sm hover:shadow-md transition p-5">

      <div class="flex items-start justify-between">

        <div>

          <p class="text-sm text-gray-500">
            Pending Requests
          </p>

          <h2 class="text-3xl font-bold text-gray-900 mt-3">
            <%= @requests.where(status: :pending).count %>
          </h2>

        </div>

        <div class="w-12 h-12 rounded-2xl bg-indigo-50 flex items-center justify-center border border-indigo-100">
          <%= icon('clock', class: 'w-6 h-6 text-indigo-700') %>
        </div>

      </div>

    </div>

    <!-- CARD -->
    <div class="bg-white/90 backdrop-blur rounded-3xl border border-indigo-100 shadow-sm hover:shadow-md transition p-5">

      <div class="flex items-start justify-between">

        <div>

          <p class="text-sm text-gray-500">
            Low Stock
          </p>

          <h2 class="text-3xl font-bold text-gray-900 mt-3">
            <%= @low_stock_products.count %>
          </h2>

        </div>

        <div class="w-12 h-12 rounded-2xl bg-indigo-50 flex items-center justify-center border border-indigo-100">
          <%= icon('exclamation-circle', class: 'w-6 h-6 text-indigo-700') %>
        </div>

      </div>

    </div>

    <!-- CARD -->
    <div class="bg-white/90 backdrop-blur rounded-3xl border border-indigo-100 shadow-sm hover:shadow-md transition p-5">

      <div class="flex items-start justify-between">

        <div>

          <p class="text-sm text-gray-500">
            Weekly Activity
          </p>

          <h2 class="text-3xl font-bold text-gray-900 mt-3">
            <%= @weekly_requests_processed || 0 %>
          </h2>

        </div>

        <div class="w-12 h-12 rounded-2xl bg-indigo-50 flex items-center justify-center border border-indigo-100">
          <%= icon('chart-line', class: 'w-6 h-6 text-indigo-700') %>
        </div>

      </div>

    </div>

  </div>

  <!-- ================= MAIN GRID ================= -->
  <div class="grid grid-cols-1 xl:grid-cols-3 gap-6">

    <!-- ================= REQUESTS ================= -->
    <div class="xl:col-span-2 bg-white/90 backdrop-blur rounded-3xl border border-indigo-100 shadow-sm overflow-hidden">

      <!-- HEADER -->
      <div class="flex items-center justify-between p-6 border-b border-indigo-50">

        <div>

          <h2 class="text-lg font-semibold text-gray-900">
            Pending Requests
          </h2>

          <p class="text-sm text-gray-500 mt-1">
            Requests waiting for approval
          </p>

        </div>

        <% if @pending_requests_count > 3 %>

          <%= link_to pending_requests_path,
              class: "text-indigo-600 hover:text-indigo-800 text-sm font-medium transition" do %>

            View All →

          <% end %>

        <% end %>

      </div>

      <!-- REQUEST LIST -->
      <div class="p-6">

        <% pending = @requests.where(status: :pending).limit(5) %>

        <% if pending.any? %>

          <div class="space-y-4">

            <% pending.each do |req| %>

              <div class="bg-indigo-50/50 border border-indigo-100 rounded-2xl p-4 hover:bg-indigo-50 transition">

                <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">

                  <!-- LEFT -->
                  <div class="flex items-start gap-4">

                    <div class="w-11 h-11 rounded-2xl bg-white border border-indigo-100 flex items-center justify-center shadow-sm shrink-0">
                      <%= icon('box', class: 'w-5 h-5 text-indigo-700') %>
                    </div>

                    <div>

                      <h3 class="font-semibold text-gray-900">
                        <%= req.product.name %>
                      </h3>

                      <div class="flex flex-wrap gap-4 mt-2 text-sm text-gray-500">

                        <div class="flex items-center gap-1">
                          <%= icon('user', class: 'w-4 h-4') %>

                          <span>
                            <%= req.user_name || req.user&.email || t('unknown_user_dashboard') %>
                          </span>
                        </div>

                        <div class="flex items-center gap-1">
                          <%= icon('plus', class: 'w-4 h-4') %>

                          <span>
                            Qty: <%= req.quantity_change %>
                          </span>
                        </div>

                      </div>

                    </div>

                  </div>

                  <!-- ACTIONS -->
                  <% if current_user.has_permission?("requests", "update") %>

                    <div class="flex items-center gap-2">

                      <%= button_to approve_request_path(req),
                          method: :patch,
                          class: "bg-indigo-700 hover:bg-indigo-800 text-white px-4 py-2 rounded-xl text-sm font-medium flex items-center gap-2 transition shadow-sm" do %>

                        <%= icon('check', class: 'w-4 h-4') %>
                        <span>Approve</span>

                      <% end %>

                      <%= button_to reject_request_path(req),
                          method: :patch,
                          class: "bg-white hover:bg-indigo-50 border border-indigo-100 text-gray-700 px-4 py-2 rounded-xl text-sm font-medium flex items-center gap-2 transition" do %>

                        <%= icon('remove', class: 'w-4 h-4') %>
                        <span>Reject</span>

                      <% end %>

                    </div>

                  <% end %>

                </div>

              </div>

            <% end %>

          </div>

        <% else %>

          <!-- EMPTY -->
          <div class="py-20 text-center">

            <div class="w-20 h-20 rounded-full bg-indigo-50 border border-indigo-100 flex items-center justify-center mx-auto mb-5">
              <%= icon('check', class: 'w-8 h-8 text-indigo-700') %>
            </div>

            <h3 class="text-lg font-semibold text-gray-900">
              No Pending Requests
            </h3>

            <p class="text-sm text-gray-500 mt-2">
              Everything looks good right now.
            </p>

          </div>

        <% end %>

      </div>

    </div>

    <!-- ================= SIDEBAR ================= -->
    <div class="space-y-6">

      <!-- LOW STOCK -->
      <div class="bg-white/90 backdrop-blur rounded-3xl border border-indigo-100 shadow-sm p-6">

        <div class="flex items-center justify-between mb-5">

          <h3 class="font-semibold text-gray-900 flex items-center gap-2">

            <%= icon('exclamation-circle', class: 'w-5 h-5 text-indigo-700') %>

            Low Stock

          </h3>

          <span class="bg-indigo-50 border border-indigo-100 text-indigo-700 text-xs px-3 py-1 rounded-full">
            <%= @low_stock_products.count %>
          </span>

        </div>

        <% if @low_stock_products.any? %>

          <div class="space-y-4">

            <% @low_stock_products.limit(5).each do |p| %>

              <div class="flex items-center justify-between">

                <div>

                  <p class="text-sm font-medium text-gray-900">
                    <%= p.name %>
                  </p>

                  <p class="text-xs text-gray-500 mt-1">
                    Reorder recommended
                  </p>

                </div>

                <div class="bg-indigo-50 border border-indigo-100 text-indigo-700 px-3 py-1 rounded-xl text-sm font-semibold">
                  <%= p.stock_count %>
                </div>

              </div>

            <% end %>

          </div>

        <% else %>

          <div class="text-center py-6">

            <div class="w-14 h-14 rounded-full bg-indigo-50 border border-indigo-100 flex items-center justify-center mx-auto mb-3">
              <%= icon('check', class: 'w-6 h-6 text-indigo-700') %>
            </div>

            <p class="text-sm text-gray-500">
              All stock levels are healthy.
            </p>

          </div>

        <% end %>

      </div>

      <!-- AI CARD -->
      <div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-indigo-700 to-indigo-800 border border-indigo-600 shadow-xl p-6">

        <div class="absolute top-0 right-0 w-32 h-32 bg-white/5 rounded-full blur-3xl"></div>

        <div class="relative z-10">

          <div class="w-12 h-12 rounded-2xl bg-white/10 border border-white/10 flex items-center justify-center mb-4 backdrop-blur">
            <%= icon('microchip', class: 'w-6 h-6 text-white') %>
          </div>

          <h3 class="text-lg font-semibold text-white">
            AI Insights
          </h3>

          <p class="text-indigo-100/90 text-sm leading-relaxed mt-2">
            Smart inventory insights, stock forecasting and supplier analytics coming soon.
          </p>

          <div class="mt-5">

            <span class="inline-flex items-center gap-2 bg-white/10 border border-white/10 text-white text-xs px-3 py-2 rounded-xl backdrop-blur">

              <div class="w-2 h-2 rounded-full bg-white"></div>

              AI Ready

            </span>

          </div>

        </div>

      </div>

    </div>

  </div>

  <!-- ================= WEEKLY SUMMARY ================= -->
  <div class="bg-white/90 backdrop-blur rounded-3xl border border-indigo-100 shadow-sm p-6 mt-6">

    <!-- HEADER -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-6">

      <div>

        <h2 class="text-lg font-semibold text-gray-900 flex items-center gap-2">

          <%= icon('calendar', class: 'w-5 h-5 text-indigo-700') %>

          Weekly Summary

        </h2>

        <p class="text-sm text-gray-500 mt-1">
          Last 7 days operational overview
        </p>

      </div>

      <span class="bg-indigo-50 border border-indigo-100 text-indigo-700 px-3 py-2 rounded-xl text-xs font-medium">
        Auto Generated
      </span>

    </div>

    <!-- GRID -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">

      <div class="bg-indigo-50/70 border border-indigo-100 rounded-2xl p-5">

        <p class="text-xs text-gray-500">
          Stock Added
        </p>

        <h3 class="text-2xl font-bold text-indigo-700 mt-2">
          <%= @weekly_stock_added || 0 %>
        </h3>

      </div>

      <div class="bg-indigo-50/70 border border-indigo-100 rounded-2xl p-5">

        <p class="text-xs text-gray-500">
          Stock Removed
        </p>

        <h3 class="text-2xl font-bold text-indigo-700 mt-2">
          <%= @weekly_stock_removed || 0 %>
        </h3>

      </div>

      <div class="bg-indigo-50/70 border border-indigo-100 rounded-2xl p-5">

        <p class="text-xs text-gray-500">
          Requests Processed
        </p>

        <h3 class="text-2xl font-bold text-indigo-700 mt-2">
          <%= @weekly_requests_processed || 0 %>
        </h3>

      </div>

      <div class="bg-indigo-50/70 border border-indigo-100 rounded-2xl p-5">

        <p class="text-xs text-gray-500">
          Low Stock Alerts
        </p>

        <h3 class="text-2xl font-bold text-indigo-700 mt-2">
          <%= @weekly_low_stock || 0 %>
        </h3>

      </div>

    </div>

    <!-- FOOTER -->
    <div class="mt-6 p-4 rounded-2xl bg-indigo-50/50 border border-indigo-100">

      <div class="flex items-center gap-2 text-sm text-gray-700">

        <%= icon('chart-line', class: 'w-5 h-5 text-indigo-700') %>

        <% if @weekly_stock_added.to_i > @weekly_stock_removed.to_i %>

          <span>
            Stock levels improved this week.
          </span>

        <% else %>

          <span>
            Stock consumption is currently higher than additions.
          </span>

        <% end %>

      </div>

    </div>

  </div>

</div>