<div class="min-h-screen bg-indigo-50 p-6">

  <!-- ================= HEADER ================= -->
  <div class="bg-indigo-700 text-white p-6 rounded-2xl shadow-md mb-6 flex items-center justify-between">

    <!-- LEFT -->
    <div class="flex items-center gap-4">

      <div class="w-12 h-12 rounded-xl bg-white/20 flex items-center justify-center text-lg font-bold">
        📊
      </div>

      <div>
        <h1 class="text-2xl font-bold">
          <%= t('dashboard_overview') %>
        </h1>
        <p class="text-indigo-100 text-sm">
          <%= t('realtime_stock_intelligence') %>
        </p>
      </div>

    </div>

    <!-- RIGHT -->
    <div class="hidden md:flex gap-2">

      <span class="text-xs bg-white/20 px-3 py-1 rounded-full">
        <%= t('live_data') %>
      </span>

      <span class="text-xs bg-white/20 px-3 py-1 rounded-full">
        <%= t('ai_ready') %>
      </span>

    </div>

  </div>

  <!-- ================= KPI SECTION ================= -->
  <div class="grid md:grid-cols-3 gap-6 mb-6">

    <div class="bg-white p-5 rounded-2xl shadow border border-indigo-100 hover:shadow-md transition">
      <p class="text-gray-500 text-sm">📦 <%= t('total_products_label') %></p>
      <h2 class="text-3xl font-bold text-indigo-700 mt-2">
        <%= @products.count %>
      </h2>
    </div>

    <div class="bg-white p-5 rounded-2xl shadow border border-indigo-100 hover:shadow-md transition">
      <p class="text-gray-500 text-sm">📝 <%= t('pending_requests_label') %></p>
      <h2 class="text-3xl font-bold text-indigo-700 mt-2">
        <%= @requests.where(status: :pending).count %>
      </h2>
    </div>

    <div class="bg-white p-5 rounded-2xl shadow border border-indigo-100 hover:shadow-md transition">
      <p class="text-gray-500 text-sm">⚠ <%= t('low_stock_items_label') %></p>
      <h2 class="text-3xl font-bold text-red-600 mt-2">
        <%= @low_stock_products.count %>
      </h2>
    </div>

  </div>

  <!-- ================= MAIN GRID ================= -->
  <div class="grid md:grid-cols-3 gap-6">

    <!-- ================= PENDING REQUESTS ================= -->
    <div class="md:col-span-2 bg-white rounded-2xl shadow border border-indigo-100 p-6">

      <div class="flex justify-between items-center mb-4">
        <h2 class="text-lg font-bold text-indigo-800">
          <%= t('pending_requests_label') %>
        </h2>

        <% if @pending_requests_count > 3 %>
          <%= link_to t('view_all_link'), pending_requests_path,
              class: "text-sm text-indigo-600 hover:underline" %>
        <% end %>
      </div>

      <% pending = @requests.where(status: :pending).limit(5) %>

      <% if pending.any? %>

        <div class="space-y-3">

          <% pending.each do |req| %>

            <div class="flex items-center justify-between p-3 rounded-xl bg-indigo-50 hover:bg-indigo-100 transition">

              <!-- LEFT -->
              <div>
                <p class="font-semibold text-gray-800">
                  <%= req.product.name %>
                </p>

                <p class="text-xs text-gray-500">
                  👷 <%= req.user_name || req.user&.email || t('unknown_user_dashboard') %>
                </p>
              </div>

              <!-- CENTER -->
              <div class="text-indigo-700 font-bold">
                <%= req.quantity_change %>
              </div>

              <!-- ACTIONS -->
              <div class="flex gap-2">

                <% if current_user.has_permission?("requests", "update") %>

                  <%= button_to approve_request_path(req),
                      method: :patch,
                      class: "bg-indigo-600 text-white px-3 py-1 rounded-lg text-xs hover:bg-indigo-700" do %>
                    ✔
                  <% end %>

                  <%= button_to reject_request_path(req),
                      method: :patch,
                      class: "bg-gray-200 text-gray-700 px-3 py-1 rounded-lg text-xs hover:bg-gray-300" do %>
                    ✖
                  <% end %>

                <% end %>

              </div>

            </div>

          <% end %>

        </div>

      <% else %>

        <div class="text-center py-10 text-gray-500">
          <%= t('no_pending_requests_dashboard') %>
        </div>

      <% end %>

    </div>

    <!-- ================= RIGHT SIDEBAR ================= -->
    <div class="space-y-6">

      <!-- LOW STOCK -->
      <div class="bg-white p-5 rounded-2xl shadow border border-indigo-100">

        <h3 class="font-bold text-indigo-800 mb-3">
          ⚠ <%= t('low_stock_alerts') %>
        </h3>

        <% if @low_stock_products.any? %>

          <div class="space-y-2">

            <% @low_stock_products.limit(5).each do |p| %>

              <div class="flex justify-between text-sm">

                <span class="text-gray-700">
                  <%= p.name %>
                </span>

                <span class="text-red-600 font-semibold">
                  <%= p.stock_count %>
                </span>

              </div>

            <% end %>

          </div>

        <% else %>

          <p class="text-sm text-gray-500">
            <%= t('all_stocks_healthy') %>
          </p>

        <% end %>

      </div>

      <!-- QUICK INSIGHT PLACEHOLDER -->
      <div class="bg-white p-5 rounded-2xl shadow border border-indigo-100">

        <h3 class="font-bold text-indigo-800 mb-2">
          🧠 <%= t('ai_insight_coming_soon') %>
        </h3>

        <p class="text-sm text-gray-500">
          <%= t('ai_insight_description') %>
        </p>

      </div>

    </div>

  </div>

                  <!-- ================= WEEKLY SUMMARY ================= -->
      <div class="bg-white rounded-2xl shadow border border-indigo-100 p-6 mb-6 mt-6">

        <!-- HEADER -->
        <div class="flex items-center justify-between mb-6">

          <div>
            <h2 class="text-lg font-bold text-indigo-800">
              📅 Weekly Summary
            </h2>
            <p class="text-sm text-gray-500">
              Last 7 days activity
            </p>
          </div>

          <span class="text-xs bg-indigo-100 text-indigo-700 px-3 py-1 rounded-full">
            Auto-generated
          </span>

        </div>

        <!-- STATS GRID -->
        <div class="grid md:grid-cols-4 gap-4">

          <!-- STOCK ADDED -->
          <div class="bg-indigo-50 rounded-xl p-4">
            <p class="text-xs text-gray-500">Stock Added</p>
            <h3 class="text-xl font-bold text-indigo-700 mt-1">
              <%= @weekly_stock_added || 0 %>
            </h3>
          </div>

          <!-- STOCK REMOVED -->
          <div class="bg-red-50 rounded-xl p-4">
            <p class="text-xs text-gray-500">Stock Removed</p>
            <h3 class="text-xl font-bold text-red-600 mt-1">
              <%= @weekly_stock_removed || 0 %>
            </h3>
          </div>

          <!-- REQUESTS PROCESSED -->
          <div class="bg-green-50 rounded-xl p-4">
            <p class="text-xs text-gray-500">Requests Processed</p>
            <h3 class="text-xl font-bold text-green-600 mt-1">
              <%= @weekly_requests_processed || 0 %>
            </h3>
          </div>

          <!-- LOW STOCK EVENTS -->
          <div class="bg-yellow-50 rounded-xl p-4">
            <p class="text-xs text-gray-500">Low Stock Alerts</p>
            <h3 class="text-xl font-bold text-yellow-600 mt-1">
              <%= @weekly_low_stock || 0 %>
            </h3>
          </div>

        </div>

        <!-- OPTIONAL TREND TEXT -->
        <div class="mt-6 text-sm text-gray-600">
          <% if @weekly_stock_added.to_i > @weekly_stock_removed.to_i %>
            📈 Stock levels improved this week.
          <% else %>
            📉 Stock consumption is higher than additions.
          <% end %>
        </div>

      </div>

</div>