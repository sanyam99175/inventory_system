<div style="max-width: 1100px; margin: auto;">

  <!-- HEADER -->
  <div style="margin-bottom: 20px;">
    <h1>👑 Owner Dashboard</h1>
    <p style="color: gray;">Manage inventory, approvals, and alerts</p>
  </div>

  <!-- STATS CARDS -->
  <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-bottom: 25px;">

    <div style="background: #3498db; color: white; padding: 20px; border-radius: 12px;">
      <h3>Total Products</h3>
      <h2><%= @products.count %></h2>
    </div>

    <div style="background: #e67e22; color: white; padding: 20px; border-radius: 12px;">
      <h3>Pending Requests</h3>
      <h2><%= @requests.count %></h2>
    </div>

    <div style="background: #e74c3c; color: white; padding: 20px; border-radius: 12px;">
      <h3>Low Stock Items</h3>
      <h2><%= @low_stock_products.count %></h2>
    </div>

  </div>

  <!-- QUICK ACTIONS -->
  <div style="margin-bottom: 20px;">

    <%= link_to "➕ Add Product", new_product_path,
        style: "background: #27ae60; color: white; padding: 10px 15px; border-radius: 6px; text-decoration: none; margin-right: 10px;" %>

    <%= link_to "📦 View Products", products_path,
        style: "background: #2980b9; color: white; padding: 10px 15px; border-radius: 6px; text-decoration: none; margin-right: 10px;" %>

    <%= link_to "🚨 Alerts", owner_alerts_path,
        style: "background: #c0392b; color: white; padding: 10px 15px; border-radius: 6px; text-decoration: none; margin-right: 10px;" %>

    <%= link_to "📜 History", owner_history_path,
        style: "background: #8e44ad; color: white; padding: 10px 15px; border-radius: 6px; text-decoration: none;" %>

  </div>

  <!-- PENDING REQUESTS -->
  <div style="background: white; padding: 20px; border-radius: 12px; margin-bottom: 20px;">

    <h3>⏳ Pending Requests</h3>

    <% if @requests.any? %>

      <table style="width: 100%; border-collapse: collapse; margin-top: 10px;">

        <thead style="background: #2c3e50; color: white;">
          <tr>
            <th style="padding: 10px;">Worker</th>
            <th>Product</th>
            <th>Change</th>
            <th>Action</th>
          </tr>
        </thead>

        <tbody>
          <% @requests.pending.each do |req| %>
            <tr style="border-bottom: 1px solid #ddd;">

              <td style="padding: 10px;"><%= req.user.email %></td>

              <td><%= req.product.name %></td>

              <td style="color: <%= req.quantity_change < 0 ? 'red' : 'green' %>;">
                <%= req.quantity_change %>
              </td>

              <td>
                <%= button_to "Approve", approve_request_path(req),
                      method: :patch,
                      style: "background: green; color: white; border: none; padding: 5px 10px; border-radius: 5px;" %>

                <%= button_to "Reject", reject_request_path(req),
                      method: :patch,
                      style: "background: red; color: white; border: none; padding: 5px 10px; border-radius: 5px;" %>
              </td>

            </tr>
          <% end %>
        </tbody>

      </table>

    <% else %>

      <p style="color: gray;">No pending requests 🎉</p>

    <% end %>

  </div>

  <!-- LOW STOCK PREVIEW -->
  <div style="background: white; padding: 20px; border-radius: 12px;">

    <h3>🚨 Low Stock Preview</h3>

    <% if @low_stock_products.any? %>

      <ul>
        <% @low_stock_products.each do |product| %>
          <li>
            <%= link_to product.name, product_path(product) %>
            → <span style="color: red;"><%= product.stock_count %></span>
          </li>
        <% end %>
      </ul>

    <% else %>

      <p style="color: gray;">All stock levels are good 👍</p>

    <% end %>

  </div>

</div>