<div class="min-h-screen bg-blue-50 p-6">

  <!-- HEADER -->
  <div class="bg-blue-700 text-white p-6 rounded-2xl shadow-md mb-6">
    <h1 class="text-2xl font-bold">Owner Dashboard</h1>
    <p class="text-blue-100">Manage stock & approvals</p>
  </div>

  <!-- STATS -->
  <div class="grid md:grid-cols-3 gap-6 mb-6">

    <div class="bg-white p-5 rounded-2xl shadow border-t-4 border-blue-600">
      <p class="text-gray-500 text-sm">📦 Products</p>
      <h2 class="text-2xl font-bold text-blue-800 mt-1">
        <%= @products.count %>
      </h2>
    </div>

    <div class="bg-white p-5 rounded-2xl shadow border-t-4 border-blue-500">
      <p class="text-gray-500 text-sm">📝 Requests</p>
      <h2 class="text-2xl font-bold text-blue-700 mt-1">
        <%= @requests.count %>
      </h2>
    </div>

    <div class="bg-white p-5 rounded-2xl shadow border-t-4 border-red-500">
      <p class="text-gray-500 text-sm">⚠ Low Stock</p>
      <h2 class="text-2xl font-bold text-red-500 mt-1">
        <%= @low_stock_products.count %>
      </h2>
    </div>

  </div>

  <!-- PENDING REQUESTS -->
  <div class="bg-white rounded-2xl shadow-md p-6 border border-blue-100">

    <h2 class="text-xl font-bold text-blue-800 mb-4 border-b pb-2">
      Pending Requests
    </h2>

    <% if @requests.any? %>

      <table class="w-full text-sm">

        <thead class="bg-blue-100 text-blue-800">
          <tr>
            <th class="p-3 text-left">📦 Product</th>
            <th class="p-3 text-left">🔢 Qty</th>
            <th class="p-3 text-left">👷 Worker</th>
            <th class="p-3 text-left">⚙ Actions</th>
          </tr>
        </thead>

        <tbody>
          <% @requests.where(status: :pending).each do |req| %>
            <tr class="border-b last:border-none hover:bg-blue-50 transition">

              <td class="p-3 font-medium">
                <%= req.product.name %>
              </td>

              <td class="p-3 font-semibold text-blue-700">
                <%= req.quantity_change %>
              </td>

              <td class="p-3 text-gray-600">
                <%= req.user_name || req.user&.email || "Unknown User" %>
              </td>

              <td class="p-3 flex gap-2">

                <%= button_to approve_request_path(req),
                    method: :patch,
                    class: "bg-blue-600 text-white px-3 py-1 rounded-lg text-sm hover:bg-blue-700" do %>
                  ✔ Approve
                <% end %>

                <%= button_to reject_request_path(req),
                    method: :patch,
                    class: "bg-gray-200 text-gray-700 px-3 py-1 rounded-lg text-sm hover:bg-gray-300" do %>
                  ✖ Reject
                <% end %>

              </td>

            </tr>
          <% end %>
        </tbody>

      </table>

    <% else %>

      <p class="text-gray-500 text-center py-6">
        ✅ No pending requests
      </p>

    <% end %>
    <% if @pending_requests_count > 3 %>
      <%= link_to "View More →", owner_pending_requests_path,
        class: "text-sm text-blue-600 hover:underline" %>
    <% end %>
</div>