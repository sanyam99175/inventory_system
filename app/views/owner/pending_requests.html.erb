<div class="max-w-5xl mx-auto p-6">

  <!-- HEADER -->
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-2xl font-bold text-blue-800"><%= t('all_pending_requests') %></h1>
  </div>

  <% if @requests.any? %>
      <% if current_user.has_permission?("requests", "update") %>
        <div style="display: flex; justify-content: flex-end; margin-bottom: 15px;">

          <%= button_to approve_all_requests_path,
              method: :post,
              data: {
              turbo_confirm: t('are_you_sure_approve_all')
              },
              style: "
              background: #16a34a;
              color: white;
              padding: 10px 14px;
              border: none;
              border-radius: 8px;
              cursor: pointer;
              font-weight: 600;
              " do %>

          ✅ <%= t('approve_all') %>

          <% end %>

      </div>
      <% end %>
    <!-- TABLE -->
    <div class="bg-white rounded-2xl shadow p-6">

        <table class="w-full">

        <thead class="bg-blue-100 text-blue-900">
            <tr>
            <th class="p-3 text-left"><%= t('product') %></th>
            <th><%= t('quantity') %></th>
            <th><%= t('worker') %></th>
            <th><%= t('actions') %></th>
            </tr>
        </thead>

        <tbody>
            <% @requests.each do |req| %>
            <tr class="border-b hover:bg-blue-50">

                <td class="p-3"><%= req.product.name %></td>

                <td class="font-semibold text-blue-700">
                <%= req.quantity_change %>
                </td>

                <td><%= req.user_name || req.user&.email || t('unknown_user') %></td>

                <td class="flex gap-2">
                <% if current_user.has_permission?("requests", "update") %>
                  <%= button_to "Approve", approve_request_path(req),
                      method: :patch,
                      class: "bg-blue-600 text-white px-3 py-1 rounded-lg hover:bg-blue-700" %>

                  <%= button_to "Reject", reject_request_path(req),
                      method: :patch,
                      class: "bg-gray-300 text-gray-800 px-3 py-1 rounded-lg hover:bg-gray-400" %>
                <% else %>
                  <span class="text-gray-500 text-sm">No action permissions</span>
                <% end %>
                </td>

            </tr>
            <% end %>
        </tbody>

        </table>

    </div>
  <% else %>
    <!-- EMPTY STATE -->
    <div style="
      background: #f8fafc;
      border: 1px dashed #cbd5e1;
      padding: 40px;
      text-align: center;
      border-radius: 12px;
      color: #64748b;
      font-size: 16px;
    ">
      🚀 <%= t('no_pending_requests') %>
    </div>                   
  <% end %>

</div>