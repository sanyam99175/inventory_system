<div class="min-h-screen bg-gradient-to-br from-indigo-50 via-white to-indigo-100">

  <div class="max-w-7xl mx-auto px-4 md:px-6 py-6">

    <!-- ================= PAGE HEADER ================= -->
    <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-5 mb-6">

      <!-- LEFT -->
      <div>

        <div class="flex items-center gap-3">

          <div class="w-12 h-12 rounded-2xl bg-indigo-600 flex items-center justify-center shadow-sm">
            <%= icon('clipboard-list', class: 'w-6 h-6 text-white') %>
          </div>

          <div>

            <h1 class="text-2xl md:text-3xl font-bold tracking-tight text-gray-900">
              <%= t('all_pending_requests') %>
            </h1>

            <p class="text-sm text-gray-500 mt-1">
              Review and manage pending inventory requests
            </p>

          </div>

        </div>

      </div>

      <!-- RIGHT -->
      <% if @requests.any? && current_user.has_permission?("requests", "update") %>

        <div>

          <%= button_to approve_all_requests_path,
              method: :post,
              data: { turbo_confirm: t('are_you_sure_approve_all') },
              class: "bg-indigo-600 hover:bg-indigo-700 text-white px-5 py-3 rounded-2xl text-sm font-semibold transition shadow-sm flex items-center gap-2" do %>

            <%= icon('check', class: 'w-4 h-4') %>

            <span>
              <%= t('approve_all') %>
            </span>

          <% end %>

        </div>

      <% end %>

    </div>

    <% if @requests.any? %>

      <!-- ================= REQUESTS CONTAINER ================= -->
      <div class="bg-white/90 backdrop-blur rounded-3xl border border-indigo-100 shadow-sm overflow-hidden">

        <!-- TOP BAR -->
        <div class="px-5 md:px-6 py-5 border-b border-indigo-50 flex items-center justify-between">

          <div>

            <h2 class="font-semibold text-gray-900">
              Pending Requests
            </h2>

            <p class="text-sm text-gray-500 mt-1">
              <%= @requests.count %> requests waiting for approval
            </p>

          </div>

        </div>

        <!-- ================= MOBILE CARDS ================= -->
        <div class="block lg:hidden divide-y divide-indigo-50">

          <% @requests.each do |req| %>

            <div class="p-4 hover:bg-indigo-50/30 transition">

              <!-- TOP -->
              <div class="flex items-start gap-3">

                <!-- ICON -->
                <div class="w-11 h-11 rounded-2xl bg-indigo-50 border border-indigo-100 flex items-center justify-center shrink-0">

                  <%= icon('box', class: 'w-5 h-5 text-indigo-700') %>

                </div>

                <!-- CONTENT -->
                <div class="flex-1 min-w-0">

                  <!-- PRODUCT -->
                  <div class="flex items-center justify-between gap-3">

                    <div>

                      <h3 class="font-semibold text-gray-900 truncate">
                        <%= req.product.name %>
                      </h3>

                      <p class="text-sm text-gray-500 mt-1">
                        <%= req.user_name || req.user&.email || t('unknown_user') %>
                      </p>

                    </div>

                    <!-- QTY -->
                    <div class="bg-indigo-50 border border-indigo-100 text-indigo-700 px-3 py-2 rounded-2xl text-sm font-bold shrink-0">

                      <%= req.quantity_change %>

                    </div>

                  </div>

                  <!-- STATUS -->
                  <div class="mt-4 flex items-center gap-2 text-xs text-indigo-700 font-medium">

                    <div class="w-2 h-2 rounded-full bg-indigo-500"></div>

                    Awaiting approval

                  </div>

                </div>

              </div>

              <!-- ACTIONS -->
              <% if current_user.has_permission?("requests", "update") %>

                <div class="grid grid-cols-2 gap-3 mt-5">

                  <%= button_to approve_request_path(req),
                      method: :patch,
                      class: "bg-indigo-600 hover:bg-indigo-700 text-white py-3 rounded-2xl text-sm font-semibold transition" do %>

                    <%= t('approve') %>

                  <% end %>

                  <%= button_to reject_request_path(req),
                      method: :patch,
                      class: "bg-white border border-indigo-100 hover:bg-indigo-50 text-gray-700 py-3 rounded-2xl text-sm font-semibold transition" do %>

                    <%= t('reject') %>

                  <% end %>

                </div>

              <% end %>

            </div>

          <% end %>

        </div>

        <!-- ================= DESKTOP TABLE ================= -->
        <div class="hidden lg:block overflow-x-auto">

          <table class="min-w-full">

            <!-- HEAD -->
            <thead class="bg-indigo-50/70 border-b border-indigo-100">

              <tr>

                <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wide text-indigo-700">
                  Product
                </th>

                <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wide text-indigo-700">
                  Quantity
                </th>

                <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wide text-indigo-700">
                  Worker
                </th>

                <th class="px-6 py-4 text-right text-xs font-semibold uppercase tracking-wide text-indigo-700">
                  Actions
                </th>

              </tr>

            </thead>

            <!-- BODY -->
            <tbody class="divide-y divide-indigo-50">

              <% @requests.each do |req| %>

                <tr class="hover:bg-indigo-50/40 transition">

                  <!-- PRODUCT -->
                  <td class="px-6 py-5">

                    <div class="flex items-center gap-4">

                      <div class="w-11 h-11 rounded-2xl bg-indigo-50 border border-indigo-100 flex items-center justify-center shrink-0">

                        <%= icon('box', class: 'w-5 h-5 text-indigo-700') %>

                      </div>

                      <div>

                        <h3 class="font-semibold text-gray-900">
                          <%= req.product.name %>
                        </h3>

                        <p class="text-sm text-gray-500 mt-1">
                          Inventory request
                        </p>

                      </div>

                    </div>

                  </td>

                  <!-- QUANTITY -->
                  <td class="px-6 py-5">

                    <div class="inline-flex bg-indigo-50 border border-indigo-100 text-indigo-700 px-3 py-2 rounded-2xl text-sm font-bold">

                      <%= req.quantity_change %>

                    </div>

                  </td>

                  <!-- WORKER -->
                  <td class="px-6 py-5">

                    <div>

                      <p class="font-medium text-gray-800">
                        <%= req.user_name || req.user&.email || t('unknown_user') %>
                      </p>

                      <p class="text-sm text-gray-500 mt-1">
                        Requested stock update
                      </p>

                    </div>

                  </td>

                  <!-- ACTIONS -->
                  <td class="px-6 py-5">

                    <% if current_user.has_permission?("requests", "update") %>

                      <div class="flex items-center justify-end gap-2">

                        <%= button_to approve_request_path(req),
                            method: :patch,
                            class: "bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2 rounded-xl text-sm font-semibold transition" do %>

                          <%= t('approve') %>

                        <% end %>

                        <%= button_to reject_request_path(req),
                            method: :patch,
                            class: "bg-white border border-indigo-100 hover:bg-indigo-50 text-gray-700 px-4 py-2 rounded-xl text-sm font-semibold transition" do %>

                          <%= t('reject') %>

                        <% end %>

                      </div>

                    <% end %>

                  </td>

                </tr>

              <% end %>

            </tbody>

          </table>

        </div>

      </div>

    <% else %>

      <!-- ================= EMPTY STATE ================= -->
      <div class="bg-white/90 backdrop-blur border border-indigo-100 rounded-3xl shadow-sm py-20 px-6 text-center">

        <div class="w-24 h-24 rounded-full bg-indigo-50 border border-indigo-100 flex items-center justify-center mx-auto mb-6">

          <%= icon('check', class: 'w-10 h-10 text-indigo-700') %>

        </div>

        <h2 class="text-2xl font-bold text-gray-900">
          <%= t('no_pending_requests') %>
        </h2>

        <p class="text-gray-500 mt-3 max-w-md mx-auto">
          Everything looks good right now. There are no pending inventory requests awaiting approval.
        </p>

      </div>

    <% end %>

  </div>

</div>