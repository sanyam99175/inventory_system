<div class="min-h-screen bg-gradient-to-br from-indigo-50 via-white to-indigo-100">

  <div class="max-w-7xl mx-auto px-4 md:px-6 py-6">

    <!-- ================= PAGE HEADER ================= -->
    <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-5 mb-6">

      <!-- LEFT -->
      <div class="flex items-center gap-4">

        <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-indigo-600 to-indigo-500 flex items-center justify-center shadow-sm">
          <%= icon('scroll', class: 'w-6 h-6 text-white') %>
        </div>

        <div>

          <h1 class="text-2xl md:text-3xl font-bold tracking-tight text-gray-900">
            <%= t('stock_history') %>
          </h1>

          <p class="text-base text-gray-500 mt-1">
            <%= t('track_all_stock_movements') %>
          </p>

        </div>

      </div>

      <!-- RIGHT ACTIONS -->
      <div class="flex flex-wrap gap-3">

        <%= link_to dashboard_path,
            class: "bg-white hover:bg-gray-50 border border-gray-200 text-gray-700 px-4 py-3 rounded-2xl text-base font-medium transition flex items-center gap-2 shadow-sm" do %>

          <%= icon('home', class: 'w-4 h-4') %>

          <span><%= t('dashboard') %></span>

        <% end %>

      </div>

    </div>

    <!-- ================= FILTER CARD ================= -->
    <div class="bg-white/90 backdrop-blur rounded-3xl border border-indigo-100 shadow-sm p-5 mb-6">

      <!-- HEADER -->
      <div class="mb-5">

        <h2 class="font-semibold text-gray-900">
          Filters
        </h2>

        <p class="text-sm text-gray-500 mt-1">
          Narrow down stock history records
        </p>

      </div>

      <!-- FORM -->
      <%= form_with url: history_path,
          method: :get,
          local: true do %>

        <%= hidden_field_tag :locale, I18n.locale %>

        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-[1fr_1fr_1fr_1fr_140px] gap-4 items-end">

          <!-- START DATE -->
          <div>

            <label class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-2 block">
              Start Date
            </label>

            <input
              type="date"
              name="start_date"
              value="<%= params[:start_date] %>"
              class="
                w-full
                bg-white
                border
                border-indigo-100
                rounded-2xl
                px-4
                py-3
                text-sm
                outline-none
                focus:ring-4
                focus:ring-indigo-100
                focus:border-indigo-400
              "
            >

          </div>

          <!-- END DATE -->
          <div>

            <label class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-2 block">
              End Date
            </label>

            <input
              type="date"
              name="end_date"
              value="<%= params[:end_date] %>"
              class="
                w-full
                bg-white
                border
                border-indigo-100
                rounded-2xl
                px-4
                py-3
                text-sm
                outline-none
                focus:ring-4
                focus:ring-indigo-100
                focus:border-indigo-400
              "
            >

          </div>

          <!-- USER -->
          <div>

            <label class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-2 block">
              User
            </label>

            <%= select_tag :user_id,
                options_from_collection_for_select(@users, :id, :email, params[:user_id]),
                include_blank: "All Users",
                class: "
                  w-full
                  bg-white
                  border
                  border-indigo-100
                  rounded-2xl
                  px-4
                  py-3
                  text-sm
                  outline-none
                  focus:ring-4
                  focus:ring-indigo-100
                  focus:border-indigo-400
                " %>

          </div>

          <!-- STATUS -->
          <div>

            <label class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-2 block">
              Status
            </label>

            <%= select_tag :status,
                options_for_select([
                  ["Pending", "pending"],
                  ["Approved", "approved"],
                  ["Rejected", "rejected"],
                  ["Cancelled", "cancelled"]
                ], params[:status]),
                include_blank: "All",
                class: "
                  w-full
                  bg-white
                  border
                  border-indigo-100
                  rounded-2xl
                  px-4
                  py-3
                  text-sm
                  outline-none
                  focus:ring-4
                  focus:ring-indigo-100
                  focus:border-indigo-400
                " %>

          </div>

          <!-- BUTTONS -->
          <div class="flex flex-col gap-2">

            <%= submit_tag "Apply",
                class: "
                  w-full
                  bg-indigo-600
                  hover:bg-indigo-700
                  text-white
                  py-3
                  rounded-2xl
                  text-sm
                  font-semibold
                  transition
                  shadow-sm
                  cursor-pointer
                " %>

            <%= link_to "Reset",
                history_path,
                class: "
                  w-full
                  text-center
                  bg-white
                  hover:bg-gray-50
                  border
                  border-gray-200
                  text-gray-700
                  py-3
                  rounded-2xl
                  text-sm
                  font-medium
                  transition
                " %>

          </div>

        </div>

      <% end %>

    </div>

    <!-- ================= ACTION BUTTONS ================= -->
    <div class="flex flex-wrap items-center justify-end gap-3 mb-5">

      <%= link_to owner_history_pdf_path(request.query_parameters.merge(format: :pdf)),
          class: "bg-white hover:bg-gray-50 border border-gray-200 text-gray-700 px-4 py-3 rounded-2xl text-base font-medium transition flex items-center gap-2 shadow-sm" do %>

        <%= icon('download', class: 'w-4 h-4') %>

        <span><%= t('pdf_download') %></span>

      <% end %>

      <%= button_to history_send_email_path(request.query_parameters),
          method: :post,
          class: "bg-indigo-600 hover:bg-indigo-700 text-white px-5 py-3 rounded-2xl text-base font-semibold transition shadow-sm flex items-center gap-2" do %>

        <%= icon('mail', class: 'w-4 h-4') %>

        <span><%= t('email_pdf_button') %></span>

      <% end %>

    </div>

    <!-- ================= TABLE CARD ================= -->
    <div class="bg-white/90 backdrop-blur rounded-3xl border border-indigo-100 shadow-sm">

      <% if @requests.any? %>

        <!-- TOP BAR -->
        <div class="px-6 py-5 border-b border-indigo-50 flex items-center justify-between">

          <div>

            <h2 class="font-semibold text-gray-900">
              Stock Activity
            </h2>

            <p class="text-base text-gray-500 mt-1">
              <%= @requests.count %> records found
            </p>

          </div>

        </div>

        <!-- DESKTOP TABLE -->
        <div class="hidden lg:block overflow-x-auto">

          <table class="min-w-full">

            <thead class="bg-indigo-50/70 border-b border-indigo-100">

              <tr>

                <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wide text-indigo-700">
                  User
                </th>

                <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wide text-indigo-700">
                  Type
                </th>

                <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wide text-indigo-700">
                  Product
                </th>

                <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wide text-indigo-700">
                  Godown
                </th>

                <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wide text-indigo-700">
                  Change
                </th>

                <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wide text-indigo-700">
                  Status
                </th>

                <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wide text-indigo-700">
                  Time
                </th>

              </tr>

            </thead>

            <tbody class="divide-y divide-indigo-50">

              <% @requests.each do |req| %>

                <tr class="hover:bg-indigo-50/40 transition">

                  <!-- USER -->
                  <td class="px-6 py-5">

                    <div class="flex items-center gap-3">

                      <div class="w-10 h-10 rounded-2xl bg-indigo-50 border border-indigo-100 flex items-center justify-center">

                        <%= icon('user', class: 'w-4 h-4 text-indigo-700') %>

                      </div>

                      <div>

                        <p class="font-semibold text-gray-900">
                          <%= req.user_name || req.user&.name || "Unknown" %>
                        </p>

                        <p class="text-xs text-gray-500 mt-1">
                          <%= req.user&.email %>
                        </p>

                      </div>

                    </div>

                  </td>

                  <!-- TYPE -->
                  <td class="px-6 py-5">

                    <span class="bg-indigo-50 border border-indigo-100 text-indigo-700 text-base px-3 py-1 rounded-full font-medium">

                      <%= req.user&.role == "owner" ? "Direct" : "Worker" %>

                    </span>

                  </td>

                  <!-- PRODUCT -->
                  <td class="px-6 py-5">

                    <div>

                      <p class="font-semibold text-gray-900">
                        <%= req.product&.name || req.product_name || "Deleted Product" %>
                      </p>

                    </div>

                  </td>

                  <!-- GODOWN -->
                  <td class="px-6 py-5 text-gray-600">

                    <%= req.product&.godown_number || "N/A" %>

                  </td>

                  <!-- CHANGE -->
                  <td class="px-6 py-5">

                    <span class="font-bold text-base px-3 py-1 rounded-full border
                      <%= req.quantity_change < 0 ?
                          'bg-red-50 text-red-700 border-red-100' :
                          'bg-emerald-50 text-emerald-700 border-emerald-100' %>">

                      <%= req.quantity_change > 0 ? '+' : '' %><%= req.quantity_change %>

                    </span>

                  </td>

                  <!-- STATUS -->
                  <td class="px-6 py-5">

                    <% status_class =
                      case req.status
                      when 'approved'
                        'bg-emerald-50 text-emerald-700 border border-emerald-100'
                      when 'rejected'
                        'bg-red-50 text-red-700 border border-red-100'
                      when 'cancelled'
                        'bg-gray-100 text-gray-600 border border-gray-200'
                      else
                        'bg-amber-50 text-amber-700 border border-amber-100'
                      end %>

                    <span class="px-3 py-1 rounded-full text-xs font-semibold <%= status_class %>">

                      <%= req.status.capitalize %>

                    </span>

                  </td>

                  <!-- TIME -->
                  <td class="px-6 py-5 text-base text-gray-500">

                    <%= req.created_at.strftime("%d %b %Y") %>

                    <div class="text-xs text-gray-400 mt-1">
                      <%= req.created_at.strftime("%H:%M") %>
                    </div>

                  </td>

                </tr>

              <% end %>

            </tbody>

          </table>

        </div>

        <!-- MOBILE CARDS -->
<!-- MOBILE CARDS -->
<div class="lg:hidden divide-y divide-indigo-50">

  <% @requests.each do |req| %>

    <% status_class =
      case req.status
      when 'approved'
        'bg-emerald-50 text-emerald-700 border border-emerald-100'
      when 'rejected'
        'bg-red-50 text-red-700 border border-red-100'
      when 'cancelled'
        'bg-gray-100 text-gray-600 border border-gray-200'
      else
        'bg-amber-50 text-amber-700 border border-amber-100'
      end %>

    <!-- CARD -->
    <button
      type="button"
      onclick="openHistoryModal('<%= req.id %>')"
      class="w-full text-left p-4 active:bg-indigo-50 transition"
    >

      <div class="flex items-center justify-between gap-3">

        <!-- LEFT -->
        <div class="flex items-center gap-3 min-w-0">

          <div class="
            w-11 h-11 rounded-2xl flex items-center justify-center shrink-0
            <%= req.quantity_change < 0 ?
              'bg-red-50 border border-red-100' :
              'bg-emerald-50 border border-emerald-100' %>
          ">

            <%= icon(
              req.quantity_change < 0 ? 'arrow-down' : 'arrow-up',
              class: "w-5 h-5 #{req.quantity_change < 0 ? 'text-red-600' : 'text-emerald-600'}"
            ) %>

          </div>

          <div class="min-w-0">

            <h3 class="font-semibold text-gray-900 truncate">
              <%= req.product&.name || req.product_name || "Deleted Product" %>
            </h3>

            <p class="text-base text-gray-500 truncate mt-1">
              <%= req.user_name || req.user&.name || "Unknown" %>
            </p>

          </div>

        </div>

        <!-- RIGHT -->
        <div class="text-right shrink-0">

          <div class="
            inline-flex px-3 py-1 rounded-full text-base font-bold border
            <%= req.quantity_change < 0 ?
              'bg-red-50 text-red-700 border-red-100' :
              'bg-emerald-50 text-emerald-700 border-emerald-100' %>
          ">

            <%= req.quantity_change > 0 ? '+' : '' %><%= req.quantity_change %>

          </div>

          <p class="text-xs text-gray-400 mt-2">
            <%= req.created_at.strftime("%d %b") %>
          </p>

        </div>

      </div>

    </button>

  <% end %>

</div>

<!-- GLOBAL MODALS OUTSIDE CARD CONTAINER -->
<% @requests.each do |req| %>

  <% status_class =
    case req.status
    when 'approved'
      'bg-emerald-50 text-emerald-700 border border-emerald-100'
    when 'rejected'
      'bg-red-50 text-red-700 border border-red-100'
    when 'cancelled'
      'bg-gray-100 text-gray-600 border border-gray-200'
    else
      'bg-amber-50 text-amber-700 border border-amber-100'
    end %>

  <!-- MODAL -->
  <div
    id="history-modal-<%= req.id %>"
    class="fixed inset-0 z-[9999] hidden"
  >

    <!-- BACKDROP -->
    <div
      onclick="closeHistoryModal('<%= req.id %>')"
      class="absolute inset-0 bg-black/40 backdrop-blur-sm"
    ></div>

    <!-- SHEET -->
    <div class="
      fixed
      bottom-0
      left-0
      right-0
      z-[10000]
      bg-white
      rounded-t-[32px]
      shadow-2xl
      animate-slide-up
      max-h-[88vh]
      overflow-y-auto
    ">

      <div class="p-6 pb-8">

        <!-- HANDLE -->
        <div class="w-14 h-1.5 rounded-full bg-gray-200 mx-auto mb-6"></div>

        <!-- HEADER -->
        <div class="flex items-start justify-between gap-4">

          <div>

            <h2 class="text-xl font-bold text-gray-900 leading-tight">
              <%= req.product&.name || req.product_name || "Deleted Product" %>
            </h2>

            <p class="text-base text-gray-500 mt-1">
              Full stock activity details
            </p>

          </div>

          <span class="px-3 py-1 rounded-full text-xs font-semibold whitespace-nowrap <%= status_class %>">
            <%= req.status.capitalize %>
          </span>

        </div>

        <!-- INFO -->
        <div class="space-y-4 mt-6">

          <!-- QUANTITY -->
          <div class="bg-indigo-50/70 border border-indigo-100 rounded-3xl p-5">

            <p class="text-xs uppercase tracking-wide text-indigo-500 font-semibold">
              Quantity Change
            </p>

            <h3 class="
              text-4xl font-black mt-2
              <%= req.quantity_change < 0 ? 'text-red-600' : 'text-emerald-600' %>
            ">
              <%= req.quantity_change > 0 ? '+' : '' %><%= req.quantity_change %>
            </h3>

          </div>

          <!-- GRID -->
          <div class="grid grid-cols-2 gap-3">

            <div class="bg-gray-50 rounded-2xl p-4 border border-gray-100">

              <p class="text-xs text-gray-400 uppercase font-semibold">
                User
              </p>

              <p class="text-base font-semibold text-gray-800 mt-2 break-words">
                <%= req.user_name || req.user&.name || "Unknown" %>
              </p>

            </div>

            <div class="bg-gray-50 rounded-2xl p-4 border border-gray-100">

              <p class="text-xs text-gray-400 uppercase font-semibold">
                Type
              </p>

              <p class="text-base font-semibold text-gray-800 mt-2">
                <%= req.user&.role == "owner" ? "Direct" : "Worker" %>
              </p>

            </div>

            <div class="bg-gray-50 rounded-2xl p-4 border border-gray-100">

              <p class="text-xs text-gray-400 uppercase font-semibold">
                Godown
              </p>

              <p class="text-base font-semibold text-gray-800 mt-2">
                <%= req.product&.godown_number || "N/A" %>
              </p>

            </div>

            <div class="bg-gray-50 rounded-2xl p-4 border border-gray-100">

              <p class="text-xs text-gray-400 uppercase font-semibold">
                Time
              </p>

              <p class="text-base font-semibold text-gray-800 mt-2">
                <%= req.created_at.strftime("%d %b, %H:%M") %>
              </p>

            </div>

          </div>

        </div>

        <!-- CLOSE -->
        <button
          type="button"
          onclick="closeHistoryModal('<%= req.id %>')"
          class="
            w-full mt-6
            bg-indigo-600 hover:bg-indigo-700
            text-white font-semibold
            py-4 rounded-2xl
            transition
            shadow-sm
          "
        >
          Close
        </button>

      </div>

    </div>

  </div>

<% end %>

<style>
  @keyframes slideUp {
    from {
      transform: translateY(100%);
      opacity: 0.95;
    }
    to {
      transform: translateY(0);
      opacity: 1;
    }
  }

  .animate-slide-up {
    animation: slideUp 0.24s ease-out;
  }
</style>

<script>
  function openHistoryModal(id) {
    const modal = document.getElementById(`history-modal-${id}`);

    if (!modal) return;

    modal.classList.remove("hidden");

    document.body.classList.add("overflow-hidden");
    document.documentElement.classList.add("overflow-hidden");
  }

  function closeHistoryModal(id) {
    const modal = document.getElementById(`history-modal-${id}`);

    if (!modal) return;

    modal.classList.add("hidden");

    document.body.classList.remove("overflow-hidden");
    document.documentElement.classList.remove("overflow-hidden");
  }
</script>

        <!-- PAGINATION -->
        <% if @requests.respond_to?(:current_page) %>

          <div class="flex items-center justify-between px-6 py-5 border-t border-indigo-50 bg-indigo-50/40">

            <div class="text-base text-gray-500">
              Page <%= @requests.current_page %>
            </div>

            <div class="flex items-center gap-3">

              <% if @requests.prev_page %>

                <%= link_to history_path(request.query_parameters.merge(page: @requests.prev_page)),
                    class: "bg-white hover:bg-gray-50 border border-gray-200 text-gray-700 px-4 py-2 rounded-xl text-base font-medium transition" do %>

                  ← Previous

                <% end %>

              <% end %>

              <% if @requests.next_page %>

                <%= link_to history_path(request.query_parameters.merge(page: @requests.next_page)),
                    class: "bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2 rounded-xl text-base font-medium transition" do %>

                  Next →

                <% end %>

              <% end %>

            </div>

          </div>

        <% end %>

      <% else %>

        <!-- EMPTY STATE -->
        <div class="py-20 px-6 text-center">

          <div class="w-20 h-20 rounded-full bg-amber-50 border border-amber-100 flex items-center justify-center mx-auto mb-5">

            <%= icon('inbox', class: 'w-8 h-8 text-amber-600') %>

          </div>

          <h3 class="text-lg font-semibold text-gray-900">
            No history found
          </h3>

          <p class="text-base text-gray-500 mt-2">
            Try adjusting filters or date range
          </p>

          <div class="mt-5">

            <%= link_to history_path,
                class: "bg-indigo-600 hover:bg-indigo-700 text-white px-5 py-3 rounded-2xl text-base font-semibold transition inline-flex items-center gap-2 shadow-sm" do %>

              <%= icon('refresh', class: 'w-4 h-4') %>

              <span>Clear Filters</span>

            <% end %>

          </div>

        </div>

      <% end %>

    </div>

  </div>

</div>