<div class="max-w-6xl mx-auto p-6">

  <!-- HEADER -->
  <div class="flex justify-between items-center mb-6">

    <h1 class="text-2xl font-bold text-indigo-700">
      📜 <%= t('stock_history') %>
    </h1>

    <%= link_to "⬅ #{t('dashboard')}", dashboard_path,
        class: "bg-indigo-600 text-white px-4 py-2 rounded-lg hover:bg-indigo-700" %>

  </div>

  <!-- FILTER CARD -->
  <div class="bg-white p-5 rounded-2xl border border-indigo-100 shadow mb-6">

    <%= form_with url: history_path, method: :get, local: true do %>

      <%= hidden_field_tag :locale, I18n.locale %>

      <div class="grid md:grid-cols-5 gap-4 items-end">

        <!-- FROM -->
        <div>
          <label class="text-xs text-gray-600"><%= t('from') %></label>
          <%= date_field_tag :start_date, params[:start_date],
              class: "w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-indigo-500" %>
        </div>

        <!-- TO -->
        <div>
          <label class="text-xs text-gray-600"><%= t('to') %></label>
          <%= date_field_tag :end_date, params[:end_date],
              class: "w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-indigo-500" %>
        </div>

        <!-- USER -->
        <div>
          <label class="text-xs text-gray-600"><%= t('user') %></label>
          <%= select_tag :user_id,
              options_from_collection_for_select(@users, :id, :email, params[:user_id]),
              include_blank: "All Users",
              class: "w-full px-3 py-2 border rounded-lg" %>
        </div>

        <!-- STATUS -->
        <div>
          <label class="text-xs text-gray-600"><%= t('status') %></label>
          <%= select_tag :status,
              options_for_select([
                [t('all'), ""],
                [t('pending'), "pending"],
                [t('approved'), "approved"],
                [t('rejected'), "rejected"],
                [t('cancelled'), "cancelled"]
              ], params[:status]),
              class: "w-full px-3 py-2 border rounded-lg" %>
        </div>

        <!-- ACTIONS -->
        <div class="flex gap-2">

          <%= submit_tag t('apply'),
              class: "bg-indigo-600 text-white px-4 py-2 rounded-lg hover:bg-indigo-700" %>

          <%= link_to t('clear'), history_path,
              class: "text-indigo-600 hover:underline px-2 py-2" %>

        </div>

      </div>

    <% end %>

  </div>

  <!-- ACTION BUTTONS -->
  <div class="flex justify-end gap-3 mb-4">

    <%= button_to history_send_email_path(
          start_date: params[:start_date],
          end_date: params[:end_date],
          status: params[:status],
          user_id: params[:user_id]
        ),
        method: :post,
        class: "bg-indigo-600 text-white px-4 py-2 rounded-lg hover:bg-indigo-700" do %>
      <%= t('send_pdf_to_email') %>
    <% end %>

    <%= link_to "⬇ #{t('download_pdf')}",
        owner_history_pdf_path(
          start_date: params[:start_date],
          end_date: params[:end_date],
          status: params[:status],
          user_id: params[:user_id],
          format: :pdf
        ),
        class: "bg-indigo-500 text-white px-4 py-2 rounded-lg hover:bg-indigo-600" %>

  </div>

  <!-- TABLE -->
  <div class="bg-white rounded-2xl shadow border border-indigo-100 overflow-hidden">

    <table class="w-full text-sm">

      <thead class="bg-indigo-100 text-indigo-800">
        <tr>
          <th class="p-3 text-left"><%= t('user') %></th>
          <th class="p-3 text-left"><%= t('type') %></th>
          <th class="p-3 text-left"><%= t('product') %></th>
          <th class="p-3 text-left"><%= t('godown') %></th>
          <th class="p-3 text-left"><%= t('change') %></th>
          <th class="p-3 text-left"><%= t('status') %></th>
          <th class="p-3 text-left"><%= t('time') %></th>
        </tr>
      </thead>

      <tbody>
        <% @requests.each do |req| %>

          <tr class="border-b hover:bg-indigo-50 transition">

            <td class="p-3 text-gray-700">
              <%= req.user_name || req.user&.name || t('unknown_user') %>
            </td>

            <td class="p-3 text-gray-600">
              <%= req.user.nil? ? "Unknown" : (req.user.role == "owner" ? "Direct" : "Worker") %>
            </td>

            <td class="p-3 text-gray-800">
              <%= req.product ? req.product.name : (req.product_name || "Deleted Product") %>
            </td>

            <td class="p-3 text-gray-600">
              <%= req.product&.godown_number || req.godown_number || "N/A" %>
            </td>

            <td class="p-3 font-semibold <%= req.quantity_change < 0 ? 'text-red-600' : 'text-green-600' %>">
              <%= req.quantity_change %>
            </td>

            <td class="p-3">
              <span class="px-2 py-1 text-xs rounded text-white
                <%= case req.status
                    when 'approved' then 'bg-green-600'
                    when 'rejected' then 'bg-red-600'
                    when 'cancelled' then 'bg-gray-500'
                    else 'bg-yellow-500'
                  end %>">
                <%= req.status&.capitalize || t('pending') %>
              </span>
            </td>

            <td class="p-3 text-gray-500">
              <%= req.created_at.strftime("%d %b %Y, %I:%M %p") %>
            </td>

          </tr>

        <% end %>
      </tbody>

    </table>

  </div>

</div>