<div class="max-w-7xl mx-auto px-4 py-6">

  <!-- HEADER -->
  <div class="flex flex-col md:flex-row md:justify-between md:items-center gap-4 mb-6">

    <div>
      <h1 class="text-2xl font-bold text-indigo-700">
        📜 <%= t('stock_history') %>
      </h1>
      <p class="text-sm text-gray-500">Track all stock movements & approvals</p>
    </div>

    <div class="flex gap-2">
      <%= link_to "⬅ #{t('dashboard')}", dashboard_path,
          class: "bg-indigo-600 text-white px-4 py-2 rounded-lg hover:bg-indigo-700 text-sm" %>
    </div>

  </div>

  <!-- FILTER BAR -->
  <div class="bg-white border border-indigo-100 shadow-sm rounded-xl p-4 mb-6">

    <%= form_with url: history_path, method: :get, local: true do %>
      <%= hidden_field_tag :locale, I18n.locale %>

      <div class="grid grid-cols-1 md:grid-cols-5 gap-3 items-end">

        <%= date_field_tag :start_date, params[:start_date],
            class: "w-full px-3 py-2 border rounded-lg text-sm focus:ring-2 focus:ring-indigo-500" %>

        <%= date_field_tag :end_date, params[:end_date],
            class: "w-full px-3 py-2 border rounded-lg text-sm focus:ring-2 focus:ring-indigo-500" %>

        <%= select_tag :user_id,
            options_from_collection_for_select(@users, :id, :email, params[:user_id]),
            include_blank: "All Users",
            class: "w-full px-3 py-2 border rounded-lg text-sm" %>

        <%= select_tag :status,
            options_for_select([
              ["All", ""],
              ["Pending", "pending"],
              ["Approved", "approved"],
              ["Rejected", "rejected"],
              ["Cancelled", "cancelled"]
            ], params[:status]),
            class: "w-full px-3 py-2 border rounded-lg text-sm" %>

        <div class="flex gap-2">
          <%= submit_tag "Apply",
              class: "bg-indigo-600 text-white px-4 py-2 rounded-lg hover:bg-indigo-700 text-sm w-full" %>

          <%= link_to "Reset", history_path,
              class: "text-indigo-600 hover:underline px-2 py-2 text-sm" %>
        </div>

      </div>
    <% end %>

  </div>

  <!-- ACTIONS -->
  <div class="flex justify-end gap-3 mb-4">

    <%= link_to "⬇ PDF",
        owner_history_pdf_path(request.query_parameters.merge(format: :pdf)),
        class: "bg-indigo-500 text-white px-4 py-2 rounded-lg hover:bg-indigo-600 text-sm" %>

    <%= button_to "Email PDF",
        history_send_email_path(request.query_parameters),
        method: :post,
        class: "bg-indigo-600 text-white px-4 py-2 rounded-lg hover:bg-indigo-700 text-sm" %>

  </div>

  <!-- TABLE CARD -->
  <div class="bg-white rounded-2xl shadow border border-indigo-100 overflow-hidden">

    <% if @requests.any? %>

      <div class="overflow-x-auto">

        <table class="min-w-full text-sm">

          <thead class="bg-indigo-50 text-indigo-800 sticky top-0 z-10">
            <tr>
              <th class="p-3 text-left">User</th>
              <th class="p-3 text-left">Type</th>
              <th class="p-3 text-left">Product</th>
              <th class="p-3 text-left">Godown</th>
              <th class="p-3 text-left">Change</th>
              <th class="p-3 text-left">Status</th>
              <th class="p-3 text-left">Time</th>
            </tr>
          </thead>

          <tbody class="divide-y divide-gray-100">

            <% @requests.each do |req| %>

              <tr class="hover:bg-indigo-50 transition">

                <td class="p-3 font-medium text-gray-800">
                  <%= req.user_name || req.user&.name || "Unknown" %>
                </td>

                <td class="p-3 text-gray-500">
                  <%= req.user&.role == "owner" ? "Direct" : "Worker" %>
                </td>

                <td class="p-3 text-gray-800">
                  <%= req.product&.name || req.product_name || "Deleted Product" %>
                </td>

                <td class="p-3 text-gray-500">
                  <%= req.product&.godown_number || "N/A" %>
                </td>

                <td class="p-3 font-semibold <%= req.quantity_change < 0 ? 'text-red-600' : 'text-green-600' %>">
                  <%= req.quantity_change %>
                </td>

                <td class="p-3">
                  <% color =
                    case req.status
                    when 'approved' then 'bg-green-100 text-green-700'
                    when 'rejected' then 'bg-red-100 text-red-700'
                    when 'cancelled' then 'bg-gray-100 text-gray-600'
                    else 'bg-yellow-100 text-yellow-700'
                    end %>

                  <span class="px-2 py-1 text-xs rounded-full <%= color %>">
                    <%= req.status.capitalize %>
                  </span>
                </td>

                <td class="p-3 text-gray-500 text-xs">
                  <%= req.created_at.strftime("%d %B %Y, %H:%M") %>
                </td>

              </tr>

            <% end %>

          </tbody>

        </table>

      </div>

      <!-- ✅ PAGINATION (ADDED HERE) -->
      <div class="flex justify-between items-center px-4 py-3 border-t bg-gray-50 text-sm">

        <% if @requests.respond_to?(:current_page) %>

          <% if @requests.prev_page %>
            <%= link_to "← Previous",
                history_path(request.query_parameters.merge(page: @requests.prev_page)),
                class: "text-indigo-600 hover:underline" %>
          <% end %>

          <span class="text-gray-500">
            Page <%= @requests.current_page %>
          </span>

          <% if @requests.next_page %>
            <%= link_to "Next →",
                history_path(request.query_parameters.merge(page: @requests.next_page)),
                class: "text-indigo-600 hover:underline" %>
          <% end %>

        <% end %>

      </div>

    <% else %>

      <!-- EMPTY STATE -->
      <div class="py-16 text-center">

        <div class="text-5xl mb-3">📭</div>
        <p class="text-lg font-semibold text-gray-700">No history found</p>
        <p class="text-gray-500 text-sm mb-4">Try adjusting filters</p>

        <%= link_to "Clear Filters", history_path,
            class: "bg-indigo-600 text-white px-5 py-2 rounded-lg hover:bg-indigo-700 text-sm" %>

      </div>

    <% end %>

  </div>

</div>