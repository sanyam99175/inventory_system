<div class="max-w-7xl mx-auto p-6">

  <!-- HEADER -->
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-2xl font-bold text-indigo-700">Stockflow Intelligence</h1>

    <div class="text-sm text-gray-500">
      Range: <span class="font-semibold text-indigo-700"><%= @range %></span>
    </div>
  </div>

  <% if @show_early_stage_warning %>

  <div
    id="early-stage-banner"
    class="max-w-7xl mx-auto px-4 mt-4 mb-4"
  >

    <div class="bg-amber-50 border border-amber-200 text-amber-800 px-4 py-3 rounded-xl flex items-start justify-between gap-3 shadow-sm">

      <!-- LEFT CONTENT -->
      <div class="flex items-start gap-3">

        <div class="text-xl">⚠️</div>

        <div class="text-sm leading-5">

          <p class="font-semibold">
            Early-stage data warning
          </p>

          <p class="text-amber-700 mt-1">
            StockFlow insights are still learning from your usage patterns.
            Predictions may not be fully accurate yet.
          </p>

          <p class="text-amber-600 mt-1 font-medium">
            Data becomes more reliable after ~30 days of usage.
          </p>

        </div>

      </div>

      <!-- CLOSE BUTTON -->
      <button
        onclick="dismissEarlyBanner()"
        class="text-amber-700 hover:text-amber-900 text-lg font-bold px-2"
      >
        ✖
      </button>

    </div>

  </div>

<% end %>

  <!-- HEALTH SCORE -->
<!-- HEALTH SCORE CARD -->
    <div class="bg-white border rounded-2xl p-6 shadow mb-6 flex justify-between items-center cursor-pointer"
        onclick="document.getElementById('healthModal').classList.remove('hidden')">

    <div>
        <p class="text-sm text-gray-500">StockFlow Health Score</p>
        <p class="text-4xl font-bold text-indigo-600">
        <%= @health_score %>/100
        </p>

        <p class="text-xs text-gray-400 mt-1">
        Click to see why this changed
        </p>
    </div>

    <div>
        <span class="text-indigo-600 font-semibold">View breakdown →</span>
    </div>

    </div>

    <!-- AI EXPLANATION -->

  <!-- KPI STRIPE STYLE -->
  <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">

    <div class="bg-white p-4 rounded-xl shadow border">
      <p class="text-xs text-gray-500">Activity</p>
      <div class="flex items-center justify-between">
        <p class="text-xl font-bold"><%= @total_activity %></p>
        <span class="<%= @activity_change_pct >= 0 ? 'text-green-600' : 'text-red-500' %> text-sm">
          <%= @activity_change_pct.round(1) %>%
        </span>
      </div>
    </div>

    <div class="bg-white p-4 rounded-xl shadow border">
      <p class="text-xs text-gray-500">Requests</p>
      <div class="flex items-center justify-between">
        <p class="text-xl font-bold"><%= @request_count %></p>
        <span class="text-sm text-gray-500">
          <%= @request_change_pct.round(1) %>%
        </span>
      </div>
    </div>

    <div class="bg-white p-4 rounded-xl shadow border">
      <p class="text-xs text-gray-500">Top Staff</p>
      <p class="text-sm font-semibold text-green-600">
        <%= @top_staff&.dig(:name) %>
      </p>
    </div>

    <div class="bg-white p-4 rounded-xl shadow border">
      <p class="text-xs text-gray-500">Top Product</p>
      <p class="text-sm font-semibold text-blue-600">
        <%= @top_product&.first %>
      </p>
    </div>

  </div>

  <!-- INSIGHTS -->
  <div class="grid md:grid-cols-3 gap-4 mb-6">

    <% @insights.each do |insight| %>
      <div class="p-4 rounded-xl border bg-white">
        <p class="text-xs text-gray-500 mb-1">Insight</p>
        <p class="text-sm font-semibold
          <%= insight[:type] == 'positive' ? 'text-green-600' :
              insight[:type] == 'danger' ? 'text-red-600' :
              'text-gray-700' %>">
          <%= insight[:text] %>
        </p>
      </div>
    <% end %>

  </div>

  <!-- CHARTS -->
  <div class="grid md:grid-cols-2 gap-6">

    <div class="bg-white p-4 rounded-xl shadow border">
      <h2 class="text-sm font-semibold mb-3">Staff Leaderboard</h2>
      <canvas id="staffChart"></canvas>
    </div>

    <div class="bg-white p-4 rounded-xl shadow border">
      <h2 class="text-sm font-semibold mb-3">Product Usage</h2>
      <canvas id="productChart"></canvas>
    </div>

  </div>

  <!-- HEALTH SCORE MODAL -->
<div id="healthModal" class="hidden fixed inset-0 bg-black/40 flex items-center justify-center">

  <div class="bg-white w-full max-w-3xl rounded-2xl p-6 shadow-xl">

    <div class="flex justify-between items-center mb-4">
      <h2 class="text-lg font-bold text-indigo-700">
        🧠 Why did your score change?
      </h2>

      <button onclick="document.getElementById('healthModal').classList.add('hidden')">
        ✖
      </button>
    </div>

    <!-- ACTIVITY -->
    <div class="mb-4 p-4 border z-50 rounded-xl">
      <h3 class="font-semibold">📊 Activity Change</h3>
      <p class="text-sm text-gray-600">
        Current: <%= @health_breakdown[:activity][:current] %> |
        Previous: <%= @health_breakdown[:activity][:previous] %>
      </p>

      <p class="text-sm text-indigo-600">
        Change: <%= @health_breakdown[:activity][:change_pct].round(1) %>%
      </p>
    </div>

    <!-- STAFF -->
    <div class="mb-4 p-4 border rounded-xl">
      <h3 class="font-semibold">👤 Staff Impact</h3>

      <p class="text-sm text-gray-600">
        Top performer:
        <%= @health_breakdown[:staff][:overloaded]&.first %>
      </p>

      <p class="text-sm text-gray-500">
        Overloaded staff is driving most activity
      </p>
    </div>

    <!-- PRODUCT -->
    <div class="mb-4 p-4 border rounded-xl">
      <h3 class="font-semibold">📦 Product Dependency</h3>

      <p class="text-sm text-gray-600">
        Top product:
        <%= @health_breakdown[:product][:top]&.first %>
      </p>

      <p class="text-sm text-gray-500">
        Concentration:
        <%= (@health_breakdown[:product][:concentration] * 100).round(1) %>%
      </p>
    </div>

    <!-- RISK -->
    <div class="p-4 border rounded-xl bg-red-50">
      <h3 class="font-semibold text-red-700">⚠️ Risk Signals</h3>

      <p class="text-sm text-red-600">
        Low usage products: <%= @health_breakdown[:risk][:low_usage_count] %>
      </p>
    </div>

  </div>

</div>
</div>

<script>
document.addEventListener("turbo:load", function () {

  const staffLabels = <%= raw @staff_leaderboard.map { |s| s[:name] }.to_json %>;
  const staffData = <%= raw @staff_leaderboard.map { |s| s[:total] }.to_json %>;

  new Chart(document.getElementById("staffChart"), {
    type: "bar",
    data: {
      labels: staffLabels,
      datasets: [{
        data: staffData,
        backgroundColor: "#6366f1"
      }]
    },
    options: {
      indexAxis: "y",
      plugins: { legend: { display: false } }
    }
  });

  new Chart(document.getElementById("productChart"), {
    type: "doughnut",
    data: {
      labels: <%= raw @product_usage.keys.to_json %>,
      datasets: [{ data: <%= raw @product_usage.values.to_json %> }]
    }
  });

});

function dismissEarlyBanner() {
    const banner = document.getElementById("early-stage-banner");
    if (!banner) return;

    banner.style.transition = "all 0.25s ease";
    banner.style.opacity = "0";
    banner.style.transform = "translateY(-10px)";

    setTimeout(() => {
      banner.style.display = "none";
    }, 250);
  }
</script>