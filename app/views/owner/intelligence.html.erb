<div class="min-h-screen bg-gradient-to-br from-indigo-50 via-white to-indigo-100">

  <div class="max-w-7xl mx-auto px-4 md:px-6 py-6">

    <!-- ================= HEADER ================= -->
    <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-5 mb-6">

      <div class="flex items-start gap-4">

        <div class="w-14 h-14 rounded-3xl bg-indigo-600 flex items-center justify-center shadow-sm shrink-0">
          <%= icon('chart-line', class: 'w-7 h-7 text-white') %>
        </div>

        <div>
          <h1 class="text-2xl md:text-3xl font-bold tracking-tight text-gray-900">
            <%= t('stockflow_intelligence') %>
          </h1>
          <p class="text-sm text-gray-500 mt-1">
            AI-driven inventory insights, activity tracking and operational health
          </p>
        </div>

      </div>

      <div class="bg-white border border-indigo-100 rounded-2xl px-5 py-3 shadow-sm">

        <p class="text-xs text-gray-500 uppercase tracking-wide">
          <%= t('range_label') %>
        </p>

        <p class="text-sm font-semibold text-indigo-700 mt-1">
          <%= @range %>
        </p>

      </div>

    </div>

    <!-- ================= WARNING ================= -->
    <% if @show_early_stage_warning %>

      <div id="early-stage-banner" class="mb-6">

        <div class="bg-white border border-yellow-200 rounded-3xl p-5 shadow-sm">

          <div class="flex items-start justify-between gap-4">

            <div class="flex items-start gap-4">

              <div class="w-11 h-11 rounded-2xl bg-yellow-50 border border-yellow-200 flex items-center justify-center shrink-0">
                <%= icon('exclamation-circle', class: 'w-5 h-5 text-yellow-600') %>
              </div>

              <div>

                <h3 class="font-semibold text-gray-900">
                  <%= t('early_stage_data_warning') %>
                </h3>

                <p class="text-sm text-gray-500 mt-2 leading-relaxed">
                  <%= t('stockflow_learning_patterns') %>
                </p>

                <p class="text-sm text-yellow-700 font-medium mt-2">
                  <%= t('data_reliable_after_30_days') %>
                </p>

              </div>

            </div>

            <button onclick="dismissEarlyBanner()" class="text-gray-400 hover:text-gray-700 transition">
              <%= icon('x', class: 'w-5 h-5') %>
            </button>

          </div>

        </div>

      </div>

    <% end %>

    <!-- ================= HEALTH SCORE ================= -->
    <div
      class="bg-white rounded-3xl border border-gray-200 shadow-sm p-6 mb-6 cursor-pointer hover:shadow-md transition"
      onclick="document.getElementById('healthModal').classList.remove('hidden')"
    >

      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-6">

        <div>

          <p class="text-sm text-gray-500">
            <%= t('stockflow_health_score') %>
          </p>

          <div class="flex items-end gap-3 mt-3">

            <h2 class="text-5xl font-bold tracking-tight
              <%= @health_score >= 75 ? 'text-green-600' : @health_score >= 50 ? 'text-yellow-600' : 'text-red-600' %>">
              <%= @health_score %>
            </h2>

            <span class="text-gray-400 font-medium pb-1">/100</span>

          </div>

          <p class="text-sm text-gray-500 mt-3">
            <%= t('click_see_why_changed') %>
          </p>

        </div>

        <div class="flex items-center gap-4">

          <div class="hidden md:block w-px h-16 bg-gray-200"></div>

          <div>

            <div class="w-20 h-20 rounded-full border-[10px]
              <%= @health_score >= 75 ? 'border-green-100' : @health_score >= 50 ? 'border-yellow-100' : 'border-red-100' %>
              flex items-center justify-center">

              <div class="w-12 h-12 rounded-full
                <%= @health_score >= 75 ? 'bg-green-600' : @health_score >= 50 ? 'bg-yellow-500' : 'bg-red-600' %>
                flex items-center justify-center">

                <%= icon('sparkles', class: 'w-6 h-6 text-white') %>

              </div>

            </div>

          </div>

        </div>

      </div>

    </div>

    <!-- ================= KPI ================= -->
    <div class="grid grid-cols-2 xl:grid-cols-4 gap-4 mb-6">

      <!-- ACTIVITY -->
      <div class="bg-white rounded-3xl border border-gray-200 shadow-sm p-5">

        <div class="flex items-center justify-between mb-4">

          <div class="w-11 h-11 rounded-2xl bg-gray-100 border border-gray-200 flex items-center justify-center">
            <%= icon('activity', class: 'w-5 h-5 text-gray-700') %>
          </div>

          <span class="text-xs font-semibold px-2 py-1 rounded-full
            <%= @activity_change_pct >= 0 ? 'bg-green-50 text-green-700' : 'bg-red-50 text-red-700' %>">
            <%= @activity_change_pct.round(1) %>%
          </span>

        </div>

        <p class="text-sm text-gray-500">Activity</p>

        <h3 class="text-2xl font-bold text-gray-900 mt-2">
          <%= @total_activity %>
        </h3>

      </div>

      <!-- REQUESTS -->
      <div class="bg-white rounded-3xl border border-gray-200 shadow-sm p-5">

        <div class="flex items-center justify-between mb-4">

          <div class="w-11 h-11 rounded-2xl bg-gray-100 border border-gray-200 flex items-center justify-center">
            <%= icon('file', class: 'w-5 h-5 text-gray-700') %>
          </div>

          <span class="text-xs font-semibold px-2 py-1 rounded-full
            <%= @request_change_pct >= 0 ? 'bg-green-50 text-green-700' : 'bg-red-50 text-red-700' %>">
            <%= @request_change_pct.round(1) %>%
          </span>

        </div>

        <p class="text-sm text-gray-500">Requests</p>

        <h3 class="text-2xl font-bold text-gray-900 mt-2">
          <%= @request_count %>
        </h3>

      </div>

      <!-- STAFF -->
      <div class="bg-white rounded-3xl border border-gray-200 shadow-sm p-5">

        <div class="w-11 h-11 rounded-2xl bg-gray-100 border border-gray-200 flex items-center justify-center mb-4">
          <%= icon('user', class: 'w-5 h-5 text-gray-700') %>
        </div>

        <p class="text-sm text-gray-500">Top Staff</p>

        <h3 class="text-base font-semibold text-gray-900 mt-2 truncate">
          <%= @top_staff&.dig(:name) || "N/A" %>
        </h3>

      </div>

      <!-- PRODUCT -->
      <div class="bg-white rounded-3xl border border-gray-200 shadow-sm p-5">

        <div class="w-11 h-11 rounded-2xl bg-gray-100 border border-gray-200 flex items-center justify-center mb-4">
          <%= icon('box', class: 'w-5 h-5 text-gray-700') %>
        </div>

        <p class="text-sm text-gray-500">Top Product</p>

        <h3 class="text-base font-semibold text-gray-900 mt-2 truncate">
          <%= @top_product&.first || "N/A" %>
        </h3>

      </div>

    </div>

    <!-- ================= INSIGHTS ================= -->
    <% if @insights.any? %>

      <div class="grid md:grid-cols-2 xl:grid-cols-3 gap-4 mb-6">

        <% @insights.each do |insight| %>

          <div class="bg-white rounded-3xl border border-gray-200 shadow-sm p-5">

            <div class="flex items-start gap-3">

              <div class="w-10 h-10 rounded-2xl bg-gray-100 border border-gray-200 flex items-center justify-center shrink-0">

                <% if insight[:type] == 'positive' %>
                  <%= icon('check', class: 'w-5 h-5 text-green-600') %>
                <% elsif insight[:type] == 'danger' %>
                  <%= icon('alert-triangle', class: 'w-5 h-5 text-red-600') %>
                <% else %>
                  <%= icon('sparkles', class: 'w-5 h-5 text-yellow-600') %>
                <% end %>

              </div>

              <div>

                <p class="text-xs uppercase tracking-wide text-gray-400 font-semibold">
                  Insight
                </p>

                <p class="text-sm font-medium text-gray-800 mt-2 leading-relaxed">
                  <%= insight[:text] %>
                </p>

              </div>

            </div>

          </div>

        <% end %>

      </div>

    <% end %>

    <!-- ================= CHARTS ================= -->
    <div class="grid grid-cols-1 xl:grid-cols-2 gap-6">

      <div class="bg-white rounded-3xl border border-gray-200 shadow-sm overflow-hidden">

        <div class="px-6 py-5 border-b border-gray-100">
          <h2 class="font-semibold text-gray-900">Staff Leaderboard</h2>
          <p class="text-sm text-gray-500 mt-1">Most active team members</p>
        </div>

        <div class="p-6 h-[350px]">
          <canvas id="staffChart"></canvas>
        </div>

      </div>

      <div class="bg-white rounded-3xl border border-gray-200 shadow-sm overflow-hidden">

        <div class="px-6 py-5 border-b border-gray-100">
          <h2 class="font-semibold text-gray-900">Product Usage</h2>
          <p class="text-sm text-gray-500 mt-1">Inventory movement distribution</p>
        </div>

        <div class="p-6 h-[350px]">
          <canvas id="productChart"></canvas>
        </div>

      </div>

    </div>

  </div>

</div>

<script>
document.addEventListener("turbo:load", function () {

  if (window.staffChartInstance) window.staffChartInstance.destroy();
  if (window.productChartInstance) window.productChartInstance.destroy();

  const staffCtx = document.getElementById("staffChart");

  if (staffCtx) {
    window.staffChartInstance = new Chart(staffCtx, {
      type: "bar",
      data: {
        labels: <%= raw @staff_leaderboard.map { |s| s[:name] }.to_json %>,
        datasets: [{
          data: <%= raw @staff_leaderboard.map { |s| s[:total] }.to_json %>,
          backgroundColor: "#374151"
        }]
      },
      options: { responsive: true, maintainAspectRatio: false }
    });
  }

  const productCtx = document.getElementById("productChart");

  if (productCtx) {
    window.productChartInstance = new Chart(productCtx, {
      type: "doughnut",
      data: {
        labels: <%= raw @product_usage.keys.to_json %>,
        datasets: [{
          data: <%= raw @product_usage.values.to_json %>,
          backgroundColor: ["#16a34a", "#eab308", "#dc2626", "#6b7280", "#9ca3af"]
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        cutout: "70%"
      }
    });
  }

});

function dismissEarlyBanner() {
  const banner = document.getElementById("early-stage-banner");
  if (!banner) return;

  banner.style.opacity = "0";
  setTimeout(() => banner.style.display = "none", 250);
}
</script>