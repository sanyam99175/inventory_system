<div class="min-h-screen bg-gradient-to-br from-indigo-50 via-white to-indigo-100">

  <div class="max-w-7xl mx-auto px-4 md:px-6 py-6">

    <!-- ================= HEADER ================= -->
    <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-5 mb-6">

      <div class="flex items-start gap-4">

        <div class="w-14 h-14 rounded-3xl bg-gradient-to-br from-indigo-600 to-indigo-700 flex items-center justify-center shadow-lg shadow-indigo-200 shrink-0">
          <%= icon('chart-line', class: 'w-7 h-7 text-white') %>
        </div>

        <div>
          <h1 class="text-2xl md:text-3xl font-bold tracking-tight text-gray-900">
            <%= t('stockflow_intelligence') %>
          </h1>

          <p class="text-sm text-gray-500 mt-1">
            AI-driven inventory insights, activity tracking and operational health
          </p>
        </div>

      </div>

      <div class="bg-white/90 backdrop-blur border border-indigo-100 rounded-3xl px-5 py-4 shadow-sm">

        <p class="text-xs text-indigo-400 uppercase tracking-[0.2em] font-semibold">
          <%= t('range_label') %>
        </p>

        <p class="text-sm font-bold text-indigo-700 mt-1">
          <%= @range %>
        </p>

      </div>

    </div>

    <!-- ================= WARNING ================= -->
    <% if @show_early_stage_warning %>

      <div id="early-stage-banner" class="mb-6">

        <div class="bg-gradient-to-r from-amber-50 to-white border border-amber-200 rounded-[28px] p-5 shadow-sm">

          <div class="flex items-start justify-between gap-4">

            <div class="flex items-start gap-4">

              <div class="w-11 h-11 rounded-2xl bg-amber-100 border border-amber-200 flex items-center justify-center shrink-0">
                <%= icon('exclamation-circle', class: 'w-5 h-5 text-amber-600') %>
              </div>

              <div>

                <h3 class="font-semibold text-gray-900">
                  <%= t('early_stage_data_warning') %>
                </h3>

                <p class="text-sm text-gray-600 mt-2 leading-relaxed">
                  <%= t('stockflow_learning_patterns') %>
                </p>

                <p class="text-sm text-amber-700 font-semibold mt-2">
                  <%= t('data_reliable_after_30_days') %>
                </p>

              </div>

            </div>

            <button
              onclick="dismissEarlyBanner()"
              class="text-gray-400 hover:text-gray-700 transition"
            >
              <%= icon('x', class: 'w-5 h-5') %>
            </button>

          </div>

        </div>

      </div>

    <% end %>

    <!-- ================= HEALTH SCORE ================= -->
    <div
      class="
        relative
        overflow-hidden
        rounded-[32px]
        border
        shadow-sm
        p-6
        mb-6
        cursor-pointer
        hover:shadow-xl
        transition-all
        duration-300
        lg:cursor-default
        <%= @health_score >= 75 ?
          'bg-gradient-to-br from-emerald-50 via-white to-indigo-50 border-emerald-100 hover:border-emerald-200' :
          @health_score >= 50 ?
          'bg-gradient-to-br from-yellow-50 via-white to-indigo-50 border-yellow-100 hover:border-yellow-200' :
          'bg-gradient-to-br from-red-50 via-white to-indigo-50 border-red-100 hover:border-red-200' %>
      "
      data-health-modal-trigger
    >

      <!-- GLOW -->
      <div class="
        absolute
        -top-24
        -right-24
        w-64
        h-64
        rounded-full
        blur-3xl
        opacity-20
        <%= @health_score >= 75 ?
          'bg-emerald-300' :
          @health_score >= 50 ?
          'bg-yellow-300' :
          'bg-red-300' %>
      "></div>

      <div class="relative flex flex-col md:flex-row md:items-center md:justify-between gap-6">

        <div>

          <p class="text-sm font-medium text-gray-500">
            <%= t('stockflow_health_score') %>
          </p>

          <div class="flex items-end gap-3 mt-3">

            <h2 class="
              text-5xl
              font-black
              tracking-tight
              <%= @health_score >= 75 ?
                'text-emerald-600' :
                @health_score >= 50 ?
                'text-yellow-600' :
                'text-red-600' %>
            ">
              <%= @health_score %>
            </h2>

            <span class="text-gray-400 font-medium pb-1">
              /100
            </span>

          </div>

          <p class="text-sm text-gray-500 mt-3">
            <%= t('click_see_why_changed') %>
          </p>

        </div>

        <div class="flex items-center gap-4">

          <div class="hidden md:block w-px h-16 bg-indigo-100"></div>

          <div>

            <div class="
              w-24
              h-24
              rounded-full
              border-[12px]
              flex items-center justify-center
              shadow-inner
              <%= @health_score >= 75 ?
                'border-emerald-100 bg-white/70' :
                @health_score >= 50 ?
                'border-yellow-100 bg-white/70' :
                'border-red-100 bg-white/70' %>
            ">

              <div class="
                w-14
                h-14
                rounded-full
                flex items-center justify-center
                shadow-lg
                <%= @health_score >= 75 ?
                  'bg-gradient-to-br from-emerald-500 to-emerald-600 shadow-emerald-200' :
                  @health_score >= 50 ?
                  'bg-gradient-to-br from-yellow-400 to-yellow-500 shadow-yellow-200' :
                  'bg-gradient-to-br from-red-500 to-red-600 shadow-red-200' %>
              ">

                <%= icon('sparkles', class: 'w-6 h-6 text-white') %>

              </div>

            </div>

          </div>

        </div>

      </div>

    </div>

    <!-- ================= KPI ================= -->
    <div class="grid grid-cols-2 xl:grid-cols-4 gap-4 mb-6">

      <!-- ACTIVITY -->
      <div class="bg-gradient-to-br from-white via-white to-indigo-50 rounded-[28px] border border-indigo-100 shadow-sm hover:shadow-lg hover:-translate-y-1 transition-all duration-300 p-5">

        <div class="flex items-center justify-between mb-4">

          <div class="w-11 h-11 rounded-2xl bg-indigo-50 border border-indigo-100 flex items-center justify-center">
            <%= icon('line-chart', class: 'w-5 h-5 text-indigo-700') %>
          </div>

          <span class="text-xs font-semibold px-2.5 py-1 rounded-full
            <%= @activity_change_pct >= 0 ?
              'bg-emerald-50 text-emerald-700 border border-emerald-100' :
              'bg-red-50 text-red-700 border border-red-100' %>">

            <%= @activity_change_pct.round(1) %>%

          </span>

        </div>

        <p class="text-sm text-gray-500">
          Activity
        </p>

        <h3 class="text-3xl font-black text-gray-900 mt-2">
          <%= @total_activity %>
        </h3>

      </div>

      <!-- REQUESTS -->
      <div class="bg-gradient-to-br from-white via-white to-indigo-50 rounded-[28px] border border-indigo-100 shadow-sm hover:shadow-lg hover:-translate-y-1 transition-all duration-300 p-5">

        <div class="flex items-center justify-between mb-4">

          <div class="w-11 h-11 rounded-2xl bg-indigo-50 border border-indigo-100 flex items-center justify-center">
            <%= icon('file', class: 'w-5 h-5 text-indigo-700') %>
          </div>

          <span class="text-xs font-semibold px-2.5 py-1 rounded-full
            <%= @request_change_pct >= 0 ?
              'bg-emerald-50 text-emerald-700 border border-emerald-100' :
              'bg-red-50 text-red-700 border border-red-100' %>">

            <%= @request_change_pct.round(1) %>%

          </span>

        </div>

        <p class="text-sm text-gray-500">
          Requests
        </p>

        <h3 class="text-3xl font-black text-gray-900 mt-2">
          <%= @request_count %>
        </h3>

      </div>

      <!-- STAFF -->
      <div class="bg-gradient-to-br from-white via-white to-indigo-50 rounded-[28px] border border-indigo-100 shadow-sm hover:shadow-lg hover:-translate-y-1 transition-all duration-300 p-5">

        <div class="w-11 h-11 rounded-2xl bg-indigo-50 border border-indigo-100 flex items-center justify-center mb-4">
          <%= icon('user', class: 'w-5 h-5 text-indigo-700') %>
        </div>

        <p class="text-sm text-gray-500">
          Top Staff
        </p>

        <h3 class="text-sm font-bold text-gray-900 mt-2 truncate">
          <%= @top_staff&.dig(:name) || "N/A" %>
        </h3>

      </div>

      <!-- PRODUCT -->
      <div class="bg-gradient-to-br from-white via-white to-indigo-50 rounded-[28px] border border-indigo-100 shadow-sm hover:shadow-lg hover:-translate-y-1 transition-all duration-300 p-5">

        <div class="w-11 h-11 rounded-2xl bg-indigo-50 border border-indigo-100 flex items-center justify-center mb-4">
          <%= icon('box', class: 'w-5 h-5 text-indigo-700') %>
        </div>

        <p class="text-sm text-gray-500">
          Top Product
        </p>

        <h3 class="text-sm font-bold text-gray-900 mt-2 truncate">
          <%= @top_product&.first || "N/A" %>
        </h3>

      </div>

    </div>

    <!-- ================= CHARTS ================= -->
    <div class="grid grid-cols-1 xl:grid-cols-2 gap-6">

      <!-- STAFF CHART -->
      <div class="bg-gradient-to-br from-white via-white to-indigo-50 rounded-[32px] border border-indigo-100 shadow-sm overflow-hidden">

        <div class="px-6 py-5 border-b border-indigo-100 bg-white/70 backdrop-blur">

          <h2 class="font-bold text-gray-900">
            Staff Leaderboard
          </h2>

          <p class="text-sm text-gray-500 mt-1">
            Most active team members
          </p>

        </div>

        <div class="p-6 h-[350px]">
          <canvas id="staffChart"></canvas>
        </div>

      </div>

      <!-- PRODUCT CHART -->
      <div class="bg-gradient-to-br from-white via-white to-indigo-50 rounded-[32px] border border-indigo-100 shadow-sm overflow-hidden">

        <div class="px-6 py-5 border-b border-indigo-100 bg-white/70 backdrop-blur">

          <h2 class="font-bold text-gray-900">
            Product Usage
          </h2>

          <p class="text-sm text-gray-500 mt-1">
            Inventory movement distribution
          </p>

        </div>

        <div class="p-6 h-[350px]">
          <canvas id="productChart"></canvas>
        </div>

      </div>

    </div>

  </div>

</div>

<!-- ================= HEALTH SCORE MODAL ================= -->
<div
  id="healthModal"
  class="fixed inset-0 z-[99999] hidden"
>

  <!-- BACKDROP -->
  <div
    onclick="closeHealthModal()"
    class="fixed inset-0 bg-black/40 backdrop-blur-md"
    style="
      -webkit-backdrop-filter: blur(10px);
      backdrop-filter: blur(10px);
    "
  ></div>

  <!-- SHEET -->
<!-- SHEET / MODAL -->
<div class="
  fixed
  bottom-0
  inset-x-0
  bg-white
  rounded-t-[32px]
  shadow-2xl
  animate-slide-up
  z-[100000]
  max-h-[90dvh]
  overflow-y-auto
  overscroll-contain
  touch-pan-y

  lg:top-1/2
  lg:left-1/2
  lg:right-auto
  lg:bottom-auto
  lg:w-full
  lg:max-w-2xl
  lg:max-h-[85vh]
  lg:-translate-x-1/2
  lg:-translate-y-1/2
  lg:rounded-[32px]
  lg:animate-none
">

    <div class="p-6 pb-8">

      <!-- HANDLE -->
      <div class="w-14 h-1.5 rounded-full bg-gray-200 mx-auto mb-6 lg:hidden"></div>

      <!-- HEADER -->
      <div class="mb-6">

        <h2 class="text-2xl font-black text-gray-900">
          Stock Health Score
        </h2>

        <p class="text-sm text-gray-500 mt-2 leading-relaxed">
          AI evaluation of your inventory health and operational activity.
        </p>

      </div>

      <!-- SCORE -->
      <div class="
        rounded-[28px]
        p-6
        border
        mb-5
        bg-gradient-to-br
        <%= @health_score >= 75 ?
          'from-emerald-50 to-white border-emerald-100' :
          @health_score >= 50 ?
          'from-yellow-50 to-white border-yellow-100' :
          'from-red-50 to-white border-red-100' %>
      ">

        <p class="text-sm font-medium text-gray-500">
          Current Score
        </p>

        <div class="flex items-end gap-2 mt-3">

          <h3 class="
            text-5xl
            font-black
            <%= @health_score >= 75 ?
              'text-emerald-600' :
              @health_score >= 50 ?
              'text-yellow-600' :
              'text-red-600' %>
          ">
            <%= @health_score %>
          </h3>

          <span class="text-gray-400 text-lg pb-1">
            /100
          </span>

        </div>

      </div>

      <!-- DETAILS -->
      <div class="space-y-4">

        <div class="bg-gradient-to-r from-indigo-50 to-white rounded-2xl border border-indigo-100 p-4">

          <p class="text-xs uppercase tracking-wide text-indigo-400 font-bold">
            Activity Trend
          </p>

          <p class="text-sm font-bold text-gray-900 mt-2">
            <%= @activity_change_pct.round(1) %>% change
          </p>

        </div>

        <div class="bg-gradient-to-r from-indigo-50 to-white rounded-2xl border border-indigo-100 p-4">

          <p class="text-xs uppercase tracking-wide text-indigo-400 font-bold">
            Requests Trend
          </p>

          <p class="text-sm font-bold text-gray-900 mt-2">
            <%= @request_change_pct.round(1) %>% change
          </p>

        </div>

        <div class="bg-gradient-to-r from-indigo-50 to-white rounded-2xl border border-indigo-100 p-4">

          <p class="text-xs uppercase tracking-wide text-indigo-400 font-bold">
            Top Staff
          </p>

          <p class="text-sm font-bold text-gray-900 mt-2">
            <%= @top_staff&.dig(:name) || "N/A" %>
          </p>

        </div>

        <div class="bg-gradient-to-r from-indigo-50 to-white rounded-2xl border border-indigo-100 p-4">

          <p class="text-xs uppercase tracking-wide text-indigo-400 font-bold">
            Top Product
          </p>

          <p class="text-sm font-bold text-gray-900 mt-2">
            <%= @top_product&.first || "N/A" %>
          </p>

        </div>

      </div>

      <!-- CLOSE -->
      <button
        type="button"
        onclick="closeHealthModal()"
        class="
          w-full
          mt-6
          bg-gradient-to-r
          from-indigo-600
          to-indigo-700
          hover:from-indigo-700
          hover:to-indigo-800
          text-white
          py-4
          rounded-2xl
          font-semibold
          transition
          shadow-lg
          shadow-indigo-200
        "
      >
        Close
      </button>

    </div>

  </div>

</div>

<style>
  @keyframes slideUp {
    from {
      transform: translateY(100%);
      opacity: 0.96;
    }
    to {
      transform: translateY(0);
      opacity: 1;
    }
  }

  .animate-slide-up {
    animation: slideUp 0.24s ease-out;
  }

  @media (min-width: 1024px) {

    @keyframes modalFade {
      from {
        opacity: 0;
        transform: translate(-50%, -48%);
      }
      to {
        opacity: 1;
        transform: translate(-50%, -50%);
      }
    }

    .animate-slide-up {
      animation: modalFade 0.18s ease-out;
    }

  }
</style>

<script>
document.addEventListener("turbo:load", function () {

  if (window.staffChartInstance) window.staffChartInstance.destroy();
  if (window.productChartInstance) window.productChartInstance.destroy();

  const staffCtx = document.getElementById("staffChart");

  if (staffCtx) {

    window.staffChartInstance = new Chart(staffCtx, {
      type: "bar",
      data: {
        labels: <%= raw @staff_leaderboard.map { |s| s[:name] }.to_json %>,
        datasets: [{
          data: <%= raw @staff_leaderboard.map { |s| s[:total] }.to_json %>,
          backgroundColor: "#4f46e5",
          borderRadius: 12,
          borderSkipped: false
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: { display: false }
        },
        scales: {
          x: {
            grid: { display: false },
            ticks: { color: "#6b7280" }
          },
          y: {
            grid: { color: "#eef2ff" },
            ticks: { color: "#6b7280" }
          }
        }
      }
    });

  }

  const productCtx = document.getElementById("productChart");

  if (productCtx) {

    window.productChartInstance = new Chart(productCtx, {
      type: "doughnut",
      data: {
        labels: <%= raw @product_usage.keys.to_json %>,
        datasets: [{
          data: <%= raw @product_usage.values.to_json %>,
          backgroundColor: [
            "#4f46e5",
            "#818cf8",
            "#6366f1",
            "#a5b4fc",
            "#c7d2fe"
          ],
          borderWidth: 0
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        cutout: "72%",
        plugins: {
          legend: {
            position: "bottom",
            labels: {
              usePointStyle: true,
              padding: 20
            }
          }
        }
      }
    });

  }

  const trigger = document.querySelector("[data-health-modal-trigger]");

  if (trigger) {
    trigger.addEventListener("click", openHealthModal);
  }

});

function dismissEarlyBanner() {

  const banner = document.getElementById("early-stage-banner");

  if (!banner) return;

  banner.style.transition = "all 0.25s ease";
  banner.style.opacity = "0";
  banner.style.transform = "translateY(-8px)";

  setTimeout(() => {
    banner.style.display = "none";
  }, 250);

}

function closeHealthModal() {

  const modal = document.getElementById("healthModal");

  if (!modal) return;

  modal.classList.add("hidden");

  document.body.classList.remove("overflow-hidden");
  document.documentElement.classList.remove("overflow-hidden");

  document.body.style.position = "";
  document.body.style.width = "";
  document.body.style.top = "";

  const scrollY = document.body.dataset.scrollY;

  if (scrollY) {
    window.scrollTo(0, parseInt(scrollY || "0") * -1);
  }

}

function openHealthModal() {

  const modal = document.getElementById("healthModal");

  if (!modal) return;

  modal.classList.remove("hidden");

  // MOBILE ONLY scroll lock
  if (window.innerWidth < 1024) {

    const scrollY = window.scrollY;

    document.body.dataset.scrollY = -scrollY;

    document.body.classList.add("overflow-hidden");
    document.documentElement.classList.add("overflow-hidden");

    document.body.style.position = "fixed";
    document.body.style.width = "100%";
    document.body.style.top = `-${scrollY}px`;

  }

}

document.addEventListener("turbo:load", () => {

  const trigger = document.querySelector("[data-health-modal-trigger]");

  if (trigger) {
    trigger.addEventListener("click", openHealthModal);
  }

});
</script>