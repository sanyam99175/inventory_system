<div class="max-w-4xl mx-auto p-6">

  <!-- HEADER -->
  <div class="mb-6">
    <h1 class="text-2xl font-bold text-indigo-700 flex items-center gap-2">
      🚨 <%= t('stock_alerts') %>
    </h1>
    <p class="text-gray-500 mt-1">
      <%= t('items_need_attention') %>
    </p>
  </div>

  <% if @products.any? %>

    <div class="space-y-3">

      <% @products.each do |product| %>

        <% stock = product.stock_count.to_i %>
        <% limit = product.alert_limit.to_i %>

        <% ratio = limit > 0 ? (stock.to_f / limit) : 1 %>

        <% color =
          if stock <= limit * 0.5
            "bg-red-500"
          elsif stock <= limit
            "bg-yellow-500"
          else
            "bg-green-500"
          end %>

        <div class="bg-white border rounded-xl p-4 shadow-sm">

          <!-- TOP ROW -->
          <div class="flex justify-between items-center mb-2">

            <div>
              <p class="font-semibold text-gray-800">
                <%= product.name %>
              </p>

              <p class="text-xs text-gray-500">
                <%= product.product_type&.name %> • Godown <%= product.godown_number %>
              </p>
            </div>

            <div class="text-right">
              <p class="text-xs text-gray-400">Stock</p>
              <p class="text-lg font-bold <%= stock <= limit ? 'text-red-600' : 'text-gray-800' %>">
                <%= stock %>
              </p>
            </div>

          </div>

          <!-- PROGRESS BAR -->
          <div class="w-full bg-gray-100 rounded-full h-2 overflow-hidden">
            <div class="<%= color %> h-2"
                 style="width: <%= [(ratio * 100), 100].min %>%">
            </div>
          </div>

          <!-- FOOTER -->
          <div class="flex justify-between text-xs text-gray-500 mt-2">

            <span>0</span>
            <span>Alert: <%= limit %></span>

            <% if current_user.has_permission?("products", "view") %>
              <%= link_to "View", product_path(product),
                  class: "text-indigo-600 hover:underline" %>
            <% end %>

          </div>

        </div>

      <% end %>

    </div>

  <% else %>

    <div class="text-center py-10 text-gray-500">
      No low stock items 🎉
    </div>

  <% end %>

</div>