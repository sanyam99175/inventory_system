<div style="max-width: 900px; margin: auto;">

  <!-- HEADER -->
  <div style="margin-bottom: 20px;">
    <h1 class="text-2xl font-bold text-blue-800">🚨 <%= t('stock_alerts') %></h1>
    <p style="color: gray;"><%= t('items_need_attention') %></p>
  </div>

  <br><br>

  <% if @products.any? %>

    <div style="display: flex; flex-direction: column; gap: 15px;">

      <% @products.each do |product| %>

        <div style="
          background: #fff5f5;
          border-left: 6px solid #e74c3c;
          padding: 20px;
          border-radius: 10px;
          box-shadow: 0 2px 6px rgba(0,0,0,0.05);
        ">

          <!-- TOP -->
          <div style="display: flex; justify-content: space-between; align-items: center;">

            <h3 style="margin: 0;">
              🚨 <%= product.name %>
            </h3>

            <span style="
              background: #e74c3c;
              color: white;
              padding: 5px 10px;
              border-radius: 6px;
              font-size: 12px;
            ">
              <%= t('low_stock') %>
            </span>

          </div>

          <!-- DETAILS -->
          <div style="margin-top: 10px; color: #555;">

            <p>
              <%= t('current_stock') %>:
              <strong style="color: red;"><%= product.stock_count %></strong>
            </p>

            <p>
              <%= t('alert_limit') %>:
              <strong><%= product.alert_limit %></strong>
            </p>

            <p>
              <%= t('type') %>: <%= product.product_type.name %> |
              <%= t('godown') %>: <%= product.godown_number %>
            </p>

          </div>

          <!-- ACTION -->
          <% if current_user.has_permission?("products", "view") %>
            <div style="margin-top: 10px;">
              <%= link_to t('view_product') + " →", product_path(product),
                  style: "
                    text-decoration: none;
                    color: #2980b9;
                    font-weight: bold;
                  " %>
            </div>
          <% end %>

        </div>

      <% end %>

    </div>

  <% else %>

    <!-- NO ALERTS -->
    <div style="
      background: #eafaf1;
      padding: 25px;
      border-radius: 10px;
      text-align: center;
    ">

      <h3 style="color: #27ae60;"><%= t('all_good') %></h3>
      <p><%= t('no_low_stock_items') %></p>

    </div>

  <% end %>

</div>