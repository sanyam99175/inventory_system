<div class="min-h-screen bg-gradient-to-br from-indigo-50 via-white to-slate-100">

  <div class="max-w-5xl mx-auto px-4 md:px-6 py-6">

    <!-- ================= PAGE HEADER ================= -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-5 mb-6">

      <!-- LEFT -->
      <div class="flex items-start gap-4">

        <div class="w-12 h-12 rounded-2xl bg-amber-500 flex items-center justify-center shadow-sm shrink-0">
          <%= icon('exclamation-triangle', class: 'w-6 h-6 text-white') %>
        </div>

        <div>

          <h1 class="text-2xl md:text-3xl font-bold tracking-tight text-gray-900">
            <%= t('stock_alerts') %>
          </h1>

          <p class="text-sm text-gray-500 mt-1">
            <%= t('items_need_attention') %>
          </p>

        </div>

      </div>

      <!-- RIGHT -->
      <div class="flex items-center gap-3">

        <div class="bg-white border border-slate-200 rounded-2xl px-4 py-3 shadow-sm">

          <p class="text-xs text-gray-500">
            Total Alerts
          </p>

          <p class="text-lg font-bold text-amber-600">
            <%= @products.count %>
          </p>

        </div>

      </div>

    </div>

    <!-- ================= ALERT LIST ================= -->
    <% if @products.any? %>

      <div class="space-y-4">

        <% @products.each do |product| %>

          <% stock = product.stock_count.to_i %>
          <% limit = product.alert_limit.to_i %>

          <% ratio = limit > 0 ? (stock.to_f / limit) : 1 %>

          <% bar_class =
            if stock <= limit * 0.5
              "bg-red-500"
            elsif stock <= limit
              "bg-amber-500"
            else
              "bg-emerald-500"
            end %>

          <% badge_class =
            if stock <= limit * 0.5
              "bg-red-100 text-red-700 border-red-200"
            elsif stock <= limit
              "bg-amber-100 text-amber-700 border-amber-200"
            else
              "bg-emerald-100 text-emerald-700 border-emerald-200"
            end %>

          <div class="bg-white/90 backdrop-blur rounded-3xl border border-slate-200 shadow-sm overflow-hidden hover:shadow-md transition">

            <div class="p-5 md:p-6">

              <!-- TOP -->
              <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-5">

                <!-- LEFT -->
                <div class="flex items-start gap-4 min-w-0">

                  <!-- ICON -->
                  <div class="w-12 h-12 rounded-2xl
                    <%= stock <= limit ? 'bg-amber-50 border-amber-100' : 'bg-emerald-50 border-emerald-100' %>
                    border flex items-center justify-center shrink-0">

                    <%= icon(
                      stock <= limit ? 'exclamation-circle' : 'check-circle',
                      class: "w-5 h-5 #{stock <= limit ? 'text-amber-600' : 'text-emerald-600'}"
                    ) %>

                  </div>

                  <!-- INFO -->
                  <div class="min-w-0">

                    <div class="flex items-center gap-2 flex-wrap">

                      <h2 class="font-semibold text-gray-900 text-base md:text-lg truncate">
                        <%= product.name %>
                      </h2>

                      <% if stock <= limit * 0.5 %>

                        <span class="bg-red-100 text-red-700 text-xs px-2 py-1 rounded-full font-medium border border-red-200">
                          Critical
                        </span>

                      <% elsif stock <= limit %>

                        <span class="bg-amber-100 text-amber-700 text-xs px-2 py-1 rounded-full font-medium border border-amber-200">
                          Low Stock
                        </span>

                      <% else %>

                        <span class="bg-emerald-100 text-emerald-700 text-xs px-2 py-1 rounded-full font-medium border border-emerald-200">
                          Healthy
                        </span>

                      <% end %>

                    </div>

                    <div class="flex flex-wrap items-center gap-2 mt-2 text-sm text-gray-500">

                      <% if product.product_type.present? %>

                        <span class="bg-slate-100 text-slate-700 px-2.5 py-1 rounded-full border border-slate-200 text-xs font-medium">
                          <%= product.product_type.name %>
                        </span>

                      <% end %>

                      <span>
                        Godown <%= product.godown_number || "N/A" %>
                      </span>

                    </div>

                  </div>

                </div>

                <!-- RIGHT -->
                <div class="flex md:flex-col md:items-end items-center justify-between gap-3">

                  <div class="text-left md:text-right">

                    <p class="text-xs uppercase tracking-wide text-gray-400">
                      Current Stock
                    </p>

                    <div class="flex items-end gap-1 mt-1">

                      <span class="text-3xl font-bold text-gray-900">
                        <%= stock %>
                      </span>

                      <span class="text-sm text-gray-400 mb-1">
                        units
                      </span>

                    </div>

                  </div>

                  <% if current_user.has_permission?("products", "view") %>

                    <%= link_to product_path(product),
                        class: "bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2 rounded-2xl text-sm font-medium transition whitespace-nowrap shadow-sm" do %>

                      View Product

                    <% end %>

                  <% end %>

                </div>

              </div>

              <!-- STOCK BAR -->
              <div class="mt-5">

                <div class="flex items-center justify-between text-xs text-gray-500 mb-2">

                  <span>
                    Empty
                  </span>

                  <span class="
                    font-medium
                    <%= stock <= limit ? 'text-amber-600' : 'text-emerald-600' %>
                  ">
                    Alert Limit: <%= limit %>
                  </span>

                </div>

                <div class="w-full bg-slate-100 rounded-full h-3 overflow-hidden border border-slate-200">

                  <div
                    class="<%= bar_class %> h-3 rounded-full transition-all duration-500"
                    style="width: <%= [[(ratio * 100), 8].max, 100].min %>%">
                  </div>

                </div>

              </div>

              <!-- FOOTER -->
              <div class="mt-5 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">

                <div class="flex flex-wrap gap-2">

                  <div class="bg-slate-50 border border-slate-200 rounded-2xl px-3 py-2">

                    <p class="text-xs text-gray-500">
                      Daily Usage
                    </p>

                    <p class="text-sm font-semibold text-gray-900">
                      <%= product.daily_usage_rate.round(2) %>/day
                    </p>

                  </div>

                  <div class="bg-slate-50 border border-slate-200 rounded-2xl px-3 py-2">

                    <p class="text-xs text-gray-500">
                      Estimated Remaining
                    </p>

                    <p class="text-sm font-semibold
                      <%= product.days_remaining <= 7 ? 'text-red-600' : 'text-gray-900' %>">
                      <%= product.days_remaining %> days
                    </p>

                  </div>

                </div>

                <div class="text-sm text-gray-500">

                  Recommended Stock:
                  <span class="font-semibold text-indigo-700">
                    <%= product.recommended_stock %>
                  </span>

                </div>

              </div>

            </div>

          </div>

        <% end %>

      </div>

    <% else %>

      <!-- ================= EMPTY STATE ================= -->
      <div class="bg-white/90 backdrop-blur rounded-3xl border border-emerald-100 shadow-sm py-20 px-6 text-center">

        <div class="w-20 h-20 rounded-full bg-emerald-50 border border-emerald-100 flex items-center justify-center mx-auto mb-5">

          <%= icon('check-circle', class: 'w-8 h-8 text-emerald-600') %>

        </div>

        <h3 class="text-xl font-semibold text-gray-900">
          No low stock items
        </h3>

        <p class="text-sm text-gray-500 mt-2">
          Inventory levels look healthy right now.
        </p>

      </div>

    <% end %>

  </div>

</div>