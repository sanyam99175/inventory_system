<div class="min-h-screen bg-gradient-to-br from-indigo-50 via-white to-slate-100">

  <div class="max-w-5xl mx-auto px-4 md:px-6 py-6">

    <!-- ================= PAGE HEADER ================= -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-5 mb-6">

      <div class="flex items-start gap-4">

        <div class="w-12 h-12 rounded-2xl bg-amber-500 flex items-center justify-center shadow-sm shrink-0">
          <%= icon('exclamation-triangle', class: 'w-6 h-6 text-white') %>
        </div>

        <div>

          <h1 class="text-2xl md:text-3xl font-bold tracking-tight text-gray-900">
            <%= t('stock_alerts') %>
          </h1>

          <p class="text-sm text-gray-500 mt-1">
            <%= t('items_need_attention') %>
          </p>

        </div>

      </div>

      <div class="flex items-center gap-3">

        <div class="bg-white border border-slate-200 rounded-2xl px-4 py-3 shadow-sm">

          <p class="text-xs text-gray-500">Total Alerts</p>

          <p class="text-lg font-bold text-amber-600">
            <%= @products.count %>
          </p>

        </div>

      </div>

    </div>

    <% if @products.any? %>

      <!-- ================= MOBILE VIEW ================= -->
      <div class="md:hidden space-y-3">

        <% @products.each do |product| %>

          <% stock = product.stock_count.to_i %>
          <% limit = product.alert_limit.to_i %>
          <% modal_id = "product_modal_#{product.id}" %>

          <% status_class =
            if stock <= limit * 0.5
              "bg-red-100 text-red-700 border-red-200"
            elsif stock <= limit
              "bg-amber-100 text-amber-700 border-amber-200"
            else
              "bg-emerald-100 text-emerald-700 border-emerald-200"
            end %>

          <% status_text =
            if stock <= limit * 0.5
              "Critical"
            elsif stock <= limit
              "Low Stock"
            else
              "Healthy"
            end %>

          <div
            onclick="document.getElementById('<%= modal_id %>').style.display='flex'"
            class="bg-white border border-slate-200 rounded-3xl p-4 shadow-sm active:scale-[0.98] transition cursor-pointer">

            <div class="flex items-center justify-between gap-3">

              <div class="min-w-0 flex-1">

                <div class="flex items-center gap-2 mb-2 flex-wrap">

                  <h2 class="font-semibold text-gray-900 truncate text-sm">
                    <%= product.name %>
                  </h2>

                  <span class="text-[10px] px-2 py-1 rounded-full border font-medium <%= status_class %>">
                    <%= status_text %>
                  </span>

                </div>

                <div class="flex items-center gap-4 text-xs text-gray-500">

                  <span>
                    Stock:
                    <span class="font-semibold text-gray-800"><%= stock %></span>
                  </span>

                  <span><%= product.days_remaining %> days left</span>

                </div>

              </div>

              <div class="text-indigo-500 text-xl font-bold">›</div>

            </div>
          </div>

          <!-- ================= BOTTOM SHEET ================= -->
          <div id="<%= modal_id %>" style="display:none;" class="fixed inset-0 z-50 bg-black/40 backdrop-blur-sm items-end">

            <div class="absolute inset-0" onclick="document.getElementById('<%= modal_id %>').style.display='none'"></div>

            <div class="relative w-full bg-white rounded-t-[32px] p-5 max-h-[85vh] overflow-y-auto animate-slideUp">

              <div class="w-14 h-1.5 bg-slate-300 rounded-full mx-auto mb-5"></div>

              <h2 class="text-xl font-bold text-gray-900"><%= product.name %></h2>

              <div class="mt-4 text-sm text-gray-500">
                <%= product.product_type&.name %>
              </div>

              <div class="mt-5">
                <%= link_to product_path(product),
                    class: "w-full bg-indigo-600 text-white py-4 rounded-2xl font-semibold text-center block" do %>
                  View Product
                <% end %>
              </div>

            </div>

          </div>

        <% end %>

      </div>

      <!-- ================= DESKTOP VIEW ================= -->
      <div class="hidden md:block space-y-4">

        <% @products.each do |product| %>

          <% last_purchase_item = product.last_purchase_item %>
          <% supplier = product.suggested_supplier %>

          <% stock = product.stock_count.to_i %>
          <% limit = product.alert_limit.to_i %>

          <% ratio = limit > 0 ? (stock.to_f / limit) : 1 %>

          <% bar_class =
            if stock <= limit * 0.5
              "bg-red-500"
            elsif stock <= limit
              "bg-amber-500"
            else
              "bg-emerald-500"
            end %>

          <div class="bg-white/90 backdrop-blur rounded-3xl border border-slate-200 shadow-sm overflow-hidden">

            <div class="p-6">

              <!-- TOP -->
              <div class="flex items-start justify-between gap-5">

                <div class="flex items-start gap-4 min-w-0">

                  <div class="w-12 h-12 rounded-2xl border flex items-center justify-center
                    <%= stock <= limit ? 'bg-amber-50 border-amber-100' : 'bg-emerald-50 border-emerald-100' %>">

                    <%= icon(stock <= limit ? 'exclamation-circle' : 'check-circle',
                      class: "w-5 h-5 #{stock <= limit ? 'text-amber-600' : 'text-emerald-600'}") %>

                  </div>

                  <div>
                    <h2 class="font-semibold text-lg"><%= product.name %></h2>
                  </div>

                </div>

                <div class="text-right">
                  <p class="text-3xl font-bold"><%= stock %></p>
                  <p class="text-sm text-gray-400">units</p>
                </div>

              </div>

              <!-- STOCK BAR -->
              <div class="mt-5">
                <div class="w-full bg-slate-100 rounded-full h-3 overflow-hidden border">
                  <div class="<%= bar_class %> h-3"
                       style="width: <%= [[(ratio * 100), 8].max, 100].min %>%"></div>
                </div>
              </div>

              <!-- ================= UPDATED SECTION ================= -->
              <div class="mt-5 p-4 rounded-2xl border border-indigo-100 bg-gradient-to-r from-indigo-50 to-white">

                <% if supplier.present? %>

                  <div class="flex items-start justify-between gap-4">

                    <div>

                      <p class="text-[11px] uppercase text-indigo-500 font-bold">
                        Suggested Supplier
                      </p>

                      <p class="text-sm font-semibold text-gray-900 mt-1">
                        <%= supplier.name %>
                      </p>

                      <div class="text-xs text-gray-500 mt-2 space-y-1">

                        <p>
                          Last Item Bought:
                          <span class="font-semibold text-gray-800">
                            <%= last_purchase_item&.product&.name || "N/A" %>
                          </span>
                        </p>

                        <p>
                          Last Bought on:
                          <span class="font-semibold text-gray-800">
                            <%= last_purchase_item&.purchase&.purchase_date&.strftime("%d %b %Y") || "N/A" %>
                          </span>
                        </p>

                        <p>
                          Recommended: <%= product.recommended_stock %> units
                        </p>

                      </div>

                    </div>

                    <div class="flex flex-col gap-2">

                      <%= link_to new_demand_path(
                            supplier_id: supplier.id,
                            product_id: product.id,
                            quantity: product.recommended_stock
                          ),
                          class: "bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-semibold px-3 py-2 rounded-xl text-center" do %>
                        Reorder
                      <% end %>

                      <%= link_to product_path(product),
                          class: "bg-slate-100 hover:bg-slate-200 text-gray-800 text-xs font-semibold px-3 py-2 rounded-xl text-center" do %>
                        View Product
                      <% end %>

                    </div>

                  </div>

                <% else %>

                  <p class="text-xs text-gray-500">
                    No supplier found for this product.
                  </p>

                <% end %>

              </div>

            </div>

          </div>

        <% end %>

      </div>

    <% else %>

      <div class="bg-white/90 rounded-3xl border py-20 text-center">
        <h3 class="text-xl font-semibold">No low stock items</h3>
      </div>

    <% end %>

  </div>
</div>

<style>
@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}
.animate-slideUp { animation: slideUp 0.25s ease; }
</style>