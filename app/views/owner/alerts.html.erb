<div class="max-w-4xl mx-auto p-6">

  <!-- HEADER -->
  <div class="mb-6">
    <h1 class="text-2xl font-bold text-indigo-700">
      🚨 <%= t('stock_alerts') %>
    </h1>
    <p class="text-gray-500">
      <%= t('items_need_attention') %>
    </p>
  </div>

  <% if @products.any? %>

    <div class="space-y-4">

      <% @products.each do |product| %>

        <!-- ALERT CARD -->
        <div class="bg-white border border-indigo-100 border-l-4 border-l-red-500 p-5 rounded-xl shadow-sm">

          <!-- TOP -->
          <div class="flex justify-between items-center">

            <h3 class="font-semibold text-indigo-700">
              🚨 <%= product.name %>
            </h3>

            <span class="bg-red-500 text-white text-xs px-3 py-1 rounded-full">
              <%= t('low_stock') %>
            </span>

          </div>

          <!-- DETAILS -->
          <div class="mt-3 text-sm text-gray-700 space-y-1">

            <p>
              <%= t('current_stock') %>:
              <span class="font-bold text-red-600">
                <%= product.stock_count %>
              </span>
            </p>

            <p>
              <%= t('alert_limit') %>:
              <span class="text-indigo-700 font-semibold">
                <%= product.alert_limit %>
              </span>
            </p>

            <p class="text-indigo-700">
              <%= t('type') %>: <%= product.product_type.name %> |
              <%= t('godown') %>: <%= product.godown_number %>
            </p>

          </div>

          <!-- ACTION -->
          <% if current_user.has_permission?("products", "view") %>
            <div class="mt-3">
              <%= link_to "#{t('view_product')} →", product_path(product),
                  class: "text-indigo-600 font-medium hover:underline" %>
            </div>
          <% end %>

        </div>

      <% end %>

    </div>

  <% else %>

    <!-- EMPTY STATE -->
    <div class="bg-indigo-50 p-6 rounded-xl text-center">
      <h3 class="text-indigo-700 font-semibold">
        <%= t('all_good') %>
      </h3>
      <p class="text-gray-600">
        <%= t('no_low_stock_items') %>
      </p>
    </div>

  <% end %>

</div>