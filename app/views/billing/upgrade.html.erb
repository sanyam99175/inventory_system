<div class="max-w-xl mx-auto text-center py-16">

  <h1 class="text-2xl font-bold mb-4">
    🔒 <%= @feature.humanize %> is not available on your plan
  </h1>

  <p class="text-gray-600 mb-8">
    Upgrade to unlock this feature and grow faster 🚀
  </p>

  <% @plans.each do |plan| %>
    <%= link_to "Upgrade to #{plan.capitalize}",
        billing_checkout_path(price_id: price_for(plan)),
        class: "block bg-indigo-600 text-white py-3 rounded mb-4" %>
  <% end %>

</div>