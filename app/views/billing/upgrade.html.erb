<div class="max-w-3xl mx-auto py-16 px-4 text-center">

  <!-- TITLE -->
  <h1 class="text-3xl font-bold mb-4">
    🔒 <%= @feature.humanize %>
  </h1>

  <!-- DESCRIPTION -->
  <p class="text-gray-600 mb-10">
    <%= feature_description(@feature) %>
  </p>

  <!-- PREVIEW -->
  <div class="bg-white rounded-xl shadow-md p-6 mb-10 relative overflow-hidden">

    <div class="opacity-50 pointer-events-none">
      <% partial_path = "upgrade_previews/#{@feature}" %>

      <%= render(
        lookup_context.exists?(partial_path, [], true) ? partial_path : "upgrade_previews/default"
      ) %>
    </div>

    <!-- Overlay -->
    <div class="absolute inset-0 flex items-center justify-center">
      <span class="bg-white/80 px-4 py-2 rounded-lg font-semibold shadow">
        Preview
      </span>
    </div>

  </div>

  <!-- BENEFITS -->
  <div class="text-left max-w-md mx-auto mb-10 space-y-2 text-gray-700">
    <% feature_benefits(@feature).each do |benefit| %>
      <p>✔ <%= benefit %></p>
    <% end %>
  </div>

  <!-- CTA -->
  <div class="space-y-4">
    <% available_upgrade_plans(current_organization.plan).each do |plan| %>

    <% org = current_organization %>

    <% message =
        if org.plan == "free"
        "Start #{plan.capitalize} Free Trial (7 days)"
        elsif org.subscription_status == "trialing"
        "Upgrade to #{plan.capitalize} (Trial ends on #{org.trial_ends_at.strftime("%d %b")})"
        elsif org.subscription_status == "active"
        "Upgrade to #{plan.capitalize} (Charges apply immediately)"
        else
        "Upgrade to #{plan.capitalize}"
        end
    %>


    <% if current_organization.trial_used? %>
    <p class="text-sm text-gray-500 mb-2">
        Free trial already used
    </p>

    <%= button_to "Upgrade to #{plan.capitalize}",
        billing_change_plan_billing_path(price_id: price_for(plan)),
        data: { turbo: false },
        class: "block w-full bg-indigo-600 text-white py-3 rounded-xl" %>

    <% else %>

    <%= button_to "Start #{plan.capitalize} Free Trial (7 days)",
        billing_change_plan_billing_path(price_id: price_for(plan)),
        data: { turbo: false },
        class: "block w-full bg-green-600 text-white py-3 rounded-xl" %>

    <% end %>

    <% end %>
  </div>

</div>