wb = xlsx_package.workbook

wb.add_worksheet(name: "Users") do |sheet|
  sheet.add_row ["ID", "Name", "Email", "Role", "Created At"]

  @users.each do |user|
    sheet.add_row [
      user.id,
      user.name,
      user.email,
      user.role,
      user.created_at.strftime("%d-%m-%Y")
    ]
  end
end