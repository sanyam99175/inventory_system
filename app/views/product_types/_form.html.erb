<div class="min-h-screen bg-indigo-50 flex items-center justify-center p-6">

  <div class="w-full max-w-md bg-white rounded-2xl shadow border border-indigo-100 p-6">

    <!-- TITLE -->
    <h2 class="text-xl font-bold text-center text-indigo-700 mb-6">
      <%= @product_type.new_record? ? "➕ #{t('add_product_type')}" : "✏️ #{t('edit_product_type')}" %>
    </h2>

    <!-- ERRORS -->
    <% if @product_type.errors.any? %>
      <div class="mb-4 bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg">
        <ul class="list-disc ml-5">
          <% @product_type.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <!-- FORM -->
    <%= form_with(model: @product_type, local: true) do |f| %>

      <!-- NAME -->
      <div class="mb-4">
        <%= f.label :name, t('name'), class: "block text-sm text-gray-600 mb-1" %>
        <%= f.text_field :name,
            class: "w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-indigo-500" %>
      </div>

      <!-- ACTIONS -->
      <div class="flex justify-between items-center mt-6">

        <%= link_to "⬅ #{t('back')}", products_path,
            class: "px-4 py-2 bg-gray-500 text-white rounded-lg hover:bg-gray-600" %>

        <%= f.submit (@product_type.new_record? ? t('create_product_type') : t('update_product_type')),
            class: "px-6 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700" %>

      </div>

    <% end %>

  </div>

</div>