<div style="max-width: 1000px; margin: auto; padding: 20px;">

  <!-- HEADER -->
  <div style="
    background: #1e3a8a;
    color: white;
    padding: 20px;
    border-radius: 12px;
    margin-bottom: 20px;
  ">
    <h2>👷 <%= t('worker_dashboard') %></h2>
    <p style="color: #bfdbfe;"><%= t('search_request_items') %></p>
  </div>

  <!-- SEARCH -->
  <div style="
    background: white;
    padding: 15px;
    border-radius: 10px;
    margin-bottom: 20px;
    border: 1px solid #bfdbfe;
  ">

   <%= form_with url: dashboard_path, method: :get, local: true do %>
      <%= hidden_field_tag :locale, I18n.locale %>

      <%= text_field_tag :search, params[:search],
    placeholder: "🔍 #{t('search_products')}...",
    style: "width: 75%; padding: 10px; border: 1px solid #93c5fd; border-radius: 6px;" %>

      <%= submit_tag t('search'),
          style: "
            padding: 10px;
            background: #2563eb;
            color: white;
            border: none;
            border-radius: 6px;
          " %>

    <% end %>

  </div>

  <!-- PRODUCT GRID -->
  <div style="
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 20px;
  ">

    <% @products.each do |product| %>

      <div style="
        background: white;
        padding: 15px;
        border-radius: 12px;
        border: 1px solid #bfdbfe;
        box-shadow: 0 2px 6px rgba(0,0,0,0.05);
      ">

        <h3 style="margin-bottom: 10px;"><%= product.name %></h3>

        <% stock_count = product.stock_count || 0 %>
        <% alert_limit = product.alert_limit || 0 %>
        <p>
          <%= t('stock') %>:
          <span style="
            font-weight: bold;
            color: <%= stock_count <= alert_limit ? '#dc2626' : '#16a34a' %>;
          ">
            <%= product.stock_count %>
          </span>
        </p>

        <p style="color: #64748b; font-size: 14px;">
          <%= product.product_type.name %>
        </p>

        <%= link_to t('open'),
            product_path(product),
            style: "
              display: block;
              margin-top: 10px;
              text-align: center;
              background: #2563eb;
              color: white;
              padding: 8px;
              border-radius: 6px;
              text-decoration: none;
            " %>

      </div>

    <% end %>

  </div>

</div>