<div style="max-width: 1000px; margin: auto;">

  <!-- HEADER -->
  <div style="margin-bottom: 20px;">
    <h1>👷 Worker Dashboard</h1>
    <p style="color: gray;">Search products and request stock changes</p>
  </div>

  <!-- SEARCH BAR -->
  <div style="background: white; padding: 15px; border-radius: 10px; margin-bottom: 20px;">

    <%= form_with url: worker_dashboard_path, method: :get, local: true do %>
      <input type="text" name="search" placeholder="🔍 Search product..."
        value="<%= params[:search] %>"
        style="width: 80%; padding: 10px; border-radius: 6px; border: 1px solid #ccc;">

      <%= submit_tag "Search",
          style: "padding: 10px; background: #3498db; color: white; border: none; border-radius: 6px;" %>
    <% end %>

  </div>

  <!-- PRODUCT CARDS GRID -->
  <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 20px;">

    <% @products.each do |product| %>

      <div style="
        background: white;
        padding: 15px;
        border-radius: 12px;
        box-shadow: 0 2px 6px rgba(0,0,0,0.1);
      ">

        <h3><%= product.name %></h3>

        <p>
          Stock:
          <span style="
            font-weight: bold;
            color: <%= product.stock_count <= product.alert_limit ? 'red' : 'green' %>;
          ">
            <%= product.stock_count %>
          </span>
        </p>

        <p>📦 Type: <%= product.product_type.name %></p>
        <p>🏬 Godown: <%= product.godown_number %></p>

        <%= link_to "View & Request",
            product_path(product),
            style: "
              display: inline-block;
              margin-top: 10px;
              background: orange;
              color: white;
              padding: 8px 12px;
              border-radius: 6px;
              text-decoration: none;
            " %>

      </div>

    <% end %>

  </div>

</div>