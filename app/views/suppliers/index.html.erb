<div class="max-w-6xl mx-auto p-6">

  <!-- HEADER -->
  <div class="flex items-center justify-between mb-6">

    <div>

      <h1 class="text-3xl font-bold text-gray-900">
        Suppliers
      </h1>

      <p class="text-gray-500 mt-1">
        Manage all supplier records
      </p>

    </div>

    <%= link_to new_supplier_path(@organization),
        class: "
          bg-indigo-600
          hover:bg-indigo-700
          text-white
          px-5 py-3
          rounded-2xl
          font-semibold
          transition
        " do %>

      + Add Supplier

    <% end %>

  </div>

  <!-- LIST -->
  <div class="space-y-4">

    <% @suppliers.each do |supplier| %>

      <div class="bg-white border border-indigo-100 rounded-3xl p-5 shadow-sm">

        <div class="flex items-start justify-between gap-4">

          <div>

            <h2 class="text-lg font-bold text-gray-900">
              <%= supplier.name %>
            </h2>

            <div class="mt-3 space-y-1 text-sm text-gray-600">

              <p>
                📞 <%= supplier.phone.presence || "N/A" %>
              </p>

              <p>
                ✉️ <%= supplier.email.presence || "N/A" %>
              </p>

            </div>

          </div>

          <div class="flex gap-2">

            <%= link_to supplier_path(@organization, supplier),
                class: "
                  px-4 py-2
                  rounded-xl
                  bg-indigo-50
                  text-indigo-700
                  font-medium
                " do %>

              View

            <% end %>

            <%= link_to edit_supplier_path(@organization, supplier),
                class: "
                  px-4 py-2
                  rounded-xl
                  bg-indigo-50
                  text-indigo-700
                  font-medium
                " do %>

              Edit

            <% end %>

            <%= button_to supplier_path(@organization, supplier),
                method: :delete,
                data: {
                  turbo_confirm: "Delete supplier?"
                },
                class: "
                  px-4 py-2
                  rounded-xl
                  bg-red-50
                  text-red-600
                  font-medium
                  border-none
                " do %>

              Delete

            <% end %>

          </div>

        </div>

      </div>

    <% end %>

  </div>

</div>