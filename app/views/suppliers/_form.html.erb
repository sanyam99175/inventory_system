    <!-- ERRORS -->
    <% if @supplier.errors.any? %>
      <div class="mb-4 bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg">
        <ul class="list-disc ml-5">
          <% @supplier.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>
<%= form_with(model: @supplier, local: true, data: { turbo: false }) do |f| %>

  <div class="space-y-5">

    <div>
      <label class="block text-sm font-semibold text-gray-700 mb-2">
        Supplier Name
      </label>

      <%= f.text_field :name,
          class: "w-full border border-indigo-100 rounded-2xl px-4 py-3 outline-none focus:ring-4 focus:ring-indigo-100" %>
    </div>

    <div>
      <label class="block text-sm font-semibold text-gray-700 mb-2">
        Phone
      </label>

      <%= f.text_field :phone,
          class: "w-full border border-indigo-100 rounded-2xl px-4 py-3 outline-none focus:ring-4 focus:ring-indigo-100" %>
    </div>

    <div>
      <label class="block text-sm font-semibold text-gray-700 mb-2">
        Email
      </label>

      <%= f.email_field :email,
          class: "w-full border border-indigo-100 rounded-2xl px-4 py-3 outline-none focus:ring-4 focus:ring-indigo-100" %>
    </div>

    <div>
      <label class="block text-sm font-semibold text-gray-700 mb-2">
        Address
      </label>

      <%= f.text_area :address,
          rows: 4,
          class: "w-full border border-indigo-100 rounded-2xl px-4 py-3 outline-none focus:ring-4 focus:ring-indigo-100" %>
    </div>

    <%= f.submit class: "
      w-full
      bg-indigo-600
      hover:bg-indigo-700
      text-white
      py-3
      rounded-2xl
      font-semibold
      transition
    " %>

  </div>

<% end %>