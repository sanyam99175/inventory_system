<div class="min-h-screen bg-gradient-to-br from-indigo-50 via-white to-indigo-100 py-8 px-4">

  <div class="max-w-3xl mx-auto">

    <!-- HEADER -->
    <div class="flex items-center justify-between mb-6">

      <div>

        <h1 class="text-3xl font-bold text-gray-900">
          Add Supplier
        </h1>

        <p class="text-gray-500 mt-1">
          Create and manage supplier information
        </p>

      </div>

      <%= link_to suppliers_path,
          class: "
            bg-white
            hover:bg-gray-50
            border
            border-indigo-100
            text-gray-700
            px-4
            py-3
            rounded-2xl
            font-medium
            transition
            shadow-sm
          " do %>

        ← Back

      <% end %>

    </div>

    <!-- FORM CARD -->
    <div class="
      bg-white/90
      backdrop-blur
      rounded-3xl
      border
      border-indigo-100
      shadow-sm
      p-6 md:p-8
    ">

      <%= form_with model: @supplier, local: true do |f| %>

        <% if @supplier.errors.any? %>

          <div class="
            mb-6
            bg-red-50
            border
            border-red-100
            rounded-2xl
            p-4
          ">

            <h3 class="text-red-700 font-semibold mb-2">
              Please fix the following:
            </h3>

            <ul class="text-sm text-red-600 space-y-1">

              <% @supplier.errors.full_messages.each do |message| %>

                <li>• <%= message %></li>

              <% end %>

            </ul>

          </div>

        <% end %>

        <!-- GRID -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">

          <!-- NAME -->
          <div>

            <%= f.label :name,
                class: "
                  block
                  text-sm
                  font-semibold
                  text-gray-700
                  mb-2
                " %>

            <%= f.text_field :name,
                class: "
                  w-full
                  rounded-2xl
                  border
                  border-indigo-100
                  bg-white
                  px-4
                  py-3
                  text-sm
                  focus:ring-4
                  focus:ring-indigo-100
                  focus:border-indigo-400
                  outline-none
                ",
                placeholder: "ABC Traders" %>

          </div>

          <!-- PHONE -->
          <div>

            <%= f.label :phone,
                class: "
                  block
                  text-sm
                  font-semibold
                  text-gray-700
                  mb-2
                " %>

            <%= f.text_field :phone,
                class: "
                  w-full
                  rounded-2xl
                  border
                  border-indigo-100
                  bg-white
                  px-4
                  py-3
                  text-sm
                  focus:ring-4
                  focus:ring-indigo-100
                  focus:border-indigo-400
                  outline-none
                ",
                placeholder: "+91 9876543210" %>

          </div>

          <!-- EMAIL -->
          <div>

            <%= f.label :email,
                class: "
                  block
                  text-sm
                  font-semibold
                  text-gray-700
                  mb-2
                " %>

            <%= f.email_field :email,
                class: "
                  w-full
                  rounded-2xl
                  border
                  border-indigo-100
                  bg-white
                  px-4
                  py-3
                  text-sm
                  focus:ring-4
                  focus:ring-indigo-100
                  focus:border-indigo-400
                  outline-none
                ",
                placeholder: "supplier@email.com" %>

          </div>

          <!-- GST -->
          <div>

            <%= f.label :gst_number,
                "GST Number",
                class: "
                  block
                  text-sm
                  font-semibold
                  text-gray-700
                  mb-2
                " %>

            <%= f.text_field :gst_number,
                class: "
                  w-full
                  rounded-2xl
                  border
                  border-indigo-100
                  bg-white
                  px-4
                  py-3
                  text-sm
                  focus:ring-4
                  focus:ring-indigo-100
                  focus:border-indigo-400
                  outline-none
                ",
                placeholder: "22AAAAA0000A1Z5" %>

          </div>

        </div>

        <!-- ADDRESS -->
        <div class="mt-5">

          <%= f.label :address,
              class: "
                block
                text-sm
                font-semibold
                text-gray-700
                mb-2
              " %>

          <%= f.text_area :address,
              rows: 4,
              class: "
                w-full
                rounded-2xl
                border
                border-indigo-100
                bg-white
                px-4
                py-3
                text-sm
                focus:ring-4
                focus:ring-indigo-100
                focus:border-indigo-400
                outline-none
              ",
              placeholder: "Supplier address..." %>

        </div>

        <!-- BUTTONS -->
        <div class="flex flex-col md:flex-row gap-3 mt-8">

          <%= f.submit "Create Supplier",
              class: "
                flex-1
                bg-indigo-600
                hover:bg-indigo-700
                text-white
                py-4
                rounded-2xl
                font-semibold
                transition
                shadow-sm
                cursor-pointer
              " %>

          <%= link_to "Cancel",
              suppliers_path,
              class: "
                flex-1
                text-center
                bg-white
                hover:bg-gray-50
                border
                border-gray-200
                text-gray-700
                py-4
                rounded-2xl
                font-medium
                transition
              " %>

        </div>

      <% end %>

    </div>

  </div>

</div>