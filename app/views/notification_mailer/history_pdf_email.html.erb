<div style="font-family: -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Arial, sans-serif; background-color:#f9fafb; padding:24px;">

  <!-- CARD -->
  <div style="max-width:600px; margin:0 auto; background:#ffffff; border-radius:12px; padding:24px; border:1px solid #e5e7eb;">

    <!-- HEADER -->
    <h2 style="margin:0; font-size:20px; color:#111827;">
      📦 Stock History Report
    </h2>

    <p style="margin-top:8px; color:#6b7280; font-size:14px;">
      Hello <strong><%= @owner.email %></strong>,
    </p>

    <p style="color:#374151; font-size:14px; line-height:1.5;">
      Your requested stock history report has been generated successfully and is attached as a PDF.
    </p>

    <!-- DIVIDER -->
    <hr style="border:none; border-top:1px solid #e5e7eb; margin:20px 0;">

    <!-- FILTER BOX -->
    <div style="background:#f3f4f6; padding:16px; border-radius:10px;">

      <p style="margin:0 0 10px 0; font-weight:600; color:#111827; font-size:14px;">
        Filters Applied
      </p>

      <ul style="margin:0; padding-left:18px; color:#374151; font-size:13px; line-height:1.6;">

        <% if @filters&.dig(:start_date).present? && @filters&.dig(:end_date).present? %>
          <li>
            <strong>Date:</strong>
            <%= @filters[:start_date] %> → <%= @filters[:end_date] %>
          </li>
        <% end %>

        <% if @filters&.dig(:status).present? %>
          <li>
            <strong>Status:</strong>
            <%= @filters[:status].to_s.capitalize %>
          </li>
        <% end %>

        <% if @filters&.dig(:user_id).present? %>
          <li>
            <strong>User filter:</strong> Applied
          </li>
        <% end %>

        <% if @filters.blank? || @filters.values.all?(&:blank?) %>
          <li>No filters applied (full report)</li>
        <% end %>

      </ul>
    </div>

    <!-- FOOTER -->
    <p style="margin-top:20px; font-size:13px; color:#6b7280;">
      Thanks,<br>
      <strong style="color:#111827;">Traklyn System</strong>
    </p>

  </div>

</div>