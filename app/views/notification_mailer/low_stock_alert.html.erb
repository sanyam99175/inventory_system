<div style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Arial, sans-serif;
            background-color: #f6f9fc; padding: 40px 0;">

  <!-- CENTER CONTAINER -->
  <div style="max-width: 600px; margin: auto; background: #ffffff;
              border-radius: 12px; overflow: hidden;
              box-shadow: 0 4px 20px rgba(0,0,0,0.05);">

    <!-- HEADER -->
    <div style="background: #0a2540; padding: 24px;">
      <h1 style="color: #ffffff; margin: 0; font-size: 18px;">
        ⚠️ Low Stock Alert
      </h1>
      <p style="color: #b0c4de; margin: 6px 0 0; font-size: 13px;">
        Inventory system notification
      </p>
    </div>

    <!-- BODY -->
    <div style="padding: 24px;">

      <p style="font-size: 14px; color: #425466; margin-bottom: 20px;">
        One of your products has fallen below the configured stock threshold.
      </p>

      <!-- PRODUCT CARD -->
      <div style="border: 1px solid #e6e9ef; border-radius: 10px; padding: 16px;">

        <h2 style="margin: 0; font-size: 16px; color: #0a2540;">
          <%= @product.name %>
        </h2>

        <p style="margin: 6px 0 0; font-size: 13px; color: #6b7c93;">
          Product ID: #<%= @product.id %>
        </p>

        <hr style="border: none; border-top: 1px solid #eee; margin: 14px 0;">

        <!-- METRICS -->
        <table width="100%" style="font-size: 13px; color: #425466;">
          <tr>
            <td style="padding: 6px 0;">Current Stock</td>
            <td style="text-align: right; font-weight: bold; color: #d73a49;">
              <%= @product.stock_count %>
            </td>
          </tr>

          <tr>
            <td style="padding: 6px 0;">Alert Threshold</td>
            <td style="text-align: right;">
              <%= @product.alert_limit %>
            </td>
          </tr>

          <tr>
            <td style="padding: 6px 0;">Status</td>
            <td style="text-align: right;">
              <span style="background: #ffe8e8; color: #d73a49;
                           padding: 4px 8px; border-radius: 999px;
                           font-size: 12px;">
                Action Required
              </span>
            </td>
          </tr>
        </table>
      </div>

      <!-- CTA -->
      <div style="margin-top: 20px; text-align: center;">
        <a href="http://localhost:3000"
           style="background: #635bff; color: #fff;
                  padding: 10px 16px; border-radius: 8px;
                  text-decoration: none; font-size: 13px;">
          View Dashboard
        </a>
      </div>

      <!-- FOOTER NOTE -->
      <p style="font-size: 11px; color: #a0aec0; margin-top: 24px; text-align: center;">
        You are receiving this because low-stock alerts are enabled.
      </p>

    </div>
  </div>
</div>