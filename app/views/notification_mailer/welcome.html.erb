<div style="font-family: -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Arial, sans-serif; background:#f9fafb; padding:24px;">

  <div style="max-width:600px; margin:0 auto; background:#ffffff; border-radius:12px; padding:28px; border:1px solid #e5e7eb;">

    <!-- HEADER -->
    <h1 style="margin:0; font-size:22px; color:#111827;">
      👋 Welcome to Traklyn
    </h1>

    <p style="margin-top:10px; font-size:14px; color:#6b7280;">
      Hi <strong><%= @user.email %></strong>,
    </p>

    <!-- ROLE BADGE -->
    <% if @user.owner? %>
      <p style="display:inline-block; background:#dbeafe; color:#1d4ed8; padding:4px 10px; border-radius:999px; font-size:12px;">
        Owner Account
      </p>
    <% else %>
      <p style="display:inline-block; background:#f3f4f6; color:#374151; padding:4px 10px; border-radius:999px; font-size:12px;">
        Worker Account
      </p>
    <% end %>

    <!-- BODY -->
    <p style="font-size:14px; color:#374151; line-height:1.6; margin-top:14px;">
      Welcome to your inventory system 🚀
    </p>

    <% if @user.owner? %>

      <p style="font-size:14px; color:#374151; line-height:1.6;">
        As an <strong>Owner</strong>, you have full access to manage your organization, including products, stock levels, requests, users, and notifications.
      </p>

      <div style="margin-top:16px; padding:16px; background:#eff6ff; border-radius:10px;">
        <p style="margin:0 0 10px 0; font-weight:600; color:#1e3a8a;">
          Getting Started:
        </p>

        <ul style="margin:0; padding-left:18px; font-size:13px; color:#1f2937; line-height:1.7;">
          <li>• Manage products & inventory</li>
          <li>• Track stock movements & analytics</li>
          <li>• Manage users & permissions</li>
          <li>• Configure low stock alerts</li>
          <li>• Approve or reject requests</li>
        </ul>
      </div>

      <div style="margin-top:20px; text-align:center;">
        <a href="<%= @dashboard_url %>"
           style="display:inline-block; background:#2563eb; color:#ffffff; padding:10px 16px; border-radius:8px; text-decoration:none; font-size:14px;">
          Go to Owner Dashboard
        </a>
      </div>

    <% else %>

      <p style="font-size:14px; color:#374151; line-height:1.6;">
        As a <strong>Worker</strong>, your role is focused on viewing products and raising stock requests when needed.
      </p>

      <div style="margin-top:16px; padding:16px; background:#f9fafb; border-radius:10px;">
        <p style="margin:0 0 10px 0; font-weight:600; color:#111827;">
          For staff members:
        </p>

        <ul style="margin:0; padding-left:18px; font-size:13px; color:#374151; line-height:1.7;">
          <li>• View product inventory</li>
          <li>• Request stock updates</li>
        </ul>
      </div>

      <div style="margin-top:20px; text-align:center;">
        <a href="<%= @dashboard_url %>"
           style="display:inline-block; background:#16a34a; color:#ffffff; padding:10px 16px; border-radius:8px; text-decoration:none; font-size:14px;">
          Go to Worker Dashboard
        </a>
      </div>

    <% end %>

    <!-- FOOTER -->
    <p style="margin-top:24px; font-size:12px; color:#9ca3af; text-align:center;">
      If you have any questions, reach out to your organization owner.
    </p>

  </div>
</div>