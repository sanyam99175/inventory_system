<div class="min-h-screen bg-gray-100 p-4 sm:p-6">

  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:justify-between sm:items-center gap-4 mb-6">
    <h1 class="text-2xl sm:text-3xl font-semibold text-gray-800">Admin Dashboard</h1>

    <div class="flex flex-col sm:flex-row sm:items-center gap-3 sm:gap-4">
      <span class="text-sm text-gray-600 truncate">
        Logged in as <%= current_user.email %>
      </span>

      <%= link_to "Logout",
          destroy_user_session_path,
          data: { turbo_method: :delete },
          class: "bg-red-500 text-white px-4 py-2 rounded-lg hover:bg-red-600 text-center" %>
    </div>
  </div>

  <!-- Stats Cards -->
  <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-6">
    <div class="bg-white p-4 rounded-xl shadow">
      <p class="text-gray-500 text-sm">Total Orgs</p>
      <p class="text-2xl font-bold"><%= @organizations.count %></p>
    </div>

    <div class="bg-white p-4 rounded-xl shadow">
      <p class="text-gray-500 text-sm">Active</p>
      <p class="text-2xl font-bold text-green-600">
        <%= @organizations.where(subscription_status: "active").count %>
      </p>
    </div>

    <div class="bg-white p-4 rounded-xl shadow">
      <p class="text-gray-500 text-sm">Trialing</p>
      <p class="text-2xl font-bold text-yellow-600">
        <%= @organizations.where(subscription_status: "trialing").count %>
      </p>
    </div>

    <div class="bg-white p-4 rounded-xl shadow">
      <p class="text-gray-500 text-sm">Past Due</p>
      <p class="text-2xl font-bold text-red-600">
        <%= @organizations.where(subscription_status: "past_due").count %>
      </p>
    </div>
  </div>

  <!-- Table -->
  <div class="bg-white rounded-xl shadow overflow-hidden">
    
    <!-- DESKTOP TABLE VIEW -->
    <div class="hidden md:block overflow-x-auto">
      <table class="min-w-full text-sm text-left">

        <!-- Head -->
        <thead class="bg-gray-50 border-b">
          <tr>
            <th class="px-6 py-3 font-medium text-gray-600">Name</th>
            <th class="px-6 py-3 font-medium text-gray-600">Plan</th>
            <th class="px-6 py-3 font-medium text-gray-600">Account Status</th>
            <th class="px-6 py-3 font-medium text-gray-600">Subscription Status</th>
            <th class="px-6 py-3 font-medium text-gray-600">Trial Ends</th>
            <th class="px-6 py-3 font-medium text-gray-600">Actions</th>
          </tr>
        </thead>

        <!-- Body -->
        <tbody class="divide-y">

          <% @organizations.each do |org| %>
            <tr class="hover:bg-gray-50">

              <!-- Name -->
              <td class="px-6 py-4 font-medium text-gray-800">
                <%= org.name %>
              </td>

              <!-- Plan -->
              <td class="px-6 py-4 capitalize text-gray-600">
                <%= org.plan %>
              </td>

              <td class="px-6 py-4 capitalize text-gray-600">
                <%= org.account_status %>
              </td>

              <!-- Status Badge -->
              <td class="px-6 py-4">
                <% status = org.subscription_status %>

                <% badge_class =
                  case status
                  when "active"
                    "bg-green-100 text-green-700"
                  when "trialing"
                    "bg-yellow-100 text-yellow-700"
                  when "past_due"
                    "bg-red-100 text-red-700"
                  when "incomplete"
                    "bg-orange-100 text-orange-700"
                  when "canceled"
                    "bg-gray-200 text-gray-700"
                  else
                    "bg-gray-100 text-gray-600"
                  end
                %>

                <span class="px-3 py-1 rounded-full text-xs font-semibold <%= badge_class %>">
                  <%= status || "none" %>
                </span>
              </td>

              <!-- Trial Ends -->
              <td class="px-6 py-4 text-gray-600">
                <%= org.trial_ends_at&.strftime("%d %b %Y") || "-" %>
              </td>

              <!-- Actions -->
              <td class="px-6 py-4 flex gap-2">

                <%= link_to "View",
                    admin_organization_path(org),
                    class: "text-blue-600 hover:underline" %>

                <%= button_to "Delete",
                    admin_organization_path(org),
                    method: :delete,
                    data: { confirm: "Are you sure?" },
                    class: "text-red-600 hover:underline" %>

              </td>

            </tr>
          <% end %>

        </tbody>
      </table>
    </div>

    <!-- MOBILE CARD VIEW -->
    <div class="md:hidden space-y-3 p-4">
      <% @organizations.each do |org| %>
        <% status = org.subscription_status %>
        <% badge_class =
          case status
          when "active"
            "bg-green-100 text-green-700"
          when "trialing"
            "bg-yellow-100 text-yellow-700"
          when "past_due"
            "bg-red-100 text-red-700"
          when "incomplete"
            "bg-orange-100 text-orange-700"
          when "canceled"
            "bg-gray-200 text-gray-700"
          else
            "bg-gray-100 text-gray-600"
          end
        %>

        <div class="border rounded-lg p-4 bg-gray-50 space-y-3">
          
          <!-- Name -->
          <div>
            <p class="text-xs text-gray-500 uppercase tracking-wide font-semibold">Name</p>
            <p class="text-sm font-medium text-gray-800"><%= org.name %></p>
          </div>

          <!-- Plan & Account Status -->
          <div class="grid grid-cols-2 gap-3">
            <div>
              <p class="text-xs text-gray-500 uppercase tracking-wide font-semibold">Plan</p>
              <p class="text-sm text-gray-700 capitalize"><%= org.plan %></p>
            </div>
            <div>
              <p class="text-xs text-gray-500 uppercase tracking-wide font-semibold">Account</p>
              <p class="text-sm text-gray-700 capitalize"><%= org.account_status %></p>
            </div>
          </div>

          <!-- Subscription Status & Trial Ends -->
          <div class="grid grid-cols-2 gap-3">
            <div>
              <p class="text-xs text-gray-500 uppercase tracking-wide font-semibold">Sub. Status</p>
              <span class="inline-block px-2 py-1 rounded-full text-xs font-semibold <%= badge_class %>">
                <%= status || "none" %>
              </span>
            </div>
            <div>
              <p class="text-xs text-gray-500 uppercase tracking-wide font-semibold">Trial Ends</p>
              <p class="text-sm text-gray-700"><%= org.trial_ends_at&.strftime("%d %b %Y") || "-" %></p>
            </div>
          </div>

          <!-- Actions -->
          <div class="flex gap-2 pt-2 border-t">
            <%= link_to "View",
                admin_organization_path(org),
                class: "flex-1 text-center text-blue-600 hover:bg-blue-50 py-2 rounded text-sm font-medium" %>

            <%= button_to "Delete",
                admin_organization_path(org),
                method: :delete,
                data: { confirm: "Are you sure?" },
                class: "flex-1 text-center text-red-600 hover:bg-red-50 py-2 rounded text-sm font-medium" %>
          </div>

        </div>
      <% end %>
    </div>

  </div>
</div>