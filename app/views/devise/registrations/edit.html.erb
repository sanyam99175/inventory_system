<div style="
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 40px;
  background: #eff6ff;
  min-height: 100vh;
">

  <div style="
    background: white;
    padding: 30px;
    border-radius: 14px;
    width: 440px;
    box-shadow: 0 6px 16px rgba(30, 58, 138, 0.15);
    border: 1px solid #c7d2fe;
  ">

    <h2 style="
      text-align: center;
      margin-bottom: 20px;
      color: #1e3a8a;
      font-weight: 700;
    ">
      ✏️ Edit Profile
    </h2>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>

      <%= render "devise/shared/error_messages", resource: resource %>

      <!-- FULL NAME -->
      <div style="margin-bottom: 15px;">
        <%= f.label :name, "Full name", style: "color: #3730a3; font-weight: 500;" %><br>
        <%= f.text_field :name,
              autocomplete: "name",
              style: "width: 100%; padding: 10px; border-radius: 8px; border: 1px solid #c7d2fe; outline: none;" %>
      </div>

      <!-- EMAIL -->
      <div style="margin-bottom: 15px;">
        <%= f.label :email, style: "color: #3730a3; font-weight: 500;" %><br>
        <%= f.email_field :email,
              autocomplete: "email",
              style: "width: 100%; padding: 10px; border-radius: 8px; border: 1px solid #c7d2fe;" %>
      </div>

      <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
        <p style="color: #4f46e5; font-size: 13px;">
          Pending confirmation: <%= resource.unconfirmed_email %>
        </p>
      <% end %>

      <!-- PASSWORD -->
      <div style="margin-bottom: 15px;">
        <%= f.label :password, style: "color: #3730a3; font-weight: 500;" %>
        <p style="font-size: 12px; color: #64748b;">
          (leave blank if unchanged)
        </p>

        <%= f.password_field :password,
              autocomplete: "new-password",
              style: "width: 100%; padding: 10px; border-radius: 8px; border: 1px solid #c7d2fe;" %>

        <% if @minimum_password_length %>
          <p style="font-size: 12px; color: #64748b;">
            Minimum <%= @minimum_password_length %> characters
          </p>
        <% end %>
      </div>

      <!-- CONFIRM PASSWORD -->
      <div style="margin-bottom: 15px;">
        <%= f.label :password_confirmation, style: "color: #3730a3; font-weight: 500;" %><br>
        <%= f.password_field :password_confirmation,
              style: "width: 100%; padding: 10px; border-radius: 8px; border: 1px solid #c7d2fe;" %>
      </div>

      <!-- CURRENT PASSWORD -->
      <div style="margin-bottom: 20px;">
        <%= f.label :current_password, style: "color: #3730a3; font-weight: 500;" %>
        <p style="font-size: 12px; color: #64748b;">
          Required to save changes
        </p>

        <%= f.password_field :current_password,
              style: "width: 100%; padding: 10px; border-radius: 8px; border: 1px solid #c7d2fe;" %>
      </div>

      <!-- SUBMIT -->
      <div style="margin-bottom: 20px;">
        <%= f.submit t('update'),
            style: "
              width: 100%;
              padding: 11px;
              background: #4f46e5;
              color: white;
              border: none;
              border-radius: 8px;
              font-weight: 600;
              cursor: pointer;
            " %>
      </div>

    <% end %>

    <!-- BACK -->
    <div style="text-align: center; margin-top: 15px;">
      <%= link_to "⬅ Back", :back,
          style: "color: #4f46e5; text-decoration: none;" %>
    </div>

  </div>

</div>