<div class="max-w-xl mx-auto p-6">

  <h1 class="text-2xl font-bold text-indigo-700 mb-6">
    <%= @product.new_record? ? "➕ #{t('add_product')}" : "✏️ #{t('edit_product')}" %>
  </h1>

  <div class="bg-white p-6 rounded-lg shadow border border-gray-200">

    <!-- ERRORS -->
    <% if @product.errors.any? %>
      <div class="mb-4 bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg">
        <% @product.errors.full_messages.each do |msg| %>
          <p><%= msg %></p>
        <% end %>
      </div>
    <% end %>

    <%= form_with model: @product, local: true do |f| %>

      <!-- NAME -->
      <div class="mb-4">
        <%= f.label :name, class: "block text-sm text-gray-600 mb-1" %>
        <%= f.text_field :name,
            class: "w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-indigo-500" %>
      </div>

      <!-- STOCK -->
      <div class="mb-4">
        <%= f.label :stock_count, t('stock'), class: "block text-sm text-gray-600 mb-1" %>
        <%= f.number_field :stock_count,
            class: "w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-indigo-500" %>
      </div>

      <!-- PRODUCT TYPE -->
      <div class="mb-4">
        <%= f.label :product_type_id, t('type'), class: "block text-sm text-gray-600 mb-1" %>
        <%= f.collection_select :product_type_id,
            current_organization.product_types,
            :id,
            :name,
            { prompt: t('select_type') },
            class: "w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-indigo-500" %>
      </div>

      <!-- GODOWN -->
      <div class="mb-4">
        <%= f.label :godown_number, t('godown'), class: "block text-sm text-gray-600 mb-1" %>
        <%= f.text_field :godown_number,
            class: "w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-indigo-500" %>
      </div>

      <!-- ALERT LIMIT -->
      <div class="mb-6">
        <%= f.label :alert_limit, class: "block text-sm text-gray-600 mb-1" %>
        <%= f.number_field :alert_limit,
            class: "w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-indigo-500" %>
      </div>

      <!-- ACTIONS -->
      <div class="flex justify-between">
        <%= link_to t('cancel'), products_path,
            class: "px-4 py-2 bg-gray-500 text-white rounded-lg hover:bg-gray-600" %>

        <%= f.submit(@product.new_record? ? t('create_product') : t('update_product'),
            class: "px-6 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700") %>
      </div>

    <% end %>

  </div>
</div>