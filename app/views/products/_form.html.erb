<div style="
  display: flex;
  justify-content: center;
  margin-top: 50px;
">

  <div style="
    background: #eff6ff;
    padding: 25px;
    border-radius: 12px;
    width: 420px;
    box-shadow: 0 4px 10px rgba(0,0,0,0.1);
    border: 1px solid #bfdbfe;
  ">

    <h2 style="
      text-align: center;
      margin-bottom: 20px;
      color: #1e3a8a;
    ">
      <%= @product.new_record? ? "➕ #{t('add_product')}" : "✏️ #{t('edit_product')}" %>
    </h2>

    <%= form_with(model: @product, local: true) do |f| %>

      <!-- NAME -->
      <div style="margin-bottom: 16px;">
        <%= f.label :name, t('name'), style: "color: #475569; font-weight: 500;" %><br>
        <%= f.text_field :name,
              style: "width: 100%; padding: 10px; border-radius: 6px; border: 1px solid #93c5fd;" %>
      </div>

      <!-- STOCK -->
      <div style="margin-bottom: 16px;">
        <%= f.label :stock_count, t('stock'), style: "color: #475569; font-weight: 500;" %><br>
        <%= f.number_field :stock_count,
              style: "width: 100%; padding: 10px; border-radius: 6px; border: 1px solid #93c5fd;" %>
      </div>

      <!-- PRODUCT TYPE -->
      <div style="margin-bottom: 16px;">
        <%= f.label :product_type_id, t('type'), style: "color: #475569; font-weight: 500;" %><br>
        <%= f.collection_select :product_type_id, ProductType.all, :id, :name,
              { prompt: t('select_type') },
              style: "width: 100%; padding: 10px; border-radius: 6px; border: 1px solid #93c5fd;" %>
      </div>

      <!-- GODOWN -->
      <div style="margin-bottom: 16px;">
        <%= f.label :godown_number, t('godown'), style: "color: #475569; font-weight: 500;" %><br>
        <%= f.text_field :godown_number,
              style: "width: 100%; padding: 10px; border-radius: 6px; border: 1px solid #93c5fd;" %>
      </div>

      <!-- ALERT LIMIT -->
      <div style="margin-bottom: 16px;">
        <%= f.label :alert_limit, style: "color: #475569; font-weight: 500;" %><br>
        <%= f.number_field :alert_limit,
              style: "width: 100%; padding: 10px; border-radius: 6px; border: 1px solid #93c5fd;" %>
      </div>

      <!-- SUBMIT -->
      <div style="margin-top: 10px;">
        <%= f.submit (@product.new_record? ? t('create_product') : t('update_product')),
            style: "
              width: 100%;
              padding: 11px;
              background: #2563eb;
              color: white;
              border: none;
              border-radius: 8px;
              font-weight: bold;
              cursor: pointer;
            " %>
      </div>

    <% end %>

    <!-- BACK -->
    <div style="text-align: center; margin-top: 18px;">
      <%= link_to "⬅ #{t('back_to_products')}", products_path,
          style: "color: #1e3a8a; text-decoration: none;" %>
    </div>

  </div>

</div>