<div class="max-w-6xl mx-auto p-6">

  <!-- TOP BAR -->
  <div class="flex justify-between items-center mb-6">

    <!-- LEFT -->
    <div>
      <%= link_to "🏠 #{t('dashboard')}", dashboard_path,
          class: "bg-indigo-700 text-white px-4 py-2 rounded-lg hover:bg-indigo-800" %>
    </div>

    <!-- RIGHT -->
    <div class="flex gap-3">

      <% if current_user.has_permission?("products", "create_update") %>

        <%= link_to "➕ #{t('add_product_type', default: 'Add Product Category')}",
            new_product_type_path,
            class: "bg-indigo-600 text-white px-4 py-2 rounded-lg hover:bg-indigo-700" %>

        <%= link_to "➕ #{t('add_product', default: 'Add Product')}",
            new_product_path,
            class: "bg-indigo-600 text-white px-4 py-2 rounded-lg hover:bg-indigo-700" %>

      <% end %>

    </div>
  </div>

  <!-- SEARCH + FILTER -->
  <div class="bg-indigo-50 p-4 rounded-lg border border-indigo-200 mb-6">

    <%= form_with url: products_path, method: :get, local: true do %>

      <%= hidden_field_tag :locale, I18n.locale %>

      <div class="flex items-center gap-3 flex-wrap">

        <!-- SEARCH -->
        <%= text_field_tag :search, params[:search],
            placeholder: "🔍 #{t('search_products')}...",
            class: "w-64 px-4 py-2 border border-indigo-300 rounded-lg focus:ring-2 focus:ring-indigo-500" %>

        <!-- CATEGORY FILTER -->
        <%= select_tag :product_type_id,
            options_from_collection_for_select(
              current_organization.product_types,
              :id,
              :name,
              params[:product_type_id]
            ),
            include_blank: "#{t('all_categories', default: 'All Categories')}",
            class: "px-4 py-2 border border-indigo-300 rounded-lg focus:ring-2 focus:ring-indigo-500" %>

        <!-- SUBMIT -->
        <%= submit_tag t('search'),
            class: "px-4 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700" %>

        <!-- CLEAR -->
        <% if params[:search].present? || params[:product_type_id].present? %>
          <%= link_to t('clear'), products_path,
              class: "text-indigo-700 hover:underline" %>
        <% end %>

      </div>

    <% end %>

  </div>

  <!-- TABLE -->
  <div class="bg-white rounded-xl shadow border border-indigo-100 overflow-hidden">

    <table class="w-full">

      <thead class="bg-indigo-100 text-indigo-900">
        <tr>
          <th class="p-4 text-left"><%= t('product') %></th>
          <th class="p-4 text-left"><%= t('stock') %></th>
          <th class="p-4 text-left"><%= t('type') %></th>
          <th class="p-4 text-left w-56"><%= t('actions') %></th>
        </tr>
      </thead>

      <tbody id="products">

        <% if @products.present? %>
          <%= render @products %>
        <% else %>
          <tr>
            <td colspan="4" class="text-center py-10 text-indigo-400">
              <% if params[:search].present? || params[:product_type_id].present? %>
                🔍 <%= t('no_matching_products', default: "No matching products found") %>
              <% else %>
                📦 <%= t('no_products_available', default: "No products available") %>
              <% end %>
            </td>
          </tr>
        <% end %>

      </tbody>

    </table>

  </div>

</div>