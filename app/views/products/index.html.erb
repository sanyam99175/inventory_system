<div class="min-h-screen bg-gradient-to-br from-indigo-50 via-white to-indigo-100">

  <div class="max-w-7xl mx-auto px-4 md:px-6 py-6">

    <!-- ================= PAGE HEADER ================= -->
    <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-5 mb-6">

      <!-- LEFT -->
      <div>

        <div class="flex items-center gap-3">

          <div class="w-12 h-12 rounded-2xl bg-indigo-600 flex items-center justify-center shadow-sm">
            <%= icon('box', class: 'w-6 h-6 text-white') %>
          </div>

          <div>

            <h1 class="text-2xl md:text-3xl font-bold tracking-tight text-gray-900">
              <%= t('products', default: 'Products') %>
            </h1>

            <p class="text-sm text-gray-500 mt-1">
              Manage inventory, stock intelligence and product insights
            </p>

          </div>

        </div>

      </div>

      <!-- RIGHT -->
      <div class="flex flex-wrap gap-3">

        <% if current_user.has_permission?("products", "create_update") %>

          <%= link_to new_product_type_path,
              class: "bg-white hover:bg-indigo-50 border border-indigo-100 text-indigo-700 px-4 py-3 rounded-2xl text-sm font-medium transition flex items-center gap-2 shadow-sm" do %>

            <%= icon('layers', class: 'w-4 h-4') %>

            <span>Category</span>

          <% end %>

          <%= link_to new_product_path,
              class: "bg-indigo-600 hover:bg-indigo-700 text-white px-5 py-3 rounded-2xl text-sm font-semibold transition flex items-center gap-2 shadow-sm" do %>

            <%= icon('plus', class: 'w-4 h-4') %>

            <span>Add Product</span>

          <% end %>

        <% end %>

      </div>

    </div>

    <!-- ================= FILTER BAR ================= -->
    <div class="bg-white/90 backdrop-blur rounded-3xl border border-indigo-100 shadow-sm p-5 mb-6">

      <%= form_with url: products_path, method: :get, local: true do %>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-4">

          <!-- SEARCH -->
          <div class="lg:col-span-6 relative">

            <div class="absolute inset-y-0 left-4 flex items-center pointer-events-none text-gray-400">
              <%= icon('search', class: 'w-5 h-5') %>
            </div>

            <%= text_field_tag :search,
                params[:search],
                placeholder: "Search products...",
                class: "w-full bg-white border border-indigo-100 focus:border-indigo-400 focus:ring-4 focus:ring-indigo-100 rounded-2xl pl-12 pr-4 py-3 text-sm outline-none transition" %>

          </div>

          <!-- CATEGORY -->
          <div class="lg:col-span-4">

            <%= select_tag :product_type_id,
                options_from_collection_for_select(
                  current_organization.product_types,
                  :id,
                  :name,
                  params[:product_type_id]
                ),
                include_blank: "All Categories",
                class: "w-full bg-white border border-indigo-100 focus:border-indigo-400 focus:ring-4 focus:ring-indigo-100 rounded-2xl px-4 py-3 text-sm outline-none transition" %>

          </div>

          <!-- BUTTON -->
          <div class="lg:col-span-2">

            <%= submit_tag "Search",
                class: "w-full bg-indigo-600 hover:bg-indigo-700 text-white py-3 rounded-2xl text-sm font-semibold transition shadow-sm cursor-pointer" %>

          </div>

        </div>

      <% end %>

    </div>

    <!-- ================= EARLY WARNING ================= -->
    <% if @show_early_stage_warning %>

      <div id="early-stage-banner" class="mb-6">

        <div class="bg-amber-50 border border-amber-200 rounded-3xl p-5 shadow-sm">

          <div class="flex items-start justify-between gap-4">

            <!-- LEFT -->
            <div class="flex items-start gap-4">

              <div class="w-11 h-11 rounded-2xl bg-amber-100 border border-amber-200 flex items-center justify-center shrink-0">
                <%= icon('exclamation-triangle', class: 'w-5 h-5 text-amber-700') %>
              </div>

              <div>

                <h3 class="font-semibold text-amber-900">
                  Early-stage data warning
                </h3>

                <p class="text-sm text-amber-700 mt-2 leading-relaxed">
                  Traklyn insights are still learning from your inventory usage patterns.
                  Predictions become more accurate after around 30 days of activity.
                </p>

              </div>

            </div>

            <!-- CLOSE -->
            <button
              onclick="dismissEarlyBanner()"
              class="text-amber-400 hover:text-amber-700 transition"
            >
              <%= icon('x', class: 'w-5 h-5') %>
            </button>

          </div>

        </div>

      </div>

    <% end %>

    <!-- ================= PRODUCT TABLE ================= -->
    <div class="bg-white/90 backdrop-blur rounded-3xl border border-indigo-100 shadow-sm overflow-hidden">

      <!-- TOP BAR -->
      <div class="px-5 md:px-6 py-5 border-b border-indigo-50 flex items-center justify-between">

        <div>

          <h2 class="font-semibold text-gray-900">
            Product Inventory
          </h2>

          <p class="text-sm text-gray-500 mt-1">
            <%= @products.count %> products available
          </p>

        </div>

      </div>

      <!-- ================= MOBILE CARDS ================= -->
      <div class="block lg:hidden">

        <% if @products.present? %>

          <div class="space-y-4 p-4">

            <% @products.each do |product| %>

              <%= link_to product_path(product),
                class: "
                  block
                  rounded-3xl
                  border
                  border-indigo-100
                  shadow-sm
                  overflow-hidden
                  transition-all
                  duration-300
                  active:scale-[0.98]
                  bg-gradient-to-br
                  from-white
                  via-white
                  to-white
                  hover:from-indigo-50
                  hover:via-white
                  hover:to-indigo-100/80
                  hover:-translate-y-1
                  hover:shadow-xl
                  hover:border-indigo-200
                " do %>

                <div class="p-5">

                  <!-- TOP -->
                  <div class="flex items-start gap-4">

                    <!-- ICON -->
                    <div class="w-12 h-12 rounded-2xl bg-indigo-50 border border-indigo-100 flex items-center justify-center shrink-0">

                      <%= icon('cube', class: 'w-5 h-5 text-indigo-700') %>

                    </div>

                    <!-- CONTENT -->
                    <div class="flex-1 min-w-0">

                      <!-- NAME -->
                      <div class="flex items-start justify-between gap-3">

                        <div class="min-w-0">

                          <h3 class="font-semibold text-gray-900 text-[15px] leading-5 break-words">
                            <%= product.name %>
                          </h3>

                          <div class="mt-2">

                            <span class="inline-flex bg-indigo-50 border border-indigo-100 text-indigo-700 text-xs px-2.5 py-1 rounded-full font-medium">
                              <%= product.product_type&.name || "Uncategorized" %>
                            </span>

                          </div>

                        </div>

                        <!-- STATUS -->
                        <% if product.reorder_needed? %>

                          <span class="bg-red-100 text-red-700 text-[11px] px-2.5 py-1 rounded-full font-semibold border border-red-200 whitespace-nowrap">
                            Low
                          </span>

                        <% else %>

                          <span class="bg-emerald-100 text-emerald-700 text-[11px] px-2.5 py-1 rounded-full font-semibold border border-emerald-200 whitespace-nowrap">
                            Healthy
                          </span>

                        <% end %>

                      </div>

                      <!-- STOCK -->
                      <div class="mt-5 flex items-end justify-between">

                        <div>

                          <p class="text-xs text-gray-500">
                            Current Stock
                          </p>

                          <h2 class="text-3xl font-bold text-gray-900 leading-none mt-1">
                            <%= product.stock_count %>
                          </h2>

                        </div>

                        <!-- ARROW -->
                        <div class="w-10 h-10 rounded-2xl bg-indigo-50 border border-indigo-100 flex items-center justify-center">

                          <%= icon('chevron-right', class: 'w-4 h-4 text-indigo-700') %>

                        </div>

                      </div>

                    </div>

                  </div>

                </div>

              <% end %>

            <% end %>

          </div>

        <% else %>

          <!-- EMPTY -->
          <div class="py-20 px-6 text-center">

            <div class="w-20 h-20 rounded-full bg-indigo-50 border border-indigo-100 flex items-center justify-center mx-auto mb-5">

              <%= icon('cube-transparent', class: 'w-8 h-8 text-indigo-700') %>

            </div>

            <h3 class="text-lg font-semibold text-gray-900">
              No products found
            </h3>

            <p class="text-sm text-gray-500 mt-2">
              Start by creating your first inventory product.
            </p>

          </div>

        <% end %>

      </div>

      <!-- ================= DESKTOP TABLE ================= -->
      <div class="hidden lg:block overflow-x-auto">

        <table class="min-w-full">

          <!-- HEAD -->
          <thead class="bg-indigo-50/70 border-b border-indigo-100">

            <tr>

              <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wide text-indigo-700">
                Product
              </th>

              <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wide text-indigo-700">
                Stock Intelligence
              </th>

              <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wide text-indigo-700">
                Category
              </th>

              <th class="px-6 py-4 text-right text-xs font-semibold uppercase tracking-wide text-indigo-700">
                Actions
              </th>

            </tr>

          </thead>

          <!-- BODY -->
          <tbody class="divide-y divide-indigo-50">

            <% if @products.present? %>

              <% @products.each do |product| %>

                <tr class="hover:bg-indigo-50/40 transition">

                  <!-- PRODUCT -->
                  <td class="px-6 py-5">

                    <div class="flex items-start gap-4">

                      <div class="w-11 h-11 rounded-2xl bg-indigo-50 border border-indigo-100 flex items-center justify-center shrink-0">

                        <%= icon('cube', class: 'w-5 h-5 text-indigo-700') %>

                      </div>

                      <div>

                        <div class="flex items-center gap-2 flex-wrap">

                          <h3 class="font-semibold text-gray-900">
                            <%= product.name %>
                          </h3>

                          <% if product.reorder_needed? %>

                            <span class="bg-red-100 text-red-700 text-xs px-2 py-1 rounded-full font-medium border border-red-200">
                              Reorder
                            </span>

                          <% else %>

                            <span class="bg-emerald-100 text-emerald-700 text-xs px-2 py-1 rounded-full font-medium border border-emerald-200">
                              Healthy
                            </span>

                          <% end %>

                        </div>

                        <p class="text-sm text-gray-500 mt-1">
                          Usage:
                          <span class="font-medium text-gray-700">
                            <%= product.daily_usage_rate.round(2) %>/day
                          </span>
                        </p>

                      </div>

                    </div>

                  </td>

                  <!-- STOCK -->
                  <td class="px-6 py-5">

                    <div class="space-y-2">

                      <div class="flex items-center gap-2">

                        <span class="text-lg font-bold text-gray-900">
                          <%= product.stock_count %>
                        </span>

                        <% low_days = product.days_remaining.to_i <= 7 %>

                        <span class="text-xs px-2 py-1 rounded-full border font-medium
                          <%= low_days ?
                            'bg-red-50 text-red-700 border-red-200' :
                            'bg-indigo-50 text-indigo-700 border-indigo-100' %>">

                          <%= product.days_remaining %> days left

                        </span>

                      </div>

                      <div class="text-sm text-gray-500">

                        Suggested Stock:
                        <span class="font-medium text-gray-700">
                          <%= product.recommended_stock %>
                        </span>

                      </div>

                      <% if product.reorder_needed? %>

                        <div class="flex items-center gap-2 text-xs font-medium text-red-600">

                          <div class="w-2 h-2 rounded-full bg-red-500"></div>

                          Low stock risk detected

                        </div>

                      <% else %>

                        <div class="flex items-center gap-2 text-xs font-medium text-emerald-600">

                          <div class="w-2 h-2 rounded-full bg-emerald-500"></div>

                          Healthy stock level

                        </div>

                      <% end %>

                    </div>

                  </td>

                  <!-- CATEGORY -->
                  <td class="px-6 py-5">

                    <span class="bg-indigo-50 border border-indigo-100 text-indigo-700 text-sm px-3 py-1 rounded-full font-medium">
                      <%= product.product_type&.name || "Uncategorized" %>
                    </span>

                  </td>

                  <!-- ACTIONS -->
                  <td class="px-6 py-5">

                    <div class="flex items-center justify-end gap-2">

                      <%= link_to "View",
                          product_path(product),
                          class: "bg-white hover:bg-indigo-50 border border-indigo-100 text-gray-700 px-3 py-2 rounded-xl text-sm font-medium transition" %>

                      <% if current_user.has_permission?("products", "create_update") %>

                        <%= link_to "Edit",
                            edit_product_path(product),
                            class: "bg-white hover:bg-indigo-50 border border-indigo-100 text-gray-700 px-3 py-2 rounded-xl text-sm font-medium transition" %>

                      <% end %>

                      <% if current_user.has_permission?("products", "delete") %>

                        <%= link_to "Delete",
                            product_path(product),
                            data: {
                              turbo_method: :delete,
                              turbo_confirm: "Are you sure?"
                            },
                            class: "bg-red-600 hover:bg-red-700 text-white px-3 py-2 rounded-xl text-sm font-medium transition" %>

                      <% end %>

                    </div>

                  </td>

                </tr>

              <% end %>

            <% else %>

              <tr>

                <td colspan="4" class="py-20 px-6 text-center">

                  <div class="w-20 h-20 rounded-full bg-indigo-50 border border-indigo-100 flex items-center justify-center mx-auto mb-5">

                    <%= icon('cube-transparent', class: 'w-8 h-8 text-indigo-700') %>

                  </div>

                  <h3 class="text-lg font-semibold text-gray-900">
                    No products found
                  </h3>

                  <p class="text-sm text-gray-500 mt-2">
                    Start by creating your first inventory product.
                  </p>

                </td>

              </tr>

            <% end %>

          </tbody>

        </table>

      </div>

    </div>

  </div>

</div>

<script>
  function dismissEarlyBanner() {
    const banner = document.getElementById("early-stage-banner");

    if (!banner) return;

    banner.style.transition = "all 0.25s ease";
    banner.style.opacity = "0";
    banner.style.transform = "translateY(-8px)";

    setTimeout(() => {
      banner.style.display = "none";
    }, 250);
  }
</script>