<div class="min-h-screen bg-gradient-to-br from-indigo-50 via-white to-indigo-100">

  <div class="max-w-7xl mx-auto px-4 md:px-6 py-6">

    <!-- ================= PAGE HEADER ================= -->
    <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-5 mb-6">

      <!-- LEFT -->
      <div>

        <div class="flex items-center gap-3">

          <div class="w-12 h-12 rounded-2xl bg-indigo-600 flex items-center justify-center shadow-sm">
            <%= icon('box', class: 'w-6 h-6 text-white') %>
          </div>

          <div>

            <h1 class="text-2xl md:text-3xl font-bold tracking-tight text-gray-900">
              <%= t('products', default: 'Products') %>
            </h1>

            <p class="text-base text-gray-500 mt-1">
              Manage inventory, stock intelligence and product insights
            </p>

          </div>

        </div>

      </div>

      <!-- RIGHT -->
      <div class="flex flex-wrap gap-3">

        <% if current_user.has_permission?("products", "create_update") %>

          <!-- ================= DESKTOP BUTTONS ================= -->
          <div class="hidden lg:flex items-center gap-3">

            <%= link_to new_product_type_path,
                class: "bg-white hover:bg-indigo-50 border border-indigo-100 text-indigo-700 px-4 py-3 rounded-2xl text-base font-medium transition flex items-center gap-2 shadow-sm" do %>

              <%= icon('plus', class: 'w-4 h-4') %>

              <span>Category</span>

            <% end %>

            <%= link_to new_product_path,
                class: "bg-indigo-600 hover:bg-indigo-700 text-white px-5 py-3 rounded-2xl text-base font-semibold transition flex items-center gap-2 shadow-sm" do %>

              <%= icon('plus', class: 'w-4 h-4') %>

              <span>Add Product</span>

            <% end %>

          </div>

          <!-- ================= MOBILE BUTTONS ================= -->
          <div class="flex lg:hidden items-center gap-3">

            <!-- CATEGORY -->
            <button
              type="button"
              onclick="openCategoryModal()"
              class="bg-white hover:bg-indigo-50 border border-indigo-100 text-indigo-700 px-4 py-3 rounded-2xl text-base font-medium transition flex items-center gap-2 shadow-sm"
            >

              <%= icon('plus', class: 'w-4 h-4') %>

              <span>Category</span>

            </button>

            <!-- PRODUCT -->
            <button
              type="button"
              onclick="openProductModal()"
              class="bg-indigo-600 hover:bg-indigo-700 text-white px-5 py-3 rounded-2xl text-base font-semibold transition flex items-center gap-2 shadow-sm"
            >

              <%= icon('plus', class: 'w-4 h-4') %>

              <span>Add Product</span>

            </button>

          </div>

        <% end %>

      </div>

    </div>

    <!-- ================= MOBILE CATEGORY MODAL ================= -->
    <div
      id="category-modal"
      class="fixed inset-0 z-[99999] hidden lg:hidden"
    >

      <!-- BACKDROP -->
      <div
        onclick="closeCategoryModal()"
        class="fixed inset-0 bg-black/50 backdrop-blur-md"
        style="
          -webkit-backdrop-filter: blur(12px);
          backdrop-filter: blur(12px);
        "
      ></div>

      <!-- SHEET -->
      <div class="
        fixed
        bottom-0
        inset-x-0
        bg-white
        rounded-t-[32px]
        shadow-2xl
        animate-slide-up
        z-[100000]
        max-h-[92dvh]
        overflow-y-auto
      ">

        <div class="p-6 pb-8">

          <!-- HANDLE -->
          <div class="w-14 h-1.5 rounded-full bg-gray-200 mx-auto mb-6"></div>

          <!-- HEADER -->
          <div class="mb-6">

            <h2 class="text-xl font-bold text-gray-900">
              Create Category
            </h2>

            <p class="text-base text-gray-500 mt-1">
              Add a new product category
            </p>

          </div>

          <!-- FORM -->
          <%= form_with model: ProductType.new,
              url: product_types_path,
              local: true do |f| %>

            <div>

              <%= f.label :name,
                  class: "text-base font-semibold text-gray-700 mb-2 block" %>

              <%= f.text_field :name,
                  placeholder: "e.g. Electronics",
                  class: "
                    w-full
                    bg-white
                    border border-indigo-100
                    focus:border-indigo-400
                    focus:ring-4 focus:ring-indigo-100
                    rounded-2xl
                    px-4 py-4
                    text-base
                    outline-none
                    transition
                  " %>

            </div>

            <!-- ACTIONS -->
            <div class="flex items-center gap-3 mt-6">

              <button
                type="button"
                onclick="closeCategoryModal()"
                class="
                  flex-1
                  bg-white
                  border border-gray-200
                  hover:bg-gray-50
                  text-gray-700
                  py-4
                  rounded-2xl
                  font-semibold
                  transition
                "
              >
                Cancel
              </button>

              <%= f.submit "Save Category",
                  class: "
                    flex-1
                    bg-indigo-600
                    hover:bg-indigo-700
                    text-white
                    py-4
                    rounded-2xl
                    font-semibold
                    transition
                    shadow-sm
                    cursor-pointer
                  " %>

            </div>

          <% end %>

        </div>

      </div>

    </div>

    <!-- ================= MOBILE PRODUCT MODAL ================= -->
    <div
      id="product-modal"
      class="fixed inset-0 z-[99999] hidden lg:hidden"
    >

      <!-- BACKDROP -->
      <div
        onclick="closeProductModal()"
        class="fixed inset-0 bg-black/50 backdrop-blur-md"
        style="
          -webkit-backdrop-filter: blur(12px);
          backdrop-filter: blur(12px);
        "
      ></div>

      <!-- SHEET -->
      <div class="
        fixed
        bottom-0
        inset-x-0
        bg-white
        rounded-t-[32px]
        shadow-2xl
        animate-slide-up
        z-[100000]
        max-h-[92dvh]
        overflow-y-auto
      ">

        <div class="p-6 pb-[max(2rem,env(safe-area-inset-bottom))]">

          <!-- HANDLE -->
          <div class="w-14 h-1.5 rounded-full bg-gray-200 mx-auto mb-6"></div>

          <!-- HEADER -->
          <div class="mb-6">

            <h2 class="text-xl font-bold text-gray-900">
              Add Product
            </h2>

            <p class="text-base text-gray-500 mt-1">
              Create a new inventory product
            </p>

          </div>

          <!-- FORM -->
          <%= form_with model: Product.new,
              url: products_path,
              local: true do |f| %>

            <div class="space-y-5">

              <!-- NAME -->
              <div>

                <%= f.label :name,
                    class: "text-base font-semibold text-gray-700 mb-2 block" %>

                <%= f.text_field :name,
                    placeholder: "e.g. Rice Bag",
                    class: "
                      w-full
                      bg-white
                      border border-indigo-100
                      focus:border-indigo-400
                      focus:ring-4 focus:ring-indigo-100
                      rounded-2xl
                      px-4 py-4
                      text-base
                      outline-none
                      transition
                    " %>

              </div>

              <!-- CATEGORY -->
              <div>

                <%= f.label :product_type_id, "Category",
                    class: "text-base font-semibold text-gray-700 mb-2 block" %>

                <%= f.collection_select :product_type_id,
                    current_organization.product_types,
                    :id,
                    :name,
                    { prompt: "Select Category" },
                    {
                      class: "
                        w-full
                        bg-white
                        border border-indigo-100
                        focus:border-indigo-400
                        focus:ring-4 focus:ring-indigo-100
                        rounded-2xl
                        px-4 py-4
                        text-base
                        outline-none
                        transition
                      "
                    } %>

              </div>

              <!-- STOCK -->
              <div class="grid grid-cols-2 gap-4">

                <div>

                  <%= f.label :stock_count,
                      class: "text-base font-semibold text-gray-700 mb-2 block" %>

                  <%= f.number_field :stock_count,
                      placeholder: "0",
                      class: "
                        w-full
                        bg-white
                        border border-indigo-100
                        focus:border-indigo-400
                        focus:ring-4 focus:ring-indigo-100
                        rounded-2xl
                        px-4 py-4
                        text-base
                        outline-none
                        transition
                      " %>

                </div>

                <div>

                  <%= f.label :alert_limit,
                      class: "text-base font-semibold text-gray-700 mb-2 block" %>

                  <%= f.number_field :alert_limit,
                      placeholder: "10",
                      class: "
                        w-full
                        bg-white
                        border border-indigo-100
                        focus:border-indigo-400
                        focus:ring-4 focus:ring-indigo-100
                        rounded-2xl
                        px-4 py-4
                        text-base
                        outline-none
                        transition
                      " %>

                </div>

              </div>

              <!-- GODOWN -->
              <div>

                <%= f.label :godown_number,
                    class: "text-base font-semibold text-gray-700 mb-2 block" %>

                <%= f.text_field :godown_number,
                    placeholder: "e.g. A-12",
                    class: "
                      w-full
                      bg-white
                      border border-indigo-100
                      focus:border-indigo-400
                      focus:ring-4 focus:ring-indigo-100
                      rounded-2xl
                      px-4 py-4
                      text-base
                      outline-none
                      transition
                    " %>

              </div>

            </div>

            <!-- ACTIONS -->
            <div class="flex items-center gap-3 mt-7">

              <button
                type="button"
                onclick="closeProductModal()"
                class="
                  flex-1
                  bg-white
                  border border-gray-200
                  hover:bg-gray-50
                  text-gray-700
                  py-4
                  rounded-2xl
                  font-semibold
                  transition
                "
              >
                Cancel
              </button>

              <%= f.submit "Create Product",
                  class: "
                    flex-1
                    bg-indigo-600
                    hover:bg-indigo-700
                    text-white
                    py-4
                    rounded-2xl
                    font-semibold
                    transition
                    shadow-sm
                    cursor-pointer
                  " %>

            </div>

          <% end %>

        </div>

      </div>

    </div>

    <!-- ================= FILTER BAR ================= -->
    <div class="bg-white/90 backdrop-blur rounded-3xl border border-indigo-100 shadow-sm p-5 mb-6">

      <%= form_with url: products_path, method: :get, local: true do %>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-4">

          <!-- SEARCH -->
          <div class="lg:col-span-6 relative">

            <div class="absolute inset-y-0 left-4 flex items-center pointer-events-none text-gray-400">
              <%= icon('search', class: 'w-5 h-5') %>
            </div>

            <%= text_field_tag :search,
                params[:search],
                placeholder: "Search products...",
                class: "w-full bg-white border border-indigo-100 focus:border-indigo-400 focus:ring-4 focus:ring-indigo-100 rounded-2xl pl-12 pr-4 py-3 text-base outline-none transition" %>

          </div>

          <!-- CATEGORY -->
          <div class="lg:col-span-4">

            <%= select_tag :product_type_id,
                options_from_collection_for_select(
                  current_organization.product_types,
                  :id,
                  :name,
                  params[:product_type_id]
                ),
                include_blank: "All Categories",
                class: "w-full bg-white border border-indigo-100 focus:border-indigo-400 focus:ring-4 focus:ring-indigo-100 rounded-2xl px-4 py-3 text-base outline-none transition" %>

          </div>

          <!-- BUTTON -->
          <div class="lg:col-span-2">

            <%= submit_tag "Search",
                class: "w-full bg-indigo-600 hover:bg-indigo-700 text-white py-3 rounded-2xl text-base font-semibold transition shadow-sm cursor-pointer" %>

          </div>

        </div>

      <% end %>

    </div>

    <!-- ================= PRODUCT TABLE ================= -->
    <div class="bg-white/90 backdrop-blur rounded-3xl border border-indigo-100 shadow-sm overflow-hidden">

      <!-- TOP BAR -->
      <div class="px-5 md:px-6 py-5 border-b border-indigo-50 flex items-center justify-between">

        <div>

          <h2 class="font-semibold text-gray-900">
            Product Inventory
          </h2>

          <p class="text-base text-gray-500 mt-1">
            <%= @products.count %> products available
          </p>

        </div>

      </div>

      <!-- MOBILE -->
      <div class="block lg:hidden">

        <% if @products.present? %>

          <div class="space-y-4 p-4">

            <% @products.each do |product| %>

              <%= link_to product_path(product),
                class: "
                  block
                  rounded-3xl
                  border
                  border-indigo-100
                  shadow-sm
                  overflow-hidden
                  transition-all
                  duration-300
                  active:scale-[0.98]
                  bg-gradient-to-br
                  from-white
                  via-white
                  to-white
                  hover:from-indigo-50
                  hover:via-white
                  hover:to-indigo-100/80
                  hover:-translate-y-1
                  hover:shadow-xl
                  hover:border-indigo-200
                " do %>

                <div class="p-5">

                  <div class="flex items-start gap-4">

                    <div class="w-12 h-12 rounded-2xl bg-indigo-50 border border-indigo-100 flex items-center justify-center shrink-0">

                      <%= icon('cube', class: 'w-5 h-5 text-indigo-700') %>

                    </div>

                    <div class="flex-1 min-w-0">

                      <div class="flex items-start justify-between gap-3">

                        <div class="min-w-0">

                          <h3 class="font-semibold text-gray-900 text-[15px] leading-5 break-words">
                            <%= product.name %>
                          </h3>

                          <div class="mt-2">

                            <span class="inline-flex bg-indigo-50 border border-indigo-100 text-indigo-700 text-xs px-2.5 py-1 rounded-full font-medium">
                              <%= product.product_type&.name || "Uncategorized" %>
                            </span>

                          </div>

                        </div>

                        <% if product.reorder_needed? %>

                          <span class="bg-red-100 text-red-700 text-[11px] px-2.5 py-1 rounded-full font-semibold border border-red-200 whitespace-nowrap">
                            Low
                          </span>

                        <% else %>

                          <span class="bg-emerald-100 text-emerald-700 text-[11px] px-2.5 py-1 rounded-full font-semibold border border-emerald-200 whitespace-nowrap">
                            Healthy
                          </span>

                        <% end %>

                      </div>

                      <div class="mt-5 flex items-end justify-between">

                        <div>

                          <p class="text-xs text-gray-500">
                            Current Stock
                          </p>

                          <h2 class="text-3xl font-bold text-gray-900 leading-none mt-1">
                            <%= product.stock_count %>
                          </h2>

                        </div>

                        <div class="w-10 h-10 rounded-2xl bg-indigo-50 border border-indigo-100 flex items-center justify-center">

                          <%= icon('chevron-right', class: 'w-4 h-4 text-indigo-700') %>

                        </div>

                      </div>

                    </div>

                  </div>

                </div>

              <% end %>

            <% end %>

          </div>

        <% end %>

      </div>

      <!-- DESKTOP -->
      <div class="hidden lg:block overflow-x-auto">

        <table class="min-w-full">

          <thead class="bg-indigo-50/70 border-b border-indigo-100">

            <tr>

              <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wide text-indigo-700">
                Product
              </th>

              <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wide text-indigo-700">
                Stock Intelligence
              </th>

              <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wide text-indigo-700">
                Category
              </th>

              <th class="px-6 py-4 text-right text-xs font-semibold uppercase tracking-wide text-indigo-700">
                Actions
              </th>

            </tr>

          </thead>

          <tbody class="divide-y divide-indigo-50">

            <% @products.each do |product| %>

              <tr class="hover:bg-indigo-50/40 transition">

                <td class="px-6 py-5">

                  <div class="flex items-start gap-4">

                    <div class="w-11 h-11 rounded-2xl bg-indigo-50 border border-indigo-100 flex items-center justify-center shrink-0">

                      <%= icon('cube', class: 'w-5 h-5 text-indigo-700') %>

                    </div>

                    <div>

                      <div class="flex items-center gap-2 flex-wrap">

                        <h3 class="font-semibold text-gray-900">
                          <%= product.name %>
                        </h3>

                      </div>

                    </div>

                  </div>

                </td>

                <td class="px-6 py-5">
                  <%= product.stock_count %>
                </td>

                <td class="px-6 py-5">

                  <span class="bg-indigo-50 border border-indigo-100 text-indigo-700 text-base px-3 py-1 rounded-full font-medium">
                    <%= product.product_type&.name || "Uncategorized" %>
                  </span>

                </td>

                <td class="px-6 py-5">

                  <div class="flex items-center justify-end gap-2">

                    <%= link_to "View",
                        product_path(product),
                        class: "bg-white hover:bg-indigo-50 border border-indigo-100 text-gray-700 px-3 py-2 rounded-xl text-base font-medium transition" %>

                    <%= link_to "Edit",
                        edit_product_path(product),
                        class: "bg-white hover:bg-indigo-50 border border-indigo-100 text-gray-700 px-3 py-2 rounded-xl text-base font-medium transition" %>

                  </div>

                </td>

              </tr>

            <% end %>

          </tbody>

        </table>

      </div>

    </div>

  </div>

</div>

<style>
  @keyframes slideUp {
    from {
      transform: translateY(100%);
      opacity: 0.96;
    }
    to {
      transform: translateY(0);
      opacity: 1;
    }
  }

  .animate-slide-up {
    animation: slideUp 0.24s ease-out;
  }
</style>

<script>
  function lockScroll() {
    document.body.style.overflow = "hidden";
    document.body.style.touchAction = "none";
    document.documentElement.style.overflow = "hidden";
  }

  function unlockScroll() {
    document.body.style.overflow = "";
    document.body.style.touchAction = "";
    document.documentElement.style.overflow = "";
  }

  function openCategoryModal() {
    const modal = document.getElementById("category-modal");

    if (!modal) return;

    modal.classList.remove("hidden");

    lockScroll();
  }

  function closeCategoryModal() {
    const modal = document.getElementById("category-modal");

    if (!modal) return;

    modal.classList.add("hidden");

    unlockScroll();
  }

  function openProductModal() {
    const modal = document.getElementById("product-modal");

    if (!modal) return;

    modal.classList.remove("hidden");

    lockScroll();
  }

  function closeProductModal() {
    const modal = document.getElementById("product-modal");

    if (!modal) return;

    modal.classList.add("hidden");

    unlockScroll();
  }
</script>