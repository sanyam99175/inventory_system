<style>
  .product-page-wrapper {
    width: 100%;
    max-width: 1250px;
    margin: 0 auto;
  }

  .product-mobile-container {
    width: 100%;
    max-width: 1250px;
    margin: 0 auto;
    padding: 0 16px;
  }

  @media (min-width: 1024px) {

    .desktop-layout {
      display: flex;
      flex-direction: column;
      gap: 22px;
    }

    .desktop-sticky {
      position: sticky;
      top: 24px;
    }

  }
</style>

<div style="
  min-height:100vh;
  background:linear-gradient(to bottom right,#f8fafc,#eef2ff,#f5f3ff);
  padding:28px 16px 50px;
">

  <div class="product-page-wrapper">

    <div class="product-mobile-container">

      <% stock_count = @product.stock_count || 0 %>
      <% alert_limit = @product.alert_limit || 0 %>
      <% low_stock = stock_count <= alert_limit %>

      <!-- ================= BACK BUTTON ================= -->
      <div style="margin-bottom:18px;">

        <% back_path = current_user.owner? ? products_path : dashboard_path %>
        <% back_text = current_user.owner? ? t('back_to_products') : t('back_to_dashboard') %>

        <%= link_to back_path,
            style: "
              display:inline-flex;
              align-items:center;
              gap:10px;
              text-decoration:none;
              color:#4338ca;
              font-size:14px;
              font-weight:700;
            " do %>

          <div style="
            width:38px;
            height:38px;
            border-radius:14px;
            background:#eef2ff;
            border:1px solid #c7d2fe;
            display:flex;
            align-items:center;
            justify-content:center;
          ">
            ←
          </div>

          <span><%= back_text %></span>

        <% end %>

      </div>

      <!-- ================= PRODUCT HEADER ================= -->
      <div style="
        background:rgba(255,255,255,0.92);
        backdrop-filter:blur(12px);
        border:1px solid #dbeafe;
        border-radius:30px;
        padding:26px;
        box-shadow:0 10px 30px rgba(15,23,42,0.06);
        margin-bottom:22px;
      ">

        <div style="
          display:flex;
          justify-content:space-between;
          gap:16px;
          align-items:flex-start;
          flex-wrap:wrap;
        ">

          <div style="min-width:0; flex:1;">

            <p style="
              margin:0;
              font-size:12px;
              font-weight:800;
              letter-spacing:0.5px;
              text-transform:uppercase;
              color:#6366f1;
            ">
              Inventory Product
            </p>

            <h1 style="
              margin:8px 0 0;
              font-size:34px;
              line-height:1.15;
              color:#1e1b4b;
              font-weight:900;
              word-break:break-word;
            ">
              <%= @product.name %>
            </h1>

            <p style="
              margin:10px 0 0;
              color:#64748b;
              font-size:15px;
              font-weight:500;
            ">
              Product inventory overview and stock intelligence
            </p>

          </div>

          <div style="
            padding:10px 16px;
            border-radius:999px;
            font-size:12px;
            font-weight:800;
            background:<%= low_stock ? '#fee2e2' : '#eef2ff' %>;
            color:<%= low_stock ? '#dc2626' : '#4338ca' %>;
            border:1px solid <%= low_stock ? '#fecaca' : '#c7d2fe' %>;
            white-space:nowrap;
          ">
            <%= low_stock ? "LOW STOCK" : "IN STOCK" %>
          </div>

        </div>

      </div>

      <!-- ================= DESKTOP GRID ================= -->
      <div class="desktop-layout">

        <!-- ================= LEFT ================= -->
        <div>

          <!-- PRODUCT DETAILS -->
          <div style="
            background:white;
            border-radius:28px;
            border:1px solid #e0e7ff;
            overflow:hidden;
            margin-bottom:22px;
            box-shadow:0 6px 24px rgba(15,23,42,0.05);
          ">

            <!-- HEADER -->
            <div style="
              padding:20px 22px;
              border-bottom:1px solid #eef2ff;
              background:linear-gradient(to right,#eef2ff,#ffffff);
            ">

              <h2 style="
                margin:0;
                font-size:18px;
                font-weight:800;
                color:#1e1b4b;
              ">
                Product Details
              </h2>

            </div>

            <!-- DETAIL ROWS -->
            <div style="padding:8px 0;">

              <!-- STOCK -->
              <div style="
                display:flex;
                justify-content:space-between;
                gap:20px;
                padding:18px 22px;
                border-bottom:1px solid #f1f5f9;
              ">

                <div>
                  <p style="
                    margin:0;
                    color:#64748b;
                    font-size:13px;
                    font-weight:600;
                  ">
                    Current Stock
                  </p>
                </div>

                <div style="
                  font-size:30px;
                  font-weight:900;
                  color:<%= low_stock ? '#dc2626' : '#312e81' %>;
                ">
                  <%= stock_count %>
                </div>

              </div>

              <!-- TYPE -->
              <div style="
                display:flex;
                justify-content:space-between;
                gap:20px;
                padding:18px 22px;
                border-bottom:1px solid #f1f5f9;
              ">

                <p style="
                  margin:0;
                  color:#64748b;
                  font-size:13px;
                  font-weight:600;
                ">
                  Product Type
                </p>

                <p style="
                  margin:0;
                  color:#1e1b4b;
                  font-size:15px;
                  font-weight:800;
                  text-align:right;
                ">
                  <%= @product.product_type.name %>
                </p>

              </div>

              <!-- GODOWN -->
              <div style="
                display:flex;
                justify-content:space-between;
                gap:20px;
                padding:18px 22px;
                border-bottom:1px solid #f1f5f9;
              ">

                <p style="
                  margin:0;
                  color:#64748b;
                  font-size:13px;
                  font-weight:600;
                ">
                  Godown Number
                </p>

                <p style="
                  margin:0;
                  color:#1e1b4b;
                  font-size:15px;
                  font-weight:800;
                ">
                  <%= @product.godown_number %>
                </p>

              </div>

              <!-- ALERT -->
              <div style="
                display:flex;
                justify-content:space-between;
                gap:20px;
                padding:18px 22px;
              ">

                <p style="
                  margin:0;
                  color:#64748b;
                  font-size:13px;
                  font-weight:600;
                ">
                  Alert Limit
                </p>

                <p style="
                  margin:0;
                  color:#4338ca;
                  font-size:15px;
                  font-weight:900;
                ">
                  <%= alert_limit %>
                </p>

              </div>

              <div style="
                display:flex;
                justify-content:space-between;
                gap:20px;
                padding:18px 22px;
              ">

                <p style="
                  margin:0;
                  color:#64748b;
                  font-size:13px;
                  font-weight:600;
                ">
                  Supplier
                </p>

                <p style="
                  margin:0;
                  color:#4338ca;
                  font-size:15px;
                  font-weight:900;
                ">
                  <%= @product.supplier.name %>
                </p>

              </div>

            </div>

          </div>

          <!-- DIRECT STOCK UPDATE -->
          <% if current_user.owner? && current_user.has_permission?("products", "create_update") %>

            <% users = current_organization.users %>

            <div style="
              background:white;
              border-radius:28px;
              border:1px solid #e0e7ff;
              padding:24px;
              box-shadow:0 6px 24px rgba(15,23,42,0.05);
            ">

              <div style="margin-bottom:20px;">

                <h2 style="
                  margin:0;
                  color:#1e1b4b;
                  font-size:20px;
                  font-weight:900;
                ">
                  Direct Stock Update
                </h2>

                <p style="
                  margin:8px 0 0;
                  color:#64748b;
                  font-size:14px;
                  line-height:1.6;
                ">
                  Use values like <b>+5</b> or <b>-3</b> for proper stock tracking.
                </p>

              </div>

              <%= form_with url: update_stock_product_path(@product),
                            method: :patch,
                            local: true do %>

                <!-- USER -->
                <div style="margin-bottom:18px;">

                  <label style="
                    display:block;
                    margin-bottom:8px;
                    color:#4338ca;
                    font-size:14px;
                    font-weight:700;
                  ">
                    Performed By
                  </label>

                  <%= select_tag :performed_by_user_id,
                      options_from_collection_for_select(
                        users,
                        :id,
                        :name,
                        current_user.id
                      ),
                      style: "
                        width:100%;
                        padding:15px;
                        border-radius:18px;
                        border:1px solid #c7d2fe;
                        background:#f8fafc;
                        font-size:15px;
                        outline:none;
                      " %>

                </div>

                <!-- QUANTITY -->
                <div>

                  <label style="
                    display:block;
                    margin-bottom:8px;
                    color:#4338ca;
                    font-size:14px;
                    font-weight:700;
                  ">
                    Quantity Change
                  </label>

                  <%= text_field_tag :quantity_change, nil,
                      placeholder: "+5 or -3",
                      pattern: "^[+-][0-9]+$",
                      style: "
                        width:100%;
                        padding:16px;
                        border-radius:18px;
                        border:1px solid #c7d2fe;
                        background:#f8fafc;
                        font-size:16px;
                        outline:none;
                        box-sizing:border-box;
                      " %>

                </div>

                <!-- BUTTON -->
                <%= submit_tag t('apply_change'),
                    style: "
                      width:100%;
                      margin-top:20px;
                      background:linear-gradient(135deg,#4f46e5,#4338ca);
                      border:none;
                      color:white;
                      padding:16px;
                      border-radius:20px;
                      font-size:15px;
                      font-weight:800;
                      cursor:pointer;
                      box-shadow:0 10px 24px rgba(79,70,229,0.22);
                    " %>

              <% end %>

            </div>

          <% end %>

        </div>

        <!-- ================= RIGHT ================= -->
        <div class="desktop-sticky">

          <!-- AI INSIGHTS -->
          <div style="
            background:linear-gradient(135deg,#eef2ff,#ffffff);
            border-radius:30px;
            border:1px solid #c7d2fe;
            overflow:hidden;
            box-shadow:0 10px 28px rgba(99,102,241,0.08);
          ">

            <!-- HEADER -->
            <div style="
              padding:22px;
              border-bottom:1px solid #dbeafe;
            ">

              <p style="
                margin:0;
                color:#6366f1;
                font-size:12px;
                font-weight:900;
                text-transform:uppercase;
                letter-spacing:0.5px;
              ">
                AI Insights
              </p>

              <h2 style="
                margin:8px 0 0;
                font-size:24px;
                font-weight:900;
                color:#1e1b4b;
              ">
                Inventory Intelligence
              </h2>

            </div>

            <!-- BODY -->
            <div style="padding:22px;">

              <% health_color =
                  if @product.days_remaining.to_i <= 7
                    '#dc2626'
                  elsif @product.days_remaining.to_i <= 15
                    '#d97706'
                  else
                    '#059669'
                  end
              %>

              <!-- DAYS -->
              <div style="
                background:white;
                border:1px solid #dbeafe;
                border-radius:24px;
                padding:20px;
                margin-bottom:16px;
              ">

                <p style="
                  margin:0;
                  font-size:12px;
                  color:#64748b;
                  font-weight:700;
                  text-transform:uppercase;
                ">
                  Days Remaining
                </p>

                <h3 style="
                  margin:10px 0 0;
                  font-size:50px;
                  line-height:1;
                  color:<%= health_color %>;
                  font-weight:900;
                ">
                  <%= @product.days_remaining %>
                </h3>

              </div>

              <!-- DAILY -->
              <div style="
                background:white;
                border:1px solid #dbeafe;
                border-radius:24px;
                padding:20px;
                margin-bottom:16px;
              ">

                <p style="
                  margin:0;
                  font-size:12px;
                  color:#64748b;
                  font-weight:700;
                  text-transform:uppercase;
                ">
                  Daily Usage Rate
                </p>

                <h3 style="
                  margin:10px 0 0;
                  font-size:44px;
                  line-height:1;
                  color:#312e81;
                  font-weight:900;
                ">
                  <%= @product.daily_usage_rate.round(1) %>
                </h3>

              </div>

              <!-- RECOMMENDED -->
              <div style="
                background:#4338ca;
                border-radius:26px;
                padding:24px;
                color:white;
              ">

                <p style="
                  margin:0;
                  font-size:12px;
                  font-weight:800;
                  opacity:0.8;
                  text-transform:uppercase;
                ">
                  Recommended Stock
                </p>

                <h3 style="
                  margin:12px 0 0;
                  font-size:54px;
                  line-height:1;
                  font-weight:900;
                ">
                  <%= @product.recommended_stock %>
                </h3>

                <p style="
                  margin:12px 0 0;
                  font-size:14px;
                  line-height:1.6;
                  opacity:0.9;
                ">
                  Recommended inventory for the next 30 days including safety buffer.
                </p>

              </div>

            </div>

          </div>

        </div>

      </div>

    </div>

  </div>

</div>