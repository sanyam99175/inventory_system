<div style="max-width: 900px; margin: auto;">

  <!-- PRODUCT CARD -->
  <div style="
    background: white;
    padding: 25px;
    border-radius: 12px;
    margin-bottom: 20px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    border: 1px solid #e0e7ff;
  ">

    <h2 style="margin-bottom: 10px; color: #1e3a8a;">
      <%= @product.name %>
    </h2>

    <p style="color: #334155;">
      <strong><%= t('type') %>:</strong>
      <span style="color: #4f46e5;"><%= @product.product_type.name %></span>
    </p>

    <p style="color: #334155;">
      <strong><%= t('godown') %>:</strong>
      <span style="color: #4f46e5;"><%= @product.godown_number %></span>
    </p>

    <% stock_count = @product.stock_count || 0 %>
    <% alert_limit = @product.alert_limit || 0 %>

    <p style="color: #334155;">
      <strong><%= t('stock') %>:</strong>
      <span style="
        font-weight: bold;
        color: <%= stock_count <= alert_limit ? '#dc2626' : '#4f46e5' %>;
      ">
        <%= @product.stock_count %>
      </span>
    </p>

    <!-- SIMPLE PROGRESS BAR -->
    <% max_ref = [alert_limit * 2, 1].max %>
    <% percent = [(stock_count.to_f / max_ref) * 100, 100].min %>

    <div style="margin-top: 10px;">
      <div style="height: 8px; background: #e5e7eb; border-radius: 999px; overflow: hidden;">
        <div style="
          width: <%= percent %>%;
          height: 8px;
          background: <%= stock_count <= alert_limit ? '#dc2626' : '#4f46e5' %>;
        "></div>
      </div>
    </div>

    <p style="color: #334155; margin-top: 10px;">
      <strong><%= t('alert_limit') %>:</strong>
      <span style="color: #4f46e5;"><%= @product.alert_limit %></span>
    </p>

  </div>

  <!-- OWNER ACTION CARD -->
  <% if current_user.owner? && current_user.has_permission?("products", "create_update") %>

    <% users = current_organization.users %>

    <div style="
      background: #eff6ff;
      padding: 20px;
      border-radius: 12px;
      margin-bottom: 20px;
      border: 1px solid #c7d2fe;
      box-shadow: 0 2px 6px rgba(0,0,0,0.05);
    ">

      <h3 style="color: #1e3a8a; margin-bottom: 10px;">
        ⚡ <%= t('direct_stock_update') %>
      </h3>

      <p style="font-size: 12px; color: #64748b; margin-bottom: 10px;">
        ⚠ Use format like <b>+5</b> or <b>-3</b>. This ensures correct stock tracking.
      </p>

      <%= form_with url: update_stock_product_path(@product),
                    method: :patch,
                    local: true do %>

        <!-- PERFORMED BY -->
        <div style="margin-bottom: 12px;">
          <label style="color: #3730a3; font-weight: 500;">Performed by</label><br>

          <%= select_tag :performed_by_user_id,
              options_from_collection_for_select(
                users,
                :id,
                :name,
                current_user.id
              ),
              style: "
                padding: 10px;
                width: 100%;
                border-radius: 8px;
                border: 1px solid #c7d2fe;
                background: white;
              " %>
        </div>

        <!-- QUANTITY (+/- ENFORCED) -->
        <div style="margin-bottom: 12px;">
          <label style="color: #3730a3; font-weight: 500;">
            <%= t('quantity_change') %> (+ / -)
          </label><br>

          <%= text_field_tag :quantity_change, nil,
              placeholder: "+5 or -3",
              pattern: "^[+-][0-9]+$",
              title: "Enter value like +5 or -3",
              style: "
                padding: 10px;
                width: 100%;
                border-radius: 8px;
                border: 1px solid #c7d2fe;
                outline: none;
              " %>
        </div>

        <%= submit_tag t('apply_change'),
            style: "
              background: #4f46e5;
              color: white;
              padding: 10px;
              border-radius: 8px;
              border: none;
              width: 100%;
              cursor: pointer;
              font-weight: 600;
            " %>

      <% end %>

    </div>

  <% end %>

  <!-- WORKER REQUEST CARD -->
  <% existing_request = Request.find_by(
    user: current_user,
    product: @product,
    status: :pending
  ) %>

  <% if current_user.worker? && current_user.has_permission?("products", "view") && !current_user.has_permission?("products", "create_update") %>

    <div style="
      background: #eff6ff;
      padding: 20px;
      border-radius: 12px;
      margin-bottom: 20px;
      border: 1px solid #c7d2fe;
      box-shadow: 0 2px 6px rgba(0,0,0,0.05);
    ">

      <h3 style="color: #1e3a8a; margin-bottom: 10px;">
        📨 <%= t('request_stock_change') %>
      </h3>

      <% if existing_request %>

        <div style="
          background: #eef2ff;
          padding: 12px;
          border-radius: 8px;
          margin-bottom: 10px;
          border: 1px solid #c7d2fe;
        ">

          <p style="margin: 0; color: #1e3a8a;">
            Pending Request:
            <b style="color: #4f46e5;"><%= existing_request.quantity_change %></b>
          </p>

        </div>

        <%= button_to t('cancel_request'),
            cancel_request_path(existing_request),
            method: :patch,
            style: "
              background: #dc2626;
              color: white;
              padding: 10px;
              border-radius: 8px;
              border: none;
              width: 100%;
              cursor: pointer;
              font-weight: 600;
            " %>

      <% else %>

        <%= form_with url: requests_path, local: true do %>

          <%= hidden_field_tag "request[product_id]", @product.id %>

          <div style="margin-bottom: 12px;">
            <label style="color: #3730a3; font-weight: 500;">
              Quantity to remove
            </label><br>

            <%= number_field_tag "request[quantity_change]", nil,
                min: 1,
                placeholder: "Enter quantity",
                style: "
                  padding: 10px;
                  width: 100%;
                  border-radius: 8px;
                  border: 1px solid #c7d2fe;
                " %>
          </div>

          <%= submit_tag t('send_request'),
              style: "
                background: #4f46e5;
                color: white;
                padding: 10px;
                border-radius: 8px;
                border: none;
                width: 100%;
                cursor: pointer;
              " %>

        <% end %>

      <% end %>

    </div>

  <% end %>

  <!-- NAVIGATION -->
  <div style="text-align: center; margin-top: 20px;">
    <% if current_user.owner? %>
      <%= link_to "⬅ #{t('back_to_products')}", products_path,
          style: "color: #4f46e5; text-decoration: none;" %>
    <% else %>
      <%= link_to "⬅ #{t('back_to_dashboard')}", dashboard_path,
          style: "color: #4f46e5; text-decoration: none;" %>
    <% end %>
  </div>

</div>