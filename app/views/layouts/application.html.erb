<!DOCTYPE html>
<html>
  <head>
    <title>Traklyn</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  </head>

  <body class="bg-gradient-to-br from-gray-50 via-indigo-50 to-gray-100 text-gray-800"
        data-controller="notification-modal mobile-menu">

<% if user_signed_in? && current_organization.present? %>

<div class="flex h-screen overflow-hidden">

  <!-- MOBILE OVERLAY -->
  <div data-mobile-menu-target="overlay"
       data-action="click->mobile-menu#close"
       class="hidden fixed inset-0 bg-black/30 z-40 md:hidden"></div>

  <!-- SIDEBAR -->
  <aside data-mobile-menu-target="sidebar"
         class="fixed md:static z-50 inset-y-0 left-0 w-64 bg-white border-r transform -translate-x-full md:translate-x-0 transition duration-200 flex flex-col">

    <!-- LOGO -->
    <div class="px-6 py-5 border-b text-xl font-bold text-indigo-600">
      Traklyn
    </div>

    <!-- SCROLLABLE NAV -->
    <div class="flex-1 overflow-y-auto">

      <nav class="p-4 space-y-2 text-sm">
       

      <%= link_to dashboard_path(current_organization),
          class: "flex items-center px-4 py-2 rounded-lg transition
          #{controller_name == 'dashboard' ? 'bg-indigo-100 text-indigo-700 font-semibold' : 'hover:_g-indigo-50'}" do %>
        📊 Dashboard
      <% end %>

        <% plan = current_organization.plan %>

        <!-- MAIN NAV -->
        <% nav_items = [
          { key: "dashboard", label: "Dashboard", path: dashboard_path(current_organization), icon: "📊" },
          { key: "products", label: "Products", path: products_path, icon: "📦" },
          { key: "requests", label: "Requests", path: requests_path, icon: "📝" },
          { key: "history", label: "History", path: history_path, icon: "📜" },
          { key: "alerts", label: "Alerts", path: alerts_path(current_organization), icon: "⚠️" }
        ] %>

        <% nav_items.each do |item| %>
          <% has_permission = current_user.has_permission?(item[:key], "view") rescue true %>
          <% allowed_by_plan = PlanPermissions.allowed?(plan, item[:key]) rescue true %>
          <% locked = has_permission && !allowed_by_plan %>

          <% if has_permission %>
            <% active = current_page?(item[:path]) || (item[:key] == "dashboard" && request.path == root_path) %>
            <% target_path = locked ? upgrade_path(feature: item[:key]) : item[:path] %>

            <%= link_to target_path,
                class: "flex items-center justify-between px-4 py-2 rounded-lg transition-all
                #{active ? 'bg-indigo-100 text-indigo-700 font-semibold' : 'hover:bg-indigo-50 text-gray-700'}
                #{'opacity-50' if locked}" do %>

              <span><%= item[:icon] %> <%= item[:label] %></span>

              <% if item[:key] == "requests" && @pending_requests_count.to_i > 0 %>
                <span class="text-xs bg-yellow-500 text-white px-2 py-0.5 rounded-full">
                  <%= @pending_requests_count %>
                </span>
              <% end %>

              <% if item[:key] == "alerts" && @low_stock_count.to_i > 0 %>
                <span class="text-xs bg-red-500 text-white px-2 py-0.5 rounded-full">
                  <%= @low_stock_count %>
                </span>
              <% end %>

            <% end %>
          <% end %>
        <% end %>

        <!-- ANALYTICS -->
        <div class="mt-6 text-xs text-gray-400 uppercase px-3">Analytics</div>

        <% analytics_items = [
          { key: "trends", label: "Trends", path: trends_path(current_organization), icon: "📈" },
          { key: "intelligence", label: "Intelligence", path: intelligence_path(current_organization), icon: "🧠" }
        ] %>

        <% analytics_items.each do |item| %>
          <% has_permission = current_user.has_permission?(item[:key], "view") rescue true %>
          <% allowed_by_plan = PlanPermissions.allowed?(plan, item[:key]) rescue true %>
          <% locked = has_permission && !allowed_by_plan %>

          <% if has_permission %>
            <% active = current_page?(item[:path]) %>
            <% target_path = locked ? upgrade_path(feature: item[:key]) : item[:path] %>

            <%= link_to target_path,
                class: "flex items-center px-4 py-2 rounded-lg transition
                #{active ? 'bg-indigo-100 text-indigo-700 font-semibold' : 'hover:bg-indigo-50'}
                #{'opacity-50' if locked}" do %>

              <span><%= item[:icon] %> <%= item[:label] %></span>
              <% if locked %> 🔒 <% end %>

            <% end %>
          <% end %>
        <% end %>

        <!-- ADMIN -->
        <div class="mt-6 text-xs text-gray-400 uppercase px-3">Administration</div>

        <% admin_items = [
          { key: "users", label: t('users'), path: staffs_path, icon: "👥" },
          { key: "recycle_bin", label: t('recycle_bin'), path: recycle_bin_path, icon: "🗑️" },
          { key: "audits", label: t('audits'), path: audits_path, icon: "📋" },
          { key: "manage_subscription", label: t('manage_subscription'), path: create_portal_billing_path, icon: "💳" }
        ] %>

        <% admin_items.each do |item| %>
          <% has_permission = current_user.has_permission?(item[:key], "view") rescue true %>
          <% allowed_by_plan = PlanPermissions.allowed?(plan, item[:key]) rescue true %>
          <% locked = has_permission && !allowed_by_plan %>

          <% if has_permission %>
            <% active = current_page?(item[:path]) %>
            <% target_path = locked ? upgrade_path(feature: item[:key]) : item[:path] %>

            <%= link_to target_path,
                class: "flex items-center px-4 py-2 rounded-lg transition
                #{active ? 'bg-indigo-100 text-indigo-700 font-semibold' : 'hover:bg-indigo-50'}
                #{'opacity-50' if locked}" do %>

              <span><%= item[:icon] %> <%= item[:label] %></span>
              <% if locked %> 🔒 <% end %>

            <% end %>
          <% end %>
        <% end %>

      </nav>
    </div>

    <!-- USER -->
    <div class="p-4 border-t text-sm">
      <div class="mb-2">
        <%= link_to edit_user_registration_path,
            class: "block text-gray-700 hover:text-indigo-600 px-2 py-1 rounded hover:bg-gray-100 transition" do %>
          👤 <%= current_user.name || current_user.email %>
        <% end %>
      </div>

      <button data-action="click->notification-modal#open"
              class="w-full text-left px-3 py-2 rounded hover:bg-gray-100">
        ⚙️ Settings
      </button>

      <%= button_to destroy_user_session_path,
          method: :delete,
          form: { data: { turbo: false } },
          class: "w-full text-left px-3 py-2 text-red-600 hover:bg-red-50 rounded mt-2" do %>
        Logout
      <% end %>
    </div>

  </aside>

  <!-- MAIN -->
  <div class="flex-1 flex flex-col overflow-hidden">

    <!-- TOP BAR -->
    <header class="bg-white/80 backdrop-blur border-b px-4 py-3 flex items-center justify-between">

      <button data-action="click->mobile-menu#open"
              class="md:hidden text-gray-700 text-xl">
        ☰
      </button>

      <div class="text-sm text-gray-500">
        Live syncing • Updated just now
      </div>

      <div class="flex items-center gap-4">

        <!-- LANGUAGE SWITCH -->
        <div class="relative">
          <details>
            <summary class="cursor-pointer text-sm text-gray-600 px-3 py-1 hover:bg-gray-100 rounded">
              🌐 <%= I18n.locale == :hi ? "Hindi" : "English" %>
            </summary>

            <div class="absolute right-0 mt-2 w-28 bg-white border rounded shadow z-50">
              <%= link_to url_for(locale: :en), class: "block px-3 py-1 text-sm hover:bg-gray-100" do %>
                🇬🇧 English
              <% end %>
              <%= link_to url_for(locale: :hi), class: "block px-3 py-1 text-sm hover:bg-gray-100" do %>
                🇮🇳 Hindi
              <% end %>
            </div>
          </details>
        </div>

      </div>

    </header>
  <% end %>
    <!-- CONTENT -->
    <main class="flex-1 overflow-y-auto">

      <!-- FLASH MESSAGES -->
      <div id="flash-container" class="space-y-3">
        <% if notice %>
          <div class="flash-message bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-lg shadow-sm">
            <%= notice %>
          </div>
        <% end %>

        <% if alert %>
          <div class="flash-message bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg shadow-sm">
            <%= alert %>
          </div>
        <% end %>
      </div>
      <%= yield %>
    </main>

  </div>

</div>

<% if current_user && current_organization %>
  <%= render "shared/notification_modal" %>
<% end %>

</body>
</html>

<script>
  document.addEventListener("turbo:load", () => {
    document.querySelectorAll(".flash-message").forEach((el) => {
      setTimeout(() => {
        el.style.transition = "all 0.4s ease"
        el.style.opacity = "0"
        el.style.maxHeight = el.scrollHeight + "px"

        requestAnimationFrame(() => {
          el.style.maxHeight = "0px"
          el.style.margin = "0"
          el.style.padding = "0"
        })

        setTimeout(() => el.remove(), 400)
      }, 2500)
    })
  })
</script>