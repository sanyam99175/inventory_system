<div class="max-w-5xl mx-auto p-6">

  <div class="bg-white rounded-3xl border border-indigo-100 shadow-sm p-6">

    <div class="flex items-center mb-6">

      <div class="flex-1">

        <h1 class="text-3xl font-bold text-indigo-900">
          Purchase Details
        </h1>

        <p class="text-gray-500 mt-1">
          Invoice: <%= @purchase.invoice_number.presence || "N/A" %>
        </p>

      </div>

      <div class="flex items-center gap-3">
        <%= link_to mark_paid_purchase_path(@purchase),
              data: { confirm: "Are you sure you want to mark this purchase as paid?" },
            class: "bg-green-600 hover:bg-green-700 text-white px-5 py-3 font-semibold rounded-2xl" do %>
          Mark Paid
        <% end %>

        <%= link_to edit_purchase_path(@purchase),
            class: "
              bg-indigo-600
              hover:bg-indigo-700
              text-white
              px-5 py-3
              rounded-2xl
              font-semibold
            " do %>

          Edit Purchase

        <% end %>
      </div>
    </div>

    <!-- DETAILS -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">

      <div class="bg-indigo-50 border border-indigo-100 rounded-2xl p-4">
        <p class="text-xs text-gray-500">Supplier</p>
        <h3 class="font-bold text-indigo-900 mt-2">
          <%= @purchase.supplier.name %>
        </h3>
      </div>

      <div class="bg-indigo-50 border border-indigo-100 rounded-2xl p-4">
        <p class="text-xs text-gray-500">Total</p>
        <h3 class="font-bold text-indigo-900 mt-2">
          ₹<%= @purchase.total_amount %>
        </h3>
      </div>

      <div class="bg-indigo-50 border border-indigo-100 rounded-2xl p-4">
        <p class="text-xs text-gray-500">Paid</p>
        <h3 class="font-bold text-emerald-700 mt-2">
          ₹<%= @purchase.paid_amount %>
        </h3>
      </div>

      <div class="bg-indigo-50 border border-indigo-100 rounded-2xl p-4">
        <p class="text-xs text-gray-500">Due</p>
        <h3 class="font-bold text-red-600 mt-2">
          ₹<%= @purchase.due_amount %>
        </h3>
      </div>

    </div>

    <!-- ITEMS -->
    <div class="bg-indigo-50/40 rounded-2xl border border-indigo-100 overflow-hidden">

      <table class="min-w-full">

        <thead class="bg-indigo-100/70">

          <tr>

            <th class="px-5 py-4 text-left text-xs uppercase text-indigo-700">
              Product
            </th>

            <th class="px-5 py-4 text-left text-xs uppercase text-indigo-700">
              Qty
            </th>

          </tr>

        </thead>

        <tbody class="divide-y divide-indigo-100">

          <% @purchase.purchase_items.each do |item| %>

            <tr>

              <td class="px-5 py-4 font-medium text-gray-900">
                <%= item.product.name %>
              </td>

              <td class="px-5 py-4">
                <%= item.quantity %>
              </td>

            </tr>

          <% end %>

        </tbody>

      </table>

    </div>

  </div>

</div>