<div class="purchase-item border border-indigo-100 rounded-2xl p-4 bg-indigo-50/40 relative">

  <!-- REMOVE -->
  <button
    type="button"
    onclick="removePurchaseItem(this)"
    class="
      absolute top-3 right-3
      text-red-500 hover:text-red-700
      text-sm font-bold
    "
  >
    ✕
  </button>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-4">

    <!-- PRODUCT -->
    <div>

      <label class="block text-sm font-medium text-gray-700 mb-2">
        Product
      </label>

      <%= f.collection_select :product_id,
          current_organization.products,
          :id,
          :name,
          { prompt: "Select Product" },
          class: "
            w-full
            border border-indigo-100
            rounded-xl
            px-4 py-3
          " %>

    </div>

    <!-- QUANTITY -->
    <div>

      <label class="block text-sm font-medium text-gray-700 mb-2">
        Quantity
      </label>

      <%= f.number_field :quantity,
          class: "
            w-full
            border border-indigo-100
            rounded-xl
            px-4 py-3
          " %>

    </div>

    <!-- UNIT PRICE -->
    <div>

      <label class="block text-sm font-medium text-gray-700 mb-2">
        Unit Price
      </label>

      <%= f.number_field :unit_price,
          step: 0.01,
          class: "
            w-full
            border border-indigo-100
            rounded-xl
            px-4 py-3
          " %>

    </div>

  </div>

</div>