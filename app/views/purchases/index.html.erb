<div class="min-h-screen bg-gradient-to-br from-indigo-50 via-white to-indigo-100">

  <div class="max-w-7xl mx-auto px-4 md:px-6 py-6">

    <!-- HEADER -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-6">

      <div>

        <h1 class="text-3xl font-black text-gray-900">
          Purchases
        </h1>

        <p class="text-gray-500 mt-1">
          Manage supplier purchases & payments
        </p>

      </div>

      <%= link_to new_purchase_path,
          class: "
            inline-flex items-center gap-2
            bg-indigo-600 hover:bg-indigo-700
            text-white
            px-5 py-3
            rounded-2xl
            font-semibold
            shadow-sm
            transition
          " do %>

        <%= icon('plus', class: 'w-5 h-5') %>

        <span>New Purchase</span>

      <% end %>

    </div>

    <!-- STATS -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-6">

      <div class="bg-white/90 backdrop-blur border border-indigo-100 rounded-3xl p-5 shadow-sm">

        <p class="text-sm text-gray-500">
          Total Purchases
        </p>

        <h2 class="text-3xl font-black text-indigo-700 mt-2">
          <%= @purchases.count %>
        </h2>

      </div>

      <div class="bg-white/90 backdrop-blur border border-indigo-100 rounded-3xl p-5 shadow-sm">

        <p class="text-sm text-gray-500">
          Total Amount
        </p>

        <h2 class="text-3xl font-black text-indigo-700 mt-2">
          ₹<%= @purchases.sum(:total_amount).to_i %>
        </h2>

      </div>

      <div class="bg-white/90 backdrop-blur border border-indigo-100 rounded-3xl p-5 shadow-sm">

        <p class="text-sm text-gray-500">
          Paid
        </p>

        <h2 class="text-3xl font-black text-emerald-600 mt-2">
          ₹<%= @purchases.sum(:paid_amount).to_i %>
        </h2>

      </div>

      <div class="bg-white/90 backdrop-blur border border-indigo-100 rounded-3xl p-5 shadow-sm">

        <p class="text-sm text-gray-500">
          Pending
        </p>

        <h2 class="text-3xl font-black text-red-600 mt-2">
          ₹<%= @purchases.sum("total_amount - paid_amount").to_i %>
        </h2>

      </div>

    </div>

    <!-- TABLE -->
    <div class="bg-white/90 backdrop-blur border border-indigo-100 rounded-3xl shadow-sm overflow-hidden">

      <% if @purchases.any? %>

        <!-- DESKTOP -->
        <div class="hidden lg:block overflow-x-auto">

          <table class="min-w-full">

            <thead class="bg-indigo-50 border-b border-indigo-100">

              <tr>

                <th class="px-6 py-4 text-left text-xs font-bold uppercase tracking-wide text-indigo-700">
                  Supplier
                </th>

                <th class="px-6 py-4 text-left text-xs font-bold uppercase tracking-wide text-indigo-700">
                  Total
                </th>


                <th class="px-6 py-4 text-left text-xs font-bold uppercase tracking-wide text-indigo-700">
                  Status
                </th>

                <th class="px-6 py-4 text-left text-xs font-bold uppercase tracking-wide text-indigo-700">
                  Date
                </th>

                <th class="px-6 py-4 text-left text-xs font-bold uppercase tracking-wide text-indigo-700">
                  Invoice
                </th>

                <th class="px-6 py-4 text-right text-xs font-bold uppercase tracking-wide text-indigo-700">
                  Actions
                </th>

              </tr>

            </thead>

            <tbody class="divide-y divide-indigo-50">

              <% @purchases.each do |purchase| %>

                <% due_amount = purchase.total_amount.to_f - purchase.paid_amount.to_f %>

                <tr class="hover:bg-indigo-50/40 transition">

                  <!-- SUPPLIER -->
                  <td class="px-6 py-5">

                    <div>

                      <p class="font-semibold text-gray-900">
                        <%= purchase.supplier&.name %>
                      </p>

                      <p class="text-xs text-gray-500 mt-1">
                        <%= purchase.user&.name %>
                      </p>

                    </div>

                  </td>

                 <% due_amount = purchase.total_amount.to_f - purchase.paid_amount.to_f %>

                <!-- TOTAL -->
                <td class="px-6 py-5 font-bold text-gray-900">
                  ₹<%= purchase.total_amount.to_i %>
                </td>

                <!-- STATUS -->
                <td class="px-6 py-5">

                  <% paid_full = due_amount <= 0 %>

                  <span class="
                    px-3 py-1 rounded-full text-xs font-bold border
                    <%= paid_full ?
                      'bg-emerald-50 text-emerald-700 border-emerald-100' :
                      'bg-amber-50 text-amber-700 border-amber-100'
                    %>
                  ">

                    <%= paid_full ? "Paid" : "Pending" %>

                  </span>

                </td>

                <!-- DATE -->
                <td class="px-6 py-5 text-sm text-gray-500">

                  <%= purchase.created_at.strftime("%d %b %Y") %>

                </td>

              <% if purchase.invoice.attached? %>
                  <td class="px-6 py-5">

                    <%= link_to "View Invoice",
                        rails_blob_path(purchase.invoice, disposition: "attachment"),
                        class: "text-indigo-600 hover:text-indigo-800 font-medium" %>

                  </td>
              <% else %>
                  <td class="px-6 py-5 text-sm text-gray-500">
                    N/A
                  </td>
              <% end %>

                                    <!-- ACTIONS -->
                  <td colspan="6" class="px-6 py-5 text-right">

                    <%= link_to purchase_path(purchase),
                        class: "bg-indigo-600 text-white px-6 py-2 rounded-lg hover:bg-indigo-700 transition" do %>

                      View

                    <% end %>

                  </td>
            

                </tr>

              <% end %>

            </tbody>

          </table>

        </div>

        <!-- MOBILE -->
        <div class="lg:hidden divide-y divide-indigo-50">

          <% @purchases.each do |purchase| %>

            <% due_amount = purchase.total_amount.to_f - purchase.paid_amount.to_f %>

            <div class="p-4">

              <div class="flex items-start justify-between gap-3">

                <div class="min-w-0">

                  <h3 class="font-bold text-gray-900 truncate">
                    <p class="font-medium text-gray-700">
                      <%= purchase.purchase_items.map { |item|
                            "#{item.product&.name} (#{item.quantity})"
                          }.join(", ") %>
                    </p>
                  </h3>

                  <p class="text-sm text-gray-500 mt-1">
                    <%= purchase.supplier&.name %>
                  </p>

                </div>

                <span class="
                  px-3 py-1 rounded-full text-xs font-bold border whitespace-nowrap
                  <%= due_amount <= 0 ?
                    'bg-emerald-50 text-emerald-700 border-emerald-100' :
                    'bg-amber-50 text-amber-700 border-amber-100'
                  %>
                ">

                  <%= due_amount <= 0 ? "Paid" : "Pending" %>

                </span>

              </div>

              <div class="grid grid-cols-3 gap-3 mt-4">

                <div class="bg-indigo-50 rounded-2xl p-3 border border-indigo-100">

                  <p class="text-[11px] text-gray-500">
                    Total
                  </p>

                  <p class="font-bold text-indigo-700 mt-1">
                    ₹<%= purchase.total_amount.to_i %>
                  </p>

                </div>

                <div class="bg-emerald-50 rounded-2xl p-3 border border-emerald-100">

                  <p class="text-[11px] text-gray-500">
                    Paid
                  </p>

                  <p class="font-bold text-emerald-700 mt-1">
                    ₹<%= purchase.paid_amount.to_i %>
                  </p>

                </div>

                <div class="bg-red-50 rounded-2xl p-3 border border-red-100">

                  <p class="text-[11px] text-gray-500">
                    Due
                  </p>

                  <p class="font-bold text-red-600 mt-1">
                    ₹<%= due_amount.to_i %>
                  </p>

                </div>

              </div>

            </div>

          <% end %>

        </div>

      <% else %>

        <!-- EMPTY -->
        <div class="py-20 px-6 text-center">

          <div class="w-20 h-20 rounded-full bg-indigo-50 border border-indigo-100 flex items-center justify-center mx-auto mb-5">

            <%= icon('shopping-cart', class: 'w-8 h-8 text-indigo-700') %>

          </div>

          <h3 class="text-xl font-bold text-gray-900">
            No Purchases Yet
          </h3>

          <p class="text-gray-500 mt-2">
            Create your first supplier purchase entry.
          </p>

          <%= link_to new_purchase_path,
              class: "
                inline-flex items-center gap-2
                mt-6
                bg-indigo-600 hover:bg-indigo-700
                text-white
                px-5 py-3
                rounded-2xl
                font-semibold
                transition
              " do %>

            <%= icon('plus', class: 'w-5 h-5') %>

            <span>Create Purchase</span>

          <% end %>

        </div>

      <% end %>

    </div>

  </div>

</div>