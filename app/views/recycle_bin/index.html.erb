<div class="min-h-screen bg-gradient-to-br from-indigo-50 via-white to-indigo-100">

  <div class="max-w-7xl mx-auto px-4 sm:px-5 lg:px-6 py-5 md:py-7">

<!-- ================= HEADER ================= -->
<div class="mb-6 md:mb-8">

  <div class="bg-white/85 backdrop-blur-xl border border-indigo-50 rounded-[30px] shadow-[0_8px_30px_rgba(99,102,241,0.06)] overflow-hidden">

    <div class="relative px-5 md:px-8 py-6 md:py-8">

      <!-- SOFT GLOW -->
      <div class="absolute top-0 right-0 w-56 h-56 bg-indigo-50 rounded-full blur-3xl opacity-70 -translate-y-1/2 translate-x-1/3"></div>

      <!-- LIGHT FADE -->
      <div class="absolute inset-0 bg-gradient-to-br from-indigo-50/40 via-white to-white"></div>

      <div class="relative flex flex-col lg:flex-row lg:items-center lg:justify-between gap-5">

        <!-- LEFT -->
        <div class="flex items-start gap-4">

          <div class="
            w-14 h-14 md:w-16 md:h-16
            rounded-3xl
            bg-gradient-to-br
            from-indigo-100
            to-indigo-200
            border border-indigo-100
            flex items-center justify-center
            shadow-sm
            shrink-0
          ">

            <%= icon('trash', class: 'w-7 h-7 text-indigo-600') %>

          </div>

          <div>

            <h1 class="text-2xl md:text-4xl font-bold tracking-tight text-gray-900">
              Recycle Bin
            </h1>

            <p class="text-sm md:text-base text-gray-500 mt-2 max-w-xl leading-relaxed">
              Restore deleted products and users before they are permanently removed.
            </p>

          </div>

        </div>

        <!-- STATS -->
        <div class="grid grid-cols-2 gap-3 w-full lg:w-auto">

          <!-- PRODUCTS -->
          <div class="
            bg-indigo-50/60
            border border-indigo-100
            rounded-2xl
            px-5 py-4
            min-w-[140px]
            backdrop-blur-sm
          ">

            <p class="text-[11px] font-semibold uppercase tracking-[0.12em] text-indigo-500">
              Deleted Products
            </p>

            <p class="text-2xl font-bold text-indigo-700 mt-1">
              <%= @deleted_products.count %>
            </p>

          </div>

          <!-- USERS -->
          <div class="
            bg-white/80
            border border-indigo-100
            rounded-2xl
            px-5 py-4
            min-w-[140px]
            backdrop-blur-sm
          ">

            <p class="text-[11px] font-semibold uppercase tracking-[0.12em] text-gray-500">
              Deleted Users
            </p>

            <p class="text-2xl font-bold text-gray-800 mt-1">
              <%= @deleted_users.count %>
            </p>

          </div>

        </div>

      </div>

    </div>

  </div>

</div>

    <!-- ================= PRODUCTS ================= -->
    <div class="bg-white/85 backdrop-blur-xl rounded-[30px] border border-indigo-100 shadow-sm overflow-hidden mb-7">

      <!-- TOP -->
      <div class="px-5 md:px-7 py-5 border-b border-indigo-100 bg-gradient-to-r from-indigo-50/70 to-white">

        <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">

          <!-- LEFT -->
          <div class="flex items-center gap-4">

            <div class="w-12 h-12 rounded-2xl bg-white border border-indigo-100 flex items-center justify-center shadow-sm">

              <%= icon('box', class: 'w-5 h-5 text-indigo-700') %>

            </div>

            <div>

              <h2 class="text-lg font-semibold text-gray-900">
                Deleted Products
              </h2>

              <p class="text-sm text-gray-500 mt-1">
                <span class="font-semibold text-indigo-700">
                  <%= @deleted_products.count %>
                </span>
                deleted products available for restore
              </p>

            </div>

          </div>

          <!-- SEARCH -->
          <%= form_with url: recycle_bin_path,
              method: :get,
              local: true,
              class: "w-full lg:w-auto" do %>

            <div class="relative">

              <div class="absolute inset-y-0 left-4 flex items-center text-indigo-300">
                <%= icon('search', class: 'w-4 h-4') %>
              </div>

              <input
                type="text"
                name="product_search"
                value="<%= params[:product_search] %>"
                placeholder="Search deleted products..."
                class="
                  w-full
                  lg:w-80
                  bg-white
                  border border-indigo-100
                  rounded-2xl
                  pl-11
                  pr-4
                  py-3
                  text-sm
                  focus:ring-4
                  focus:ring-indigo-100
                  focus:border-indigo-400
                  outline-none
                  transition
                "
              />

            </div>

          <% end %>

        </div>

      </div>

      <% if @deleted_products.any? %>

        <!-- DESKTOP -->
        <div class="hidden md:block overflow-x-auto">

          <table class="min-w-full">

            <thead class="bg-indigo-50/50 border-b border-indigo-100">

              <tr>

                <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wide text-indigo-700">
                  Product
                </th>

                <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wide text-indigo-700">
                  Category
                </th>

                <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wide text-indigo-700">
                  Stock
                </th>

                <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wide text-indigo-700">
                  Deleted
                </th>

                <th class="px-6 py-4 text-right text-xs font-semibold uppercase tracking-wide text-indigo-700">
                  Action
                </th>

              </tr>

            </thead>

            <tbody class="divide-y divide-indigo-50">

              <% @deleted_products.each do |product| %>

                <tr class="hover:bg-indigo-50/40 transition">

                  <td class="px-6 py-5">

                    <div class="flex items-center gap-4">

                      <div class="w-12 h-12 rounded-2xl bg-indigo-50 border border-indigo-100 flex items-center justify-center">

                        <%= icon('box', class: 'w-5 h-5 text-indigo-700') %>

                      </div>

                      <div>

                        <h3 class="font-semibold text-gray-900">
                          <%= product.name %>
                        </h3>

                        <p class="text-sm text-gray-500 mt-1">
                          Godown: <%= product.godown_number.presence || "N/A" %>
                        </p>

                      </div>

                    </div>

                  </td>

                  <td class="px-6 py-5">

                    <span class="bg-indigo-50 border border-indigo-100 text-indigo-700 text-sm px-3 py-1 rounded-full">
                      <%= product.product_type&.name || "Uncategorized" %>
                    </span>

                  </td>

                  <td class="px-6 py-5">

                    <span class="
                      inline-flex
                      items-center
                      px-3 py-1
                      rounded-full
                      text-sm
                      font-semibold
                      border
                      <%= product.stock_count.to_i > 0 ? 'bg-green-50 text-green-700 border-green-100' : 'bg-red-50 text-red-700 border-red-100' %>
                    ">
                      <%= product.stock_count %> in stock
                    </span>

                  </td>

                  <td class="px-6 py-5 text-sm text-gray-500">
                    <%= time_ago_in_words(product.deleted_at) %> ago
                  </td>

                  <td class="px-6 py-5 text-right">

                    <% if current_user.has_permission?("recycle_bin", "restore") %>

                      <%= button_to restore_product_path(product),
                          method: :patch,
                          class: "
                            bg-indigo-600
                            hover:bg-indigo-700
                            text-white
                            px-5
                            py-2.5
                            rounded-2xl
                            text-sm
                            font-semibold
                            transition
                            shadow-sm
                          " do %>

                        Restore

                      <% end %>

                    <% end %>

                  </td>

                </tr>

              <% end %>

            </tbody>

          </table>

        </div>

<!-- MOBILE -->
<div class="md:hidden divide-y divide-indigo-100">

  <% @deleted_products.each do |product| %>

    <button
      type="button"
      onclick='openRecycleProductModal(<%= raw(product.to_json(include: :product_type)) %>)'
      class="
        w-full
        bg-white
        px-4
        py-4
        flex
        items-center
        justify-between
        active:bg-indigo-50
        transition
      "
    >

      <div class="flex items-center gap-3 min-w-0">

        <div class="w-11 h-11 rounded-2xl bg-indigo-50 border border-indigo-100 flex items-center justify-center shrink-0">

          <%= icon('box', class: 'w-5 h-5 text-indigo-600') %>

        </div>

        <div class="min-w-0 text-left">

          <h3 class="font-semibold text-gray-900 truncate">
            <%= product.name %>
          </h3>

          <p class="text-xs text-gray-500 mt-1">
            Deleted <%= time_ago_in_words(product.deleted_at) %> ago
          </p>

        </div>

      </div>

      <%= icon('chevron-right', class: 'w-5 h-5 text-gray-400 shrink-0') %>

    </button>

  <% end %>

</div>

      <% else %>

        <!-- EMPTY -->
        <div class="py-20 px-6 text-center">

          <div class="w-20 h-20 rounded-full bg-indigo-50 border border-indigo-100 flex items-center justify-center mx-auto mb-5">

            <%= icon('box', class: 'w-8 h-8 text-indigo-600') %>

          </div>

          <h3 class="text-lg font-semibold text-gray-900">
            No deleted products
          </h3>

          <p class="text-sm text-gray-500 mt-2">
            Everything looks clean 🎉
          </p>

        </div>

      <% end %>

    </div>

    <!-- ================= USERS ================= -->
    <div class="bg-white/85 backdrop-blur-xl rounded-[30px] border border-indigo-100 shadow-sm overflow-hidden">

      <div class="px-5 md:px-7 py-5 border-b border-indigo-100 bg-gradient-to-r from-indigo-50/70 to-white">

        <div class="flex items-center gap-4">

          <div class="w-12 h-12 rounded-2xl bg-white border border-indigo-100 flex items-center justify-center shadow-sm">

            <%= icon('users', class: 'w-5 h-5 text-indigo-700') %>

          </div>

          <div>

            <h2 class="text-lg font-semibold text-gray-900">
              Deleted Users
            </h2>

            <p class="text-sm text-gray-500 mt-1">
              <span class="font-semibold text-indigo-700">
                <%= @deleted_users.count %>
              </span>
              deleted users available for restore
            </p>

          </div>

        </div>

      </div>

      <% if @deleted_users.any? %>

        <!-- DESKTOP -->
        <div class="hidden md:block overflow-x-auto">

          <table class="min-w-full">

            <thead class="bg-indigo-50/50 border-b border-indigo-100">

              <tr>

                <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wide text-indigo-700">
                  User
                </th>

                <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wide text-indigo-700">
                  Role
                </th>

                <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wide text-indigo-700">
                  Deleted
                </th>

                <th class="px-6 py-4 text-right text-xs font-semibold uppercase tracking-wide text-indigo-700">
                  Action
                </th>

              </tr>

            </thead>

            <tbody class="divide-y divide-indigo-50">

              <% @deleted_users.each do |user| %>

                <tr class="hover:bg-indigo-50/40 transition">

                  <td class="px-6 py-5">

                    <div class="flex items-center gap-4">

                      <div class="w-12 h-12 rounded-2xl bg-indigo-50 border border-indigo-100 flex items-center justify-center">

                        <%= icon('user', class: 'w-5 h-5 text-indigo-700') %>

                      </div>

                      <div>

                        <h3 class="font-semibold text-gray-900">
                          <%= user.email %>
                        </h3>

                        <p class="text-sm text-gray-500 mt-1">
                          Deleted account
                        </p>

                      </div>

                    </div>

                  </td>

                  <td class="px-6 py-5">

                    <span class="
                      px-3 py-1
                      rounded-full
                      text-sm
                      font-medium
                      border
                      <%= user.owner? ? 'bg-yellow-50 text-yellow-700 border-yellow-200' : 'bg-indigo-50 text-indigo-700 border-indigo-100' %>
                    ">
                      <%= user.role.titleize %>
                    </span>

                  </td>

                  <td class="px-6 py-5 text-sm text-gray-500">
                    <%= time_ago_in_words(user.deleted_at) %> ago
                  </td>

                  <td class="px-6 py-5 text-right">

                    <% if current_user.has_permission?("recycle_bin", "restore") %>

                      <%= button_to restore_staff_path(user),
                          method: :patch,
                          class: "
                            bg-indigo-600
                            hover:bg-indigo-700
                            text-white
                            px-5
                            py-2.5
                            rounded-2xl
                            text-sm
                            font-semibold
                            transition
                            shadow-sm
                          " do %>

                        Restore

                      <% end %>

                    <% end %>

                  </td>

                </tr>

              <% end %>

            </tbody>

          </table>

        </div>

<!-- MOBILE -->
<div class="md:hidden divide-y divide-indigo-100">

  <% @deleted_users.each do |user| %>

    <button
      type="button"
      onclick='openRecycleUserModal(<%= raw(user.to_json) %>)'
      class="
        w-full
        bg-white
        px-4
        py-4
        flex
        items-center
        justify-between
        active:bg-indigo-50
        transition
      "
    >

      <div class="flex items-center gap-3 min-w-0">

        <div class="w-11 h-11 rounded-2xl bg-indigo-50 border border-indigo-100 flex items-center justify-center shrink-0">

          <%= icon('user-round', class: 'w-5 h-5 text-indigo-600') %>

        </div>

        <div class="min-w-0 text-left">

          <h3 class="font-semibold text-gray-900 break-all">
            <%= user.email %>
          </h3>

          <p class="text-xs text-gray-500 mt-1">
            Deleted <%= time_ago_in_words(user.deleted_at) %> ago
          </p>

        </div>

      </div>

      <%= icon('chevron-right', class: 'w-5 h-5 text-gray-400 shrink-0') %>

    </button>

  <% end %>

</div>

      <% else %>

        <div class="py-20 px-6 text-center">

          <div class="w-20 h-20 rounded-full bg-indigo-50 border border-indigo-100 flex items-center justify-center mx-auto mb-5">

            <%= icon('users', class: 'w-8 h-8 text-indigo-600') %>

          </div>

          <h3 class="text-lg font-semibold text-gray-900">
            No deleted users
          </h3>

          <p class="text-sm text-gray-500 mt-2">
            Nothing to restore 🎉
          </p>

        </div>

      <% end %>

    </div>

  </div>

</div>

<!-- PRODUCT MODAL -->
<div
  id="recycleProductModal"
  class="fixed inset-0 z-[99999] hidden md:hidden"
>

  <!-- BACKDROP -->
  <div
    onclick="closeRecycleProductModal()"
    class="absolute inset-0 bg-black/40 backdrop-blur-sm"
  ></div>

  <!-- SHEET -->
  <div class="
    absolute
    bottom-0
    inset-x-0
    bg-white
    rounded-t-[32px]
    shadow-2xl
    p-6
    animate-slide-up
  ">

    <div class="w-14 h-1.5 rounded-full bg-gray-200 mx-auto mb-6"></div>

    <div id="recycleProductContent"></div>

  </div>

</div>

