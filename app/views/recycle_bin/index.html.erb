<div class="min-h-screen bg-gradient-to-br from-indigo-50 via-white to-indigo-100">

  <div class="max-w-7xl mx-auto px-4 md:px-6 py-6">

    <!-- ================= PAGE HEADER ================= -->
    <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-5 mb-6">

      <div class="flex items-center gap-4">

        <div class="w-14 h-14 rounded-3xl bg-indigo-600 flex items-center justify-center shadow-sm">
          <%= icon('trash-2', class: 'w-7 h-7 text-white') %>
        </div>

        <div>

          <h1 class="text-2xl md:text-3xl font-bold tracking-tight text-gray-900">
            Recycle Bin
          </h1>

          <p class="text-sm text-gray-500 mt-1">
            Restore deleted products and users
          </p>

        </div>

      </div>

    </div>

    <!-- ================= PRODUCTS ================= -->
    <div class="bg-white/90 backdrop-blur rounded-3xl border border-indigo-100 shadow-sm overflow-hidden mb-8">

      <div class="px-5 md:px-6 py-5 border-b border-indigo-100">

        <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">

          <div class="flex items-center gap-3">

            <div class="w-11 h-11 rounded-2xl bg-indigo-50 border border-indigo-100 flex items-center justify-center">
              <%= icon('package', class: 'w-5 h-5 text-indigo-700') %>
            </div>

            <div>

              <h2 class="font-semibold text-gray-900">
                Deleted Products
              </h2>

              <p class="text-sm text-gray-500 mt-1">
                <span class="text-indigo-700 font-semibold"><%= @deleted_products.size %></span>
                of
                <span class="text-gray-700"><%= @total_products %></span>
                products
              </p>

            </div>

          </div>

          <%= form_with url: recycle_bin_path, method: :get, local: true,
              class: "w-full lg:w-auto" do %>

            <div class="relative">

              <div class="absolute inset-y-0 left-4 flex items-center text-gray-400">
                <%= icon('search', class: 'w-4 h-4') %>
              </div>

              <input
                type="text"
                name="product_search"
                value="<%= params[:product_search] %>"
                placeholder="Search deleted products..."
                class="w-full lg:w-80 bg-white border border-indigo-100 rounded-2xl pl-11 pr-4 py-3 text-sm focus:ring-4 focus:ring-indigo-100 focus:border-indigo-400 outline-none transition"
              />

            </div>

          <% end %>

        </div>

      </div>

      <% if @deleted_products.any? %>

        <!-- TABLE -->
        <div class="hidden md:block overflow-x-auto">

          <table class="min-w-full">

            <thead class="bg-indigo-50/70 border-b border-indigo-100">
              <tr>
                <th class="px-6 py-4 text-left text-xs font-semibold uppercase text-indigo-700">Product</th>
                <th class="px-6 py-4 text-left text-xs font-semibold uppercase text-indigo-700">Category</th>
                <th class="px-6 py-4 text-left text-xs font-semibold uppercase text-indigo-700">Stock</th>
                <th class="px-6 py-4 text-left text-xs font-semibold uppercase text-indigo-700">Godown</th>
                <th class="px-6 py-4 text-left text-xs font-semibold uppercase text-indigo-700">Deleted</th>
                <th class="px-6 py-4 text-right text-xs font-semibold uppercase text-indigo-700">Actions</th>
              </tr>
            </thead>

            <tbody class="divide-y divide-indigo-50">

              <% @deleted_products.each do |product| %>

                <tr class="hover:bg-indigo-50/40 transition">

                  <td class="px-6 py-5">
                    <div class="flex items-center gap-4">

                      <div class="w-11 h-11 rounded-2xl bg-indigo-50 border border-indigo-100 flex items-center justify-center">
                        <%= icon('box', class: 'w-5 h-5 text-indigo-700') %>
                      </div>

                      <div>
                        <h3 class="font-semibold text-gray-900"><%= product.name %></h3>
                        <p class="text-sm text-gray-500">Deleted inventory item</p>
                      </div>

                    </div>
                  </td>

                  <td class="px-6 py-5">
                    <span class="bg-indigo-50 border border-indigo-100 text-indigo-700 text-sm px-3 py-1 rounded-full">
                      <%= product.product_type&.name || "Uncategorized" %>
                    </span>
                  </td>

                  <td class="px-6 py-5">
                    <span class="font-semibold <%= product.stock_count.to_i > 0 ? 'text-gray-900' : 'text-red-600' %>">
                      <%= product.stock_count %>
                    </span>
                  </td>

                  <td class="px-6 py-5 text-gray-600">
                    <%= product.godown_number.presence || "N/A" %>
                  </td>

                  <td class="px-6 py-5 text-gray-600">
                    <%= time_ago_in_words(product.deleted_at) %> ago
                  </td>

                  <td class="px-6 py-5 text-right">

                    <% if current_user.has_permission?("recycle_bin", "restore") %>

                      <%= button_to restore_product_path(product),
                          method: :patch,
                          class: "bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded-xl text-sm font-medium transition shadow-sm" do %>
                        Restore
                      <% end %>

                    <% end %>

                  </td>

                </tr>

              <% end %>

            </tbody>

          </table>

        </div>

        <!-- MOBILE -->
        <div class="md:hidden p-4 space-y-4">

          <% @deleted_products.each do |product| %>

            <div class="bg-white border border-indigo-100 rounded-3xl p-4 shadow-sm">

              <div class="flex items-start justify-between gap-3">

                <div class="flex items-start gap-3">

                  <div class="w-11 h-11 rounded-2xl bg-indigo-50 border border-indigo-100 flex items-center justify-center">
                    <%= icon('box', class: 'w-5 h-5 text-indigo-700') %>
                  </div>

                  <div>
                    <h3 class="font-semibold text-gray-900"><%= product.name %></h3>
                    <p class="text-xs text-gray-500">
                      Deleted <%= time_ago_in_words(product.deleted_at) %> ago
                    </p>
                  </div>

                </div>

                <div class="px-3 py-1 rounded-full text-xs font-semibold
                  <%= product.stock_count.to_i > 0 ? 'bg-green-50 text-green-700 border border-green-100' : 'bg-red-50 text-red-700 border border-red-100' %>">
                  <%= product.stock_count %>
                </div>

              </div>

              <div class="grid grid-cols-2 gap-3 mt-4">

                <div class="bg-indigo-50/60 rounded-2xl p-3">
                  <p class="text-xs text-gray-500">Category</p>
                  <p class="text-sm font-medium text-gray-800"><%= product.product_type&.name || "Uncategorized" %></p>
                </div>

                <div class="bg-indigo-50/60 rounded-2xl p-3">
                  <p class="text-xs text-gray-500">Godown</p>
                  <p class="text-sm font-medium text-gray-800"><%= product.godown_number.presence || "N/A" %></p>
                </div>

              </div>

              <% if current_user.has_permission?("recycle_bin", "restore") %>

                <div class="mt-4 pt-4 border-t border-indigo-100">

                  <%= button_to restore_product_path(product),
                      method: :patch,
                      class: "w-full bg-green-600 hover:bg-green-700 text-white py-3 rounded-2xl text-sm font-semibold transition shadow-sm" do %>
                    Restore Product
                  <% end %>

                </div>

              <% end %>

            </div>

          <% end %>

        </div>

      <% else %>

        <div class="py-20 text-center">

          <div class="w-20 h-20 rounded-full bg-green-50 border border-green-100 flex items-center justify-center mx-auto mb-5">
            <%= icon('package-x', class: 'w-8 h-8 text-green-600') %>
          </div>

          <h3 class="text-lg font-semibold text-gray-900">No deleted products</h3>
          <p class="text-sm text-gray-500 mt-2">Everything looks clean 🎉</p>

        </div>

      <% end %>

    </div>

    <!-- ================= USERS ================= -->
    <div class="bg-white/90 backdrop-blur rounded-3xl border border-indigo-100 shadow-sm overflow-hidden">

      <div class="px-5 md:px-6 py-5 border-b border-indigo-100">

        <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">

          <div class="flex items-center gap-3">

            <div class="w-11 h-11 rounded-2xl bg-indigo-50 border border-indigo-100 flex items-center justify-center">
              <%= icon('users', class: 'w-5 h-5 text-indigo-700') %>
            </div>

            <div>
              <h2 class="font-semibold text-gray-900">Deleted Users</h2>
              <p class="text-sm text-gray-500 mt-1">
                <span class="text-indigo-700 font-semibold"><%= @deleted_users.size %></span>
                of
                <span class="text-gray-700"><%= @total_users %></span>
                users
              </p>
            </div>

          </div>

        </div>

      </div>

      <% if @deleted_users.any? %>

        <div class="hidden md:block overflow-x-auto">

          <table class="min-w-full">

            <thead class="bg-indigo-50/70 border-b border-indigo-100">
              <tr>
                <th class="px-6 py-4 text-left text-xs font-semibold uppercase text-indigo-700">User</th>
                <th class="px-6 py-4 text-left text-xs font-semibold uppercase text-indigo-700">Role</th>
                <th class="px-6 py-4 text-left text-xs font-semibold uppercase text-indigo-700">Deleted</th>
                <th class="px-6 py-4 text-right text-xs font-semibold uppercase text-indigo-700">Actions</th>
              </tr>
            </thead>

            <tbody class="divide-y divide-indigo-50">

              <% @deleted_users.each do |user| %>

                <tr class="hover:bg-indigo-50/40 transition">

                  <td class="px-6 py-5">
                    <div class="flex items-center gap-3">
                      <div class="w-11 h-11 rounded-2xl bg-indigo-50 border border-indigo-100 flex items-center justify-center">
                        <%= icon('user-round', class: 'w-5 h-5 text-indigo-700') %>
                      </div>
                      <div>
                        <h3 class="font-semibold text-gray-900"><%= user.email %></h3>
                        <p class="text-sm text-gray-500">Deleted account</p>
                      </div>
                    </div>
                  </td>

                  <td class="px-6 py-5">
                    <span class="px-3 py-1 rounded-full text-sm font-medium border
                      <%= user.owner? ? 'bg-yellow-50 text-yellow-700 border-yellow-200' : 'bg-indigo-50 text-indigo-700 border-indigo-100' %>">
                      <%= user.role.titleize %>
                    </span>
                  </td>

                  <td class="px-6 py-5 text-gray-600">
                    <%= time_ago_in_words(user.deleted_at) %> ago
                  </td>

                  <td class="px-6 py-5 text-right">

                    <% if current_user.has_permission?("recycle_bin", "restore") %>

                      <%= button_to restore_staff_path(user),
                          method: :patch,
                          class: "bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded-xl text-sm font-medium transition shadow-sm" do %>
                        Restore
                      <% end %>

                    <% end %>

                  </td>

                </tr>

              <% end %>

            </tbody>

          </table>

        </div>

      <% else %>

        <div class="py-20 text-center">

          <div class="w-20 h-20 rounded-full bg-green-50 border border-green-100 flex items-center justify-center mx-auto mb-5">
            <%= icon('users', class: 'w-8 h-8 text-green-600') %>
          </div>

          <h3 class="text-lg font-semibold text-gray-900">No deleted users</h3>
          <p class="text-sm text-gray-500 mt-2">Nothing to restore 🎉</p>

        </div>

      <% end %>

    </div>

  </div>

</div>