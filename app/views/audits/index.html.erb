<div class="max-w-6xl mx-auto px-4 py-8">
  <h1 class="text-3xl font-bold text-gray-900 mb-8"><%= t('audit_logs') %></h1>

  <!-- Date Range Filter -->
  <div class="bg-white shadow rounded-lg mb-6">
    <div class="px-6 py-4">
      <%= form_with url: audits_path, method: :get, local: true, class: "flex flex-wrap gap-4 items-end" do |f| %>
        <%= hidden_field_tag :locale, I18n.locale %>
        <div class="flex-1 min-w-[180px]">
          <%= f.label :start_date, t('from'), class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.date_field :start_date, value: @start_date, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
        </div>
        <div class="flex-1 min-w-[180px]">
          <%= f.label :end_date, t('to'), class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.date_field :end_date, value: @end_date, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
        </div>
        <div class="flex gap-2">
          <%= f.submit t('filter'), class: "px-4 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700" %>
          <%= link_to t('reset'), audits_path, class: "px-4 py-2 bg-gray-300 text-gray-800 rounded-lg hover:bg-gray-400" %>
        </div>
      <% end %>
    </div>
  </div>

  <div class="bg-white shadow rounded-lg">
    <div class="px-6 py-4 border-b border-gray-200">
      <p class="text-sm text-gray-600"><%= t('showing_transactions', count: @audit_logs.count) %></p>
    </div>

    <div class="p-6">
      <% if @audit_logs.any? %>
        <div class="space-y-4">
          <% @audit_logs.each do |log| %>
            <div class="flex items-start space-x-4 pb-4 border-b border-gray-100 last:border-b-0">
              <!-- Icon -->
              <div class="flex-shrink-0">
                <div class="flex items-center justify-center h-10 w-10 rounded-full <%= 
                  case log.action
                  when 'delete' then 'bg-red-100'
                  when 'restore' then 'bg-blue-100'
                  when 'permission_update' then 'bg-purple-100'
                  when 'approve_request' then 'bg-green-100'
                  when 'reject_request' then 'bg-yellow-100'
                  when 'cancel_request' then 'bg-gray-100'
                  else 'bg-blue-100'
                  end
                %>">
                  <span class="<%= 
                    case log.action
                    when 'delete' then 'text-red-600'
                    when 'restore' then 'text-blue-600'
                    when 'permission_update' then 'text-purple-600'
                    when 'approve_request' then 'text-green-600'
                    when 'reject_request' then 'text-yellow-600'
                    when 'cancel_request' then 'text-gray-600'
                    else 'text-blue-600'
                    end
                  %>">
                    <%= 
                      case log.action
                      when 'delete' then '🗑️'
                      when 'restore' then '♻️'
                      when 'permission_update' then '🔐'
                      when 'approve_request' then '✅'
                      when 'reject_request' then '❌'
                      when 'cancel_request' then '⏹️'
                      else '📝'
                      end
                    %>
                  </span>
                </div>
              </div>

              <!-- Content -->
              <div class="flex-1 min-w-0">
                <p class="text-sm font-medium text-gray-900">
                  <%= log.description %>
                </p>
                <p class="mt-1 text-sm text-gray-500">
                  <%= t('by') %> <strong><%= log.actor_name %></strong> • 
                  <%= log.created_at.strftime("%B %d, %Y at %I:%M %p") %>
                </p>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="text-gray-500 text-center py-12"><%= t('no_audit_logs_found') %></p>
      <% end %>
    </div>
  </div>
</div>
<div class="mt-6 flex justify-center items-center gap-2">

  <% if @current_page > 1 %>
    <%= link_to "← Prev",
        audits_path(page: @current_page - 1, start_date: params[:start_date], end_date: params[:end_date]),
        class: "px-3 py-1 border rounded" %>
  <% end %>

  <% (1..@total_pages).each do |page| %>
    <%= link_to page,
        audits_path(page: page, start_date: params[:start_date], end_date: params[:end_date]),
        class: "px-3 py-1 border rounded #{'bg-blue-500 text-white' if page == @current_page}" %>
  <% end %>

  <% if @current_page < @total_pages %>
    <%= link_to "Next →",
        audits_path(page: @current_page + 1, start_date: params[:start_date], end_date: params[:end_date]),
        class: "px-3 py-1 border rounded" %>
  <% end %>

</div>