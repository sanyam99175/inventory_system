<div class="max-w-4xl mx-auto p-4 md:p-6">

  <h2 class="text-2xl font-bold mb-6 text-gray-800">
    <%= t('audit_logs_page') %>
  </h2>

  <!-- DATE FILTER -->
  <div class="mb-6">

    <%= form_with url: audits_path,
        method: :get,
        local: true,
        class: "grid grid-cols-1 sm:grid-cols-3 gap-3" do %>

      <%= date_field_tag :start_date,
          @start_date,
          class: "
            border border-gray-300
            p-3 rounded-xl text-sm
            focus:ring-2 focus:ring-indigo-200
            focus:border-indigo-500
            outline-none
          " %>

      <%= date_field_tag :end_date,
          @end_date,
          class: "
            border border-gray-300
            p-3 rounded-xl text-sm
            focus:ring-2 focus:ring-indigo-200
            focus:border-indigo-500
            outline-none
          " %>

      <%= submit_tag t('filter_button'),
          class: "
            bg-indigo-600 hover:bg-indigo-700
            text-white px-4 py-3
            rounded-xl text-sm font-medium
            transition
          " %>

    <% end %>

  </div>

  <!-- EMPTY STATE -->
  <% if @audit_logs.empty? %>

    <div class="flex flex-col items-center justify-center py-20 text-center">

      <div class="text-5xl mb-4">
        📭
      </div>

      <h3 class="text-lg font-semibold text-gray-800 mb-2">
        <%= t('no_activity_found') %>
      </h3>

      <p class="text-sm text-gray-500 mb-4 max-w-md">

        <% if params[:start_date].present? || params[:end_date].present? %>

          <%= t('no_audit_logs_found_date_range') %>

        <% else %>

          <%= t('no_activity_yet') %>

        <% end %>

      </p>

      <%= link_to t('reset_filters'),
          audits_path,
          class: "
            bg-indigo-600 hover:bg-indigo-700
            text-white px-4 py-2
            rounded-xl text-sm
            transition
          " %>

    </div>

  <% else %>

    <!-- GROUPED LOGS -->
    <% grouped_logs = @audit_logs.group_by { |log| log.created_at.to_date } %>

    <div class="relative border-l border-gray-300">

      <% grouped_logs.each do |date, logs| %>

        <!-- DATE -->
        <div class="mb-4 mt-6">

          <div class="flex items-center gap-3 mb-3">

            <div class="h-px bg-gray-200 flex-1"></div>

            <span class="text-xs text-gray-500 bg-gray-100 px-3 py-1 rounded-full">
              <%= date.strftime("%d %b %Y") %>
            </span>

            <div class="h-px bg-gray-200 flex-1"></div>

          </div>

          <!-- LOGS -->
          <% logs.each do |log| %>

            <!-- MOBILE = CLICKABLE -->
            <%= link_to audit_path(log),
                class: "block mb-3 ml-5 relative" do %>

              <!-- DOT -->
              <span class="absolute -left-[10px] top-4 w-2.5 h-2.5 rounded-full <%= timeline_color(log) %>"></span>

              <!-- CARD -->
              <div class="
                bg-white
                p-3
                rounded-xl
                shadow-sm
                border
                hover:shadow-md
                active:scale-[0.99]
                transition
              ">

                <!-- HEADER -->
                <div class="flex justify-between items-start gap-2">

                  <div class="min-w-0">

                    <p class="text-sm font-semibold text-gray-800 break-words leading-snug">
                      <%= timeline_title(log) %>
                    </p>

                    <p class="text-[11px] text-gray-400 mt-1">
                      <%= time_ago_in_words(log.created_at) %> ago
                    </p>

                  </div>

                  <!-- MOBILE CHEVRON -->
                  <div class="text-gray-300 text-base shrink-0 md:hidden">
                    ›
                  </div>

                </div>

                <!-- SUBTEXT -->
                <p class="text-[11px] text-gray-500 mt-1.5 leading-relaxed line-clamp-2">
                  <%= timeline_subtext(log) %>
                </p>

                <!-- DESKTOP VIEW -->
                <div class="mt-2 hidden md:block">

                  <span class="text-indigo-600 text-[11px] font-medium hover:underline">
                    View
                  </span>

                </div>

              </div>

            <% end %>

          <% end %>

        </div>

      <% end %>

    </div>

    <!-- PAGINATION -->
    <div class="flex justify-between mt-6 text-sm">

      <% if @current_page > 1 %>

        <%= link_to "← Previous",
            audits_path(
              page: @current_page - 1,
              start_date: @start_date,
              end_date: @end_date
            ),
            class: "text-indigo-600 font-medium" %>

      <% end %>

      <% if @current_page < @total_pages %>

        <%= link_to "Next →",
            audits_path(
              page: @current_page + 1,
              start_date: @start_date,
              end_date: @end_date
            ),
            class: "text-indigo-600 font-medium ml-auto" %>

      <% end %>

    </div>

  <% end %>

</div>