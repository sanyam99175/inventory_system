<div class="max-w-4xl mx-auto p-6">

  <h2 class="text-2xl font-bold mb-6 text-gray-800">Audit Logs</h2>

  <!-- DATE FILTER -->
  <div class="flex gap-2 mb-6">
    <%= form_with url: audits_path, method: :get, local: true, class: "flex gap-2" do %>
      <%= date_field_tag :start_date, @start_date, class: "border p-2 rounded text-sm" %>
      <%= date_field_tag :end_date, @end_date, class: "border p-2 rounded text-sm" %>
      <%= submit_tag "Filter", class: "bg-indigo-600 text-white px-4 py-2 rounded text-sm" %>
    <% end %>
  </div>

  <!-- EMPTY STATE -->
  <% if @audit_logs.empty? %>

    <div class="flex flex-col items-center justify-center py-20 text-center">
      <div class="text-5xl mb-4">📭</div>

      <h3 class="text-lg font-semibold text-gray-800 mb-2">
        No activity found
      </h3>

      <p class="text-sm text-gray-500 mb-4 max-w-md">
        <% if params[:start_date].present? || params[:end_date].present? %>
          No audit logs found for the selected date range.
        <% else %>
          No activity yet. Start by creating or updating a product.
        <% end %>
      </p>

      <%= link_to "Reset Filters",
          audits_path,
          class: "bg-indigo-600 text-white px-4 py-2 rounded hover:bg-indigo-700 text-sm" %>

    </div>

  <% else %>

    <!-- GROUP BY DATE (UI ONLY, NO LOGIC CHANGE) -->
    <% grouped_logs = @audit_logs.group_by { |log| log.created_at.to_date } %>

    <div class="relative border-l border-gray-300">

      <% grouped_logs.each do |date, logs| %>

        <!-- DATE HEADER -->
        <div class="mb-4 mt-6">
          <div class="flex items-center gap-3 mb-3">
            <div class="h-px bg-gray-200 flex-1"></div>
            <span class="text-xs text-gray-500 bg-gray-100 px-3 py-1 rounded-full">
              <%= date.strftime("%d %b %Y") %>
            </span>
            <div class="h-px bg-gray-200 flex-1"></div>
          </div>

          <!-- LOGS -->
          <% logs.each do |log| %>

            <div class="mb-4 ml-6 relative">

              <!-- DOT -->
              <span class="absolute -left-3 top-2 w-3 h-3 rounded-full <%= timeline_color(log) %>"></span>

              <!-- COMPACT CARD -->
              <div class="bg-white p-3 rounded-lg shadow-sm border hover:shadow-md transition">

                <!-- HEADER -->
                <div class="flex justify-between items-center">

                  <p class="text-sm font-medium text-gray-800 truncate">
                    <%= timeline_title(log) %>
                  </p>

                  <span class="text-[11px] text-gray-400 whitespace-nowrap ml-2">
                    <%= time_ago_in_words(log.created_at) %> ago
                  </span>

                </div>

                <!-- SUBTEXT -->
                <p class="text-xs text-gray-500 mt-1 line-clamp-2">
                  <%= timeline_subtext(log) %>
                </p>

                <!-- ACTION -->
                <div class="mt-2">
                  <%= link_to "View",
                      audit_path(log),
                      class: "text-indigo-600 text-xs hover:underline" %>
                </div>

              </div>

            </div>

          <% end %>

        </div>

      <% end %>

    </div>

    <!-- PAGINATION (UNCHANGED) -->
    <div class="flex justify-between mt-6 text-sm">

      <% if @current_page > 1 %>
        <%= link_to "← Previous",
            audits_path(page: @current_page - 1, start_date: @start_date, end_date: @end_date),
            class: "text-indigo-600" %>
      <% end %>

      <% if @current_page < @total_pages %>
        <%= link_to "Next →",
            audits_path(page: @current_page + 1, start_date: @start_date, end_date: @end_date),
            class: "text-indigo-600 ml-auto" %>
      <% end %>

    </div>

  <% end %>

</div>