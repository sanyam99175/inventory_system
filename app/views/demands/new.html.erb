<div class="max-w-5xl mx-auto p-6">

  <h1 class="text-2xl font-bold text-indigo-800 mb-6">
    Create Demand
  </h1>

    <% if @demand.errors.any? %>
      <div class="mb-4 bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg">
        <% @demand.errors.full_messages.each do |msg| %>
          <p><%= msg %></p>
        <% end %>
      </div>
    <% end %>

  <%= form_with model: @demand, local: true,  data: { turbo: false } do |f| %>

    <!-- HEADER FIELDS -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">

      <div>
        <label class="text-sm font-medium">Supplier</label>
        <%= f.collection_select :supplier_id, current_organization.suppliers, :id, :name,
            { prompt: "Select Supplier" },
            class: "w-full border rounded-xl p-2 mt-1" %>
      </div>

      <div>
        <label class="text-sm font-medium">Date</label>
        <%= f.date_field :demand_date,
            class: "w-full border rounded-xl p-2 mt-1" %>
      </div>

      <div>
        <label class="text-sm font-medium">Notes</label>
        <%= f.text_field :notes,
            class: "w-full border rounded-xl p-2 mt-1" %>
      </div>

    </div>

<div class="bg-gray-50 p-4 rounded-2xl border">

  <div class="flex justify-between items-center mb-4">
    <h2 class="font-semibold">Products</h2>

    <button type="button"
      onclick="addRow()"
      class="text-sm bg-indigo-600 text-white px-3 py-1 rounded-lg">
      + Add Item
    </button>
  </div>

  <div id="items">

    <%= f.fields_for :demand_items do |item| %>

      <div class="grid grid-cols-12 gap-2 mb-2 item-row">

        <div class="col-span-7">
          <%= item.collection_select :product_id, current_organization.products, :id, :name,
              { prompt: "Select Product" },
              class: "w-full border rounded-lg p-2" %>
        </div>

        <div class="col-span-3">
          <%= item.number_field :quantity,
              class: "w-full border rounded-lg p-2",
              placeholder: "Qty" %>
        </div>

        <div class="col-span-2 flex items-center">
          <button type="button"
            onclick="removeRow(this)"
            class="text-red-600 text-sm">
            Remove
          </button>
        </div>

      </div>

    <% end %>

  </div>

</div>

<div id="product-options" class="hidden">
  <% current_organization.products.each do |p| %>
    <option value="<%= p.id %>"><%= p.name %></option>
  <% end %>
</div>

    <!-- SUBMIT -->
    <div class="mt-6">
      <%= f.submit "Create Demand",
          class: "bg-indigo-600 text-white px-6 py-2 rounded-xl" %>
    </div>

  <% end %>

</div>

<script>
function addRow() {
  const container = document.getElementById("items");

  const timestamp = new Date().getTime();

  const html = `
    <div class="grid grid-cols-12 gap-2 mb-2 item-row">

      <div class="col-span-7">
        <select name="demand[demand_items_attributes][${timestamp}][product_id]"
          class="w-full border rounded-lg p-2">
          <option value="">Select Product</option>
          ${document.getElementById("product-options").innerHTML}
        </select>
      </div>

      <div class="col-span-3">
        <input type="number"
          name="demand[demand_items_attributes][${timestamp}][quantity]"
          placeholder="Qty"
          class="w-full border rounded-lg p-2">
      </div>

      <div class="col-span-2 flex items-center">
        <button type="button" onclick="removeRow(this)" class="text-red-600 text-sm">
          Remove
        </button>
      </div>

    </div>
  `;

  container.insertAdjacentHTML("beforeend", html);
}

function removeRow(btn) {
  btn.closest(".item-row").remove();
}
</script>