<div class="p-6">

  <div class="flex items-center justify-between mb-6">

  <h1 class="text-2xl font-bold text-gray-900">
    Demands
  </h1>

  <%= link_to new_demand_path,
      class: "
        bg-indigo-600 hover:bg-indigo-700
        text-white
        px-4 py-2
        rounded-xl
        text-sm font-semibold
        flex items-center gap-2
        shadow-sm
      " do %>

    <%= icon('plus', class: 'w-4 h-4') %>
    New Demand

  <% end %>

</div>
  <div class="bg-white rounded-2xl shadow-sm border overflow-hidden">

    <table class="w-full text-sm">

      <thead class="bg-gray-50 text-left">
        <tr>
          <th class="p-4">ID</th>
          <th>Status</th>
          <th>Date</th>
          <th>Actions</th>
        </tr>
      </thead>

      <tbody>

        <% @demands.each do |d| %>

          <tr class="border-t">

            <td class="p-4">#<%= d.id %></td>

            <td>
              <% if d.generated? %>
                <span class="px-2 py-1 bg-yellow-100 text-yellow-700 rounded-full text-xs">
                  Generated
                </span>
              <% else %>
                <span class="px-2 py-1 bg-green-100 text-green-700 rounded-full text-xs">
                  Executed
                </span>
              <% end %>
            </td>

            <td><%= d.created_at.strftime("%d %b %Y") %></td>

            <td class="flex gap-2 p-4">

              <%= link_to "View", demand_path(d), class: "text-indigo-600" %>

            </td>

          </tr>

        <% end %>

      </tbody>

    </table>

  </div>

</div>